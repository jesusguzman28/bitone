# Cabeceras servidas por Cloudflare Workers (assets estáticos).
# Reemplazan a lo que hacía public/.htaccess, que era config de Apache y en
# Cloudflare no se aplicaba: el sitio llevaba tiempo sin ninguna de estas.
#
# HTTPS forzado y www -> non-www NO van aquí: son reglas de hostname y se
# configuran en el panel de Cloudflare, no en un archivo de rutas.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  # Sin includeSubDomains ni preload a propósito: ambos son compromisos de un
  # año que romperían cualquier subdominio que hoy sirva HTTP. Se pueden sumar
  # después de verificar qué subdominios existen.
  Strict-Transport-Security: max-age=31536000
  # El CSP está derivado del HTML construido, no copiado de una plantilla:
  #   'unsafe-inline' en script y style es obligatorio hoy — el build emite 97
  #     scripts en línea (Astro inlina los módulos chicos y los define:vars) y
  #     el diseño usa atributos style= en todo el sitio.
  #   Ya no aparecen fonts.googleapis.com ni fonts.gstatic.com: las tipografías
  #     se auto-alojan en /fonts/ desde que se quitó la hoja externa. El CSP
  #     quedó cerrado a este dominio para estilos y letras.
  #   data: es el pixel transparente que corta la descarga del carrusel en móvil.
  #     Ya NO aparece images.unsplash.com: las portadas del blog se sirven desde
  #     /blog/ y el sitio dejó de depender de un host ajeno para su imagen
  #     principal. Si alguien vuelve a pegar una URL de Unsplash en el contenido,
  #     el navegador la bloqueará — y eso es lo que se busca.
  #   form-action 'self' es seguro: el formulario hace preventDefault y abre
  #     wa.me con window.open, así que nunca llega a enviarse.
  #   connect-src 'self': el formulario puede mandar una copia por correo a un
  #     endpoint externo (ver `formulario` en src/data/site.ts). Ese endpoint
  #     está vacío por ahora, así que no se hace ninguna petición. AL ACTIVARLO
  #     hay que sumar su dominio aquí, p. ej.:
  #       connect-src 'self' https://api.web3forms.com
  #     Si no se suma, el navegador bloquea el envío y el respaldo no funciona,
  #     sin ningún aviso visible para el visitante.
  #
  # Google Analytics — al poner el identificador en `analitica.ga4`
  # (src/data/site.ts) hay que sumar estos dos hosts a la línea de abajo, o el
  # navegador bloquea el script y no se mide nada:
  #     script-src  ... https://www.googletagmanager.com
  #     connect-src ... https://www.google-analytics.com https://*.google-analytics.com
  # Se dejan escritos aquí y no puestos ya: mientras no haya analítica, abrir el
  # CSP a googletagmanager.com es ampliar la superficie a cambio de nada.
  # Lo que esto sí frena: cargar scripts, estilos, fuentes o imágenes desde
  # cualquier host que no esté en la lista. Lo que no frena, por 'unsafe-inline':
  # un script inyectado en línea. En un sitio estático sin entrada de usuario
  # renderizada, ese riesgo es marginal.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; upgrade-insecure-requests

# Bundles de Astro: el nombre del archivo lleva el hash del contenido, así que
# un cambio genera un nombre nuevo. Aquí immutable es seguro.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Medios de public/. El nombre NO lleva hash: si se reemplaza una imagen, el
# navegador la sigue sirviendo hasta que expire. Por eso una semana y no un
# año, con revalidación en segundo plano.
# /blog/* y /proyectos/* no se pueden listar enteros: esas rutas sirven también
# las páginas HTML, y la regla les daría a los artículos el mismo caché de una
# semana —un cambio de texto tardaría siete días en verse. Por eso el patrón
# baja hasta la extensión: alcanza a las fotos y deja fuera el HTML, que no
# termina en .webp.
/blog/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/proyectos/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/rubros/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/servicios/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/hero/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
# Las tipografías sí llevan un año e immutable: un .woff2 no cambia nunca. Si
# algún día se cambia de familia o de peso, cambia el nombre del archivo.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/mockup/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/marcas/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/og-default.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
