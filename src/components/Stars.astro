---
// Constelaciones animadas para las secciones oscuras: puntos que derivan y se
// unen con líneas cuando se acercan. Se dibuja en canvas porque con degradados
// CSS el movimiento resultaba imperceptible.
---

<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
  <canvas class="stars-canvas absolute inset-0 h-full w-full"></canvas>
  <div class="absolute -left-16 -top-10 h-80 w-80 rounded-full opacity-40 blur-3xl" style="background:radial-gradient(circle,#D91023,transparent 70%)"></div>
  <div class="absolute -right-20 top-20 h-96 w-96 rounded-full opacity-25 blur-3xl" style="background:radial-gradient(circle,#E8A317,transparent 70%)"></div>
</div>

<script>
  const canvases = document.querySelectorAll<HTMLCanvasElement>('.stars-canvas');
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  canvases.forEach((canvas) => {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    interface P { x: number; y: number; vx: number; vy: number; r: number }
    let puntos: P[] = [];
    let ancho = 0;
    let alto = 0;
    const DIST = 130; // distancia máxima para unir dos puntos con una línea

    const medir = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const caja = canvas.getBoundingClientRect();
      ancho = caja.width;
      alto = caja.height;
      canvas.width = Math.round(ancho * dpr);
      canvas.height = Math.round(alto * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // densidad proporcional al área, con techo para no castigar equipos lentos
      const cantidad = Math.min(70, Math.round((ancho * alto) / 16000));
      puntos = Array.from({ length: cantidad }, () => ({
        x: Math.random() * ancho,
        y: Math.random() * alto,
        vx: (Math.random() - 0.5) * 0.22,
        vy: (Math.random() - 0.5) * 0.22,
        r: Math.random() * 1.3 + 0.7,
      }));
    };

    const pintar = () => {
      ctx.clearRect(0, 0, ancho, alto);

      // líneas entre puntos cercanos: cuanto más cerca, más opacas
      for (let i = 0; i < puntos.length; i++) {
        for (let j = i + 1; j < puntos.length; j++) {
          const dx = puntos[i].x - puntos[j].x;
          const dy = puntos[i].y - puntos[j].y;
          const d = Math.hypot(dx, dy);
          if (d > DIST) continue;
          ctx.strokeStyle = `rgba(255,255,255,${(1 - d / DIST) * 0.16})`;
          ctx.lineWidth = 0.7;
          ctx.beginPath();
          ctx.moveTo(puntos[i].x, puntos[i].y);
          ctx.lineTo(puntos[j].x, puntos[j].y);
          ctx.stroke();
        }
      }

      for (const p of puntos) {
        ctx.fillStyle = `rgba(255,255,255,${0.35 + p.r * 0.22})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const mover = () => {
      for (const p of puntos) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < -20) p.x = ancho + 20;
        if (p.x > ancho + 20) p.x = -20;
        if (p.y < -20) p.y = alto + 20;
        if (p.y > alto + 20) p.y = -20;
      }
    };

    let raf = 0;
    const bucle = () => {
      mover();
      pintar();
      raf = requestAnimationFrame(bucle);
    };

    medir();
    pintar();
    if (!quieto) bucle();

    let t: number;
    addEventListener('resize', () => {
      clearTimeout(t);
      t = window.setTimeout(() => { medir(); pintar(); }, 150);
    });

    // No gastar batería mientras la sección no está a la vista
    if ('IntersectionObserver' in window && !quieto) {
      new IntersectionObserver((es) => {
        for (const e of es) {
          if (e.isIntersecting && !raf) bucle();
          else if (!e.isIntersecting && raf) { cancelAnimationFrame(raf); raf = 0; }
        }
      }, { threshold: 0 }).observe(canvas);
    }
  });
</script>

<style>
  .stars-canvas {
    /* se desvanece hacia los bordes para que no corte de golpe */
    -webkit-mask-image: radial-gradient(ellipse 78% 82% at 50% 35%, #000 40%, transparent);
    mask-image: radial-gradient(ellipse 78% 82% at 50% 35%, #000 40%, transparent);
    opacity: 0.85;
  }
</style>
