---
import { hero, heroPrecios, waLink } from '../data/site';

// Copia invisible del titular con la frase más larga. Sirve de molde: es la que
// decide la altura del bloque, así que el titular reserva siempre exactamente
// los renglones que necesita, en cualquier ancho de pantalla.
//
// Antes esa reserva era un número fijo en el CSS, medido a mano. Funcionaba en
// móvil y en escritorio, pero en anchos intermedios el titular entraba en menos
// renglones de los reservados y quedaba un hueco muerto entre el título y las
// pastillas. Y cada vez que se tocaban las frases había que volver a medir.
// Calculado aquí, se ajusta solo.
const fraseMasLarga = [...hero.typed].sort((a, b) => b.length - a.length)[0];
---

<section
  class="hero relative isolate flex min-h-[100svh] flex-col justify-center overflow-hidden px-6 pb-10 pt-[84px] text-white sm:pb-[72px] sm:pt-[110px]"
  style="background:radial-gradient(120% 78% at 50% 8%,#1c2331 0%,#141b28 46%,#0e1521 100%)"
>
  <!-- Fondo móvil: la propia imagen del slide, difuminada, para que el color
       del fondo acompañe a lo que se está mostrando en la vitrina. -->
  <div class="absolute inset-0 -z-10 overflow-hidden sm:hidden">
    {hero.slides.map((s, i) => (
      <img
        src={s.msrc}
        alt=""
        aria-hidden="true"
        data-slide={i}
        loading="lazy"
        class:list={['hero-slide hero-slide--blur absolute inset-0 h-full w-full object-cover', i === 0 && 'is-active']}
      />
    ))}
    <div class="absolute inset-0" style="background:linear-gradient(180deg,rgba(10,15,26,0.78) 0%,rgba(10,15,26,0.88) 45%,rgba(10,15,26,0.95) 100%)"></div>
    <div class="absolute -left-24 top-8 h-72 w-72 rounded-full opacity-50 blur-[70px]" style="background:radial-gradient(circle,#D91023,transparent 70%)"></div>
    <div class="absolute -right-24 bottom-16 h-72 w-72 rounded-full opacity-35 blur-[70px]" style="background:radial-gradient(circle,#E8A317,transparent 70%)"></div>
  </div>

  <!-- Carrusel de fondo a sangre: solo desktop.
       El encuadre se ancla abajo, y de lado se va corriendo según el ancho de
       la ventana: ver la regla `.hero-bg__foto` en el bloque de estilos. -->
  <div id="hero-bg" class="hero-bg absolute inset-x-0 -inset-y-[8%] -z-10 hidden will-change-transform sm:block">
    {hero.slides.map((s, i) => (
      <picture>
        {/* En móvil este bloque está oculto, pero display:none NO evita la
            descarga. El source con un pixel transparente la corta de raíz. */}
        <source media="(max-width: 640px)" srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" />
        {/* En escritorio este carrusel es la única imagen real del producto
            (la vitrina de abajo está oculta), así que aquí va el alt descriptivo */}
        <img
          src={s.src}
          alt={s.alt}
          data-slide={i}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          class:list={['hero-slide hero-bg__foto absolute inset-0 h-full w-full object-cover', i === 0 && 'is-active']}
        />
      </picture>
    ))}
    <div class="absolute inset-0" style="background:linear-gradient(105deg,rgba(5,8,20,0.94) 0%,rgba(5,8,20,0.8) 34%,rgba(5,8,20,0.42) 62%,rgba(5,8,20,0.22) 100%)"></div>
    <div class="absolute -left-16 top-10 h-[380px] w-[380px] rounded-full opacity-40 blur-[64px]" style="background:radial-gradient(circle,#D91023,transparent 70%)"></div>
  </div>

  <div class="mx-auto w-full max-w-[1120px]">
    <!-- Vitrina de dispositivo: solo móvil, encima de la tarjeta -->
    <div class="relative mb-4 sm:hidden">
      <div
        class="pointer-events-none absolute -inset-6 -z-10 opacity-60 blur-3xl"
        style="background:radial-gradient(60% 55% at 50% 30%,rgba(217,16,35,0.35),transparent 72%)"
      ></div>
      <div class="hero-showcase relative overflow-hidden rounded-[20px]" style="box-shadow:0 30px 62px -28px rgba(0,0,0,0.8)">
        {hero.slides.map((s, i) => (
          <picture>
            {/* Espejo del caso anterior: en escritorio esta vitrina no se ve */}
            <source media="(min-width: 641px)" srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" />
            <img
              src={s.msrc}
              alt={s.alt}
              data-slide={i}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              class:list={['hero-slide absolute inset-0 h-full w-full object-cover', i === 0 && 'is-active']}
            />
          </picture>
        ))}
        <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(180deg,rgba(5,8,20,0.28) 0%,transparent 24%,transparent 62%,rgba(5,8,20,0.62) 100%)"></div>

        <!-- Chip de categoría en vivo -->
        <div
          class="absolute left-3 top-3 flex items-center gap-2 rounded-full py-1.5 pl-2.5 pr-3.5 text-xs font-semibold text-white"
          style="background:rgba(8,12,24,0.55);backdrop-filter:blur(10px);box-shadow:inset 0 0 0 1px rgba(255,255,255,0.16)"
        >
          <span class="hero-live-dot"></span>
          <span id="mchip">{hero.slides[0].label}</span>
        </div>

        <div class="absolute bottom-1 left-1/2 flex -translate-x-1/2 gap-1">
          {hero.slides.map((s, i) => (
            <button data-dot={i} aria-label={s.label} class:list={['hero-mdot', i === 0 && 'is-active']}></button>
          ))}
        </div>
      </div>
    </div>

    <div class="max-w-[520px]">
      {/* Todo el contenido de la tarjeta va centrado, incluido el sello de
          "Hecho en Perú" y el titular. La tarjeta en sí no se mueve: en
          escritorio sigue pegada a la izquierda para dejar ver la foto del
          producto a la derecha. Lo que se centra es lo de dentro. */}
      <div
        class="rounded-[28px] p-4 text-center sm:p-[clamp(24px,4vw,32px)]"
        style="background:rgba(11,16,27,0.52);box-shadow:inset 0 1px 1px rgba(255,255,255,0.1),inset 0 0 0 1px rgba(255,255,255,0.14),0 40px 90px -30px rgba(0,0,0,0.9);backdrop-filter:blur(20px) saturate(125%);-webkit-backdrop-filter:blur(20px) saturate(125%)"
      >
        <span class="eyebrow eyebrow--dark hero-eyebrow">
          <svg width="20" height="13" viewBox="0 0 3 2" aria-hidden="true" style="border-radius:2px;box-shadow:0 0 0 1px rgba(255,255,255,0.15)">
            <rect width="1" height="2" x="0" fill="#D91023"/><rect width="1" height="2" x="1" fill="#fff"/><rect width="1" height="2" x="2" fill="#D91023"/>
          </svg>
          {hero.eyebrow}
        </span>

        {/* El titular: un arranque fijo —la keyword, lo que leen Google y los
            buscadores con IA— y un final que se escribe y se borra entre las
            tres frases de `hero.typed`.

            Sin <br> entre las dos partes. Lo había, y forzaba el corte justo
            después de "online": como el arranque ya ocupaba dos renglones por su
            cuenta, "online" quedaba solo en el segundo y la frase parecía
            terminar ahí. Ahora el texto fluye como una oración normal y el corte
            cae donde toque.

            La frase que rota va escrita en el HTML, no vacía esperando a que
            arranque el JavaScript. Así el rastreador lee el titular entero, y en
            una conexión lenta no aparece medio título y un hueco. El guion la
            borra y sigue con las demás. */}
        {/* El mínimo del clamp es lo que manda en móvil: a 375px, 7vw son 26px
            y no llegan al piso, así que el titular se queda en 1.75rem. Subirlo
            de 1.5 a 1.75rem es lo que lo hace más grande en el celular sin tocar
            el escritorio, que sigue topando en 2.5rem. */}
        <div class="hero-titular mt-3 font-display text-[clamp(1.75rem,7vw,2.5rem)] font-bold sm:mt-4">
          {/* El molde: invisible, fuera del H1 y fuera del árbol de
              accesibilidad. Ocupa la misma celda de la rejilla que el titular
              real, así que la fila mide lo que mida el más alto de los dos y el
              bloque nunca cambia de altura mientras el texto se escribe. */}
          <span class="hero-titular__molde" aria-hidden="true">{hero.h1} {fraseMasLarga}</span>
          <h1 class="hero-titular__real">
            {hero.h1}{' '}
            <span class="gradient-text--warm"><span id="typed">{hero.typed[0]}</span><span id="cursor" class="typed-cursor" aria-hidden="true"></span></span>
          </h1>
        </div>

        <div class="hero-pills mt-3 flex flex-wrap justify-center gap-2 sm:mt-4">
          {hero.pills.map((p) => (
            <span class="inline-flex items-center gap-1.5 rounded-full py-1.5 pl-2.5 pr-3 text-xs font-medium text-slate-100" style="background:rgba(255,255,255,0.06);box-shadow:inset 0 0 0 1px rgba(255,255,255,0.12)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={p.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
              {p.label}
            </span>
          ))}
        </div>

        {/* Un solo botón. Antes había dos y "Ver proyectos" se llevaba parte de
             los clics hacia una página que no pide reunión ni deja un contacto:
             el visitante miraba trabajos y se iba. Quien quiera verlos los tiene
             igual en el menú de arriba y en el pie. Aquí queda la única acción
             que abre una conversación. */}
        <div class="mt-3.5 flex justify-center sm:mt-[22px]">
          <a href={waLink('Hola Bitwise 👋 quiero agendar una reunión para mi negocio')} target="_blank" rel="noopener" class="btn btn--whatsapp btn--hero group">
            Agendar reunión
            <span class="btn__icon" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
            </span>
          </a>
        </div>

        <!-- Tira de precios. Va debajo de los botones y no encima porque el
             precio no es el gancho: primero se ofrece hablar, y quien sigue
             bajando la vista se encuentra la cifra sin tener que buscarla.
             Separada por una línea fina para que se lea como un dato aparte y
             no como una pastilla más de las de arriba. -->
        <dl class="hero-precios mt-4 grid grid-cols-2 gap-2 border-t pt-3.5 sm:mt-5 sm:gap-3 sm:pt-4" style="border-color:rgba(255,255,255,0.12)">
          {heroPrecios.map((p) => (
            <div
              class="rounded-2xl px-3 py-2.5 text-center sm:px-3.5 sm:py-3"
              style={`background:${p.tinte};box-shadow:inset 0 0 0 1px ${p.borde}`}
            >
              <dt class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-300 sm:text-[11px]">{p.k}</dt>
              <dd class="mt-1.5 flex items-baseline justify-center gap-1.5">
                <span class="text-[11px] font-medium text-slate-400">Desde</span>
                {/* El degradado va en línea y no como clase porque el color
                    sale del dato: cada tarjeta trae el suyo. tabular-nums
                    alinea las dos cifras — sin esto el 1 de 1,500 ocupa menos
                    que el 3 de 3,000 y las columnas bailan. */}
                <span
                  class="font-display text-[1.3rem] font-bold leading-none [font-variant-numeric:tabular-nums] sm:text-[1.5rem]"
                  style={`background-image:linear-gradient(120deg,${p.de},${p.a});-webkit-background-clip:text;background-clip:text;color:transparent`}
                >{p.v}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>

    </div>
  </div>

  <!-- Indicadores de slide: solo desktop. Con el nombre del servicio en vez de
       puntos, para que se lea qué se está mostrando sin adivinar. -->
  <div class="absolute bottom-5 left-1/2 z-[5] hidden -translate-x-1/2 flex-wrap items-center justify-center gap-2 sm:flex">
    {hero.slides.map((s, i) => (
      <button type="button" data-dot={i} class:list={['hero-tab', i === 0 && 'is-active']}>{s.label}</button>
    ))}
  </div>
</section>

<script define:vars={{ phrases: hero.typed, count: hero.slides.length, labels: hero.slides.map((s) => s.label) }}>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Máquina de escribir ----
  const typedEl = document.getElementById('typed');
  if (typedEl) {
    if (reduce) {
      typedEl.textContent = phrases[0];
    } else {
      // Arranca donde lo dejó el HTML: la primera frase ya está escrita entera,
      // así que el ciclo empieza borrándola. Empezar en cero la haría desaparecer
      // de golpe y reescribirse, que se ve como un parpadeo al cargar.
      let p = 0, c = phrases[0].length, deleting = true;
      const tick = () => {
        const full = phrases[p];
        if (!deleting) {
          c++;
          typedEl.textContent = full.slice(0, c);
          if (c === full.length) { deleting = true; setTimeout(tick, 2200); return; }
        } else {
          c--;
          if (c === 0) { deleting = false; p = (p + 1) % phrases.length; }
          typedEl.textContent = full.slice(0, c);
        }
        setTimeout(tick, deleting ? 34 : 62);
      };
      // Pausa larga la primera vez: la frase ya está en pantalla desde que cargó
      // la página, así que hay que darle tiempo de leerse antes de borrarla.
      setTimeout(tick, 2200);
    }
  }

  // ---- Carrusel: móvil y desktop comparten índice ----
  const slides = Array.from(document.querySelectorAll('.hero-slide'));
  const dots = Array.from(document.querySelectorAll('.hero-tab, .hero-mdot'));
  const chip = document.getElementById('mchip');
  let cur = 0, timer;
  const show = (n) => {
    cur = (n + count) % count;
    slides.forEach((s) => s.classList.toggle('is-active', Number(s.dataset.slide) === cur));
    dots.forEach((d) => d.classList.toggle('is-active', Number(d.dataset.dot) === cur));
    if (chip) chip.textContent = labels[cur];
  };
  const auto = () => { clearInterval(timer); timer = setInterval(() => show(cur + 1), 5200); };
  dots.forEach((d) => d.addEventListener('click', () => { show(Number(d.dataset.dot)); auto(); }));
  if (!reduce) auto();

  // ---- Parallax del fondo (solo donde hay fondo a sangre) ----
  const bg = document.getElementById('hero-bg');
  if (bg && !reduce) {
    let ticking = false;
    addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        bg.style.transform = `translateY(${window.scrollY * 0.3}px)`;
        ticking = false;
      });
    }, { passive: true });
  }
</script>

<style>
  /* La reserva de altura vive en el titular entero y ya no en la mitad que se
     anima. Al quitar el <br> las dos partes comparten renglones: cuánto ocupa
     el titular depende de la frase que esté escrita en ese momento, no de una
     mitad aislada. Sin esta reserva el bloque crece y encoge en cada vuelta y
     arrastra consigo las pastillas, el botón y los precios.

     El molde y el titular real comparten la misma celda de la rejilla, así que
     la fila mide lo que mida el más alto: siempre el molde, que lleva la frase
     más larga escrita entera. No hay ningún número que mantener a mano y la
     cuenta sale bien en cualquier ancho, también en los intermedios. */
  .hero-titular { display: grid; }
  .hero-titular > * { grid-area: 1 / 1; }
  .hero-titular__molde {
    visibility: hidden;
    pointer-events: none;
    user-select: none;
    /* El molde tiene que medir con exactamente la misma tipografía que el
       titular, y no la hereda: global.css le da a `h1, h2, h3, h4` un
       interlineado de 1.05 y un espaciado de letra de -0.03em, y un <span> se
       queda fuera de esa regla. Sin estas dos líneas el molde salía más ancho y
       más alto que el titular real, reservaba un renglón de más y dejaba un
       hueco muerto justo debajo del título. */
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .hero-titular__real { align-self: start; }

  /* Botón único del hero. Más grande que el estándar del sitio porque aquí ya
     no comparte sitio con ningún otro: carga solo con toda la llamada a la
     acción, y a tamaño normal se veía perdido bajo un titular de este cuerpo. */
  .btn--hero {
    padding: 13px 13px 13px 26px;
    font-size: 16px;
  }
  .btn--hero .btn__icon {
    height: 34px;
    width: 34px;
  }
  @media (min-width: 640px) {
    .btn--hero {
      padding: 15px 15px 15px 30px;
      font-size: 17px;
    }
    .btn--hero .btn__icon {
      height: 38px;
      width: 38px;
    }
  }

  /* El sello "Hecho en Perú" va más chico que el estándar del sitio, y solo en
     el celular. Ahí el titular creció y el sello quedó pesando demasiado justo
     encima: son dos elementos peleando por la primera mirada, y el que tiene que
     ganarla es el titular. Desde `sm` vuelve al tamaño normal, donde el titular
     ya es lo bastante grande como para no competir. */
  .hero-eyebrow {
    padding: 4px 10px;
    font-size: 9px;
    letter-spacing: 0.16em;
  }
  .hero-eyebrow svg {
    width: 16px;
    height: 11px;
  }
  @media (min-width: 640px) {
    .hero-eyebrow {
      padding: 5px 13px;
      font-size: 10px;
      letter-spacing: 0.2em;
    }
    .hero-eyebrow svg {
      width: 20px;
      height: 13px;
    }
  }

  /* Vitrina móvil con la proporción original (16/11): la captura se ve
     completa, sin recorte. */
  .hero-showcase { aspect-ratio: 16 / 11; }

  /* Pantallas bajas (SE, Android chicos): sacrificamos las pastillas y
     encogemos la vitrina antes que empujar los precios fuera de la pantalla.
     En móviles normales la vitrina queda intacta.

     Lo que aquí NO se toca es la reserva del titular. Antes se acortaba, cuando
     la parte que se anima era una línea suelta y chica debajo del H1. Ahora la
     frase forma parte del titular y recortar la reserva devolvería el salto de
     layout que se arregló. El espacio sale de las pastillas y de la vitrina, que
     son adorno; el titular no. */
  @media (max-height: 760px) {
    .hero-pills { display: none; }
    .hero-showcase { aspect-ratio: auto; height: 24svh; }
  }

  /* El cursor: un elemento vacío al que solo se le ve el borde izquierdo.
     Antes era el carácter "|" dentro de un inline-block, y eso traía dos
     problemas. Uno, el lector de pantalla lo leía como "barra vertical" en
     mitad del titular. Y dos, un inline-block cuenta como objeto para el
     algoritmo de saltos de línea, así que cuando la frase llenaba el renglón
     justo, el cursor se caía solo al siguiente y parpadeaba ahí, huérfano bajo
     el título. Un elemento vacío no aporta ningún carácter, así que no crea
     punto de corte y no puede separarse de la última letra.

     3px de grosor y no 2: vive dentro del titular, y al lado de letras de 40px
     una rayita de 2px se veía como suciedad en la pantalla. */
  .typed-cursor {
    display: inline;
    margin-left: 3px;
    border-left: 3px solid #E8A317;
    animation: bwBlink 1s step-end infinite;
  }

  /* ---- Encuadre de la foto de fondo (solo escritorio) ----
     El problema que resuelve, medido en una ventana de 1366x900: la foto mide
     1280x675 y el contenedor 1351x1044 —más alto que la ventana por el margen
     que necesita el parallax—. Para llenar ese alto, `cover` la agranda hasta
     1980px de ancho, o sea que recorta 629px: un 32% de la foto. Con el anclaje
     que había ("right"), esos 629px se comían el lado izquierdo y todo lo demás
     se corría 629px a la izquierda... justo debajo de la tarjeta, que termina en
     el píxel 636. El producto quedaba tapado por el texto.

     Se arregla por los dos lados:

     1. El anclaje se va corriendo hacia la izquierda a medida que la ventana se
        angosta. Suena al revés y no lo es: `object-position` mueve la ventanilla
        por la que se ve la foto, así que llevarla a la izquierda empuja lo que
        se ve hacia la derecha, que es donde hay sitio libre. A 1920 casi no hay
        recorte y el anclaje original sigue siendo el mejor; de ahí para abajo se
        corrige cada vez más, que es lo que se pidió.

     2. El contenedor deja de estirarse tanto por arriba y por abajo. Ese estirón
        es lo que obliga a `cover` a agrandar la foto; con menos alto sobrante,
        menos aumento y menos recorte. El parallax se mueve algo menos, que a
        estos anchos ni se nota. */
  .hero-bg__foto { object-position: right bottom; }

  @media (max-width: 1600px) {
    .hero-bg__foto { object-position: 55% bottom; }
    .hero-bg { top: -6%; bottom: -6%; }
  }
  @media (max-width: 1400px) {
    .hero-bg__foto { object-position: 46% bottom; }
    .hero-bg { top: -4%; bottom: -4%; }
  }
  @media (max-width: 1180px) {
    .hero-bg__foto { object-position: 28% bottom; }
    .hero-bg { top: -3%; bottom: -3%; }
  }

  /* Sin zoom: la imagen se muestra completa y expandida, solo cruza en fundido */
  .hero-slide {
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .hero-slide.is-active { opacity: 1; }

  /* Fondo difuminado móvil: va DESPUÉS de las reglas genéricas de .hero-slide
     porque comparte especificidad con ellas. */
  .hero-slide--blur {
    filter: blur(44px) saturate(1.6);
    transform: scale(1.3);
  }
  .hero-slide--blur.is-active { opacity: 0.55; }

  /* Indicadores desktop: el nombre de cada servicio como pastilla */
  .hero-tab {
    border: 0;
    cursor: pointer;
    border-radius: 999px;
    padding: 9px 18px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.65);
    background: rgba(8, 12, 24, 0.45);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: all 0.45s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .hero-tab:hover { color: #fff; background: rgba(8, 12, 24, 0.65); }
  .hero-tab.is-active {
    color: #fff;
    background: linear-gradient(135deg, #D91023, #b00d1c);
    box-shadow: 0 10px 25px -8px rgba(217, 16, 35, 0.6);
  }

  /* Indicadores del carrusel móvil: área táctil de 44px, punto visible vía ::before */
  .hero-mdot {
    height: 44px;
