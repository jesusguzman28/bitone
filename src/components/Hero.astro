---
import { hero, waLink } from '../data/site';
import { proyectos } from '../data/proyectos';
import { tecnologias } from '../data/tecnologias';

// La portada es un quipu: el sistema de cuerdas y nudos con que los incas
// registraban información. No es adorno, encodifica datos reales:
//
//   - cada cuerda colgante es un sistema en producción (proyectos.ts);
//   - cada nudo es una tecnología con la que se construyó (su `stack`);
//   - el color de la cuerda es el del propio proyecto.
//
// Si se suma un proyecto o una tecnología, el quipu cambia solo.
//
// El largo de cada cuerda varía para que no parezca una rejilla: sale del
// número de nudos, con un mínimo, así una cuerda con más tecnologías cuelga
// más. Es el único elemento llamativo del sitio y el único que se mueve.
const cuerdas = proyectos.map((p, i) => ({
  nombre: p.nombre,
  rubro: p.rubro,
  color: p.color,
  nudos: p.stack.map((t) => tecnologias[t].nombre),
  largo: 150 + p.stack.length * 22 + (i % 2) * 18,
}));

// En dos grupos de tres: en el celular cada grupo es su propio quipu (una
// cuerda madre con tres colgantes); en pantalla ancha los dos se ponen lado a
// lado y sus cuerdas madre se leen como una sola.
const grupos = [cuerdas.slice(0, 3), cuerdas.slice(3)];

// El titular entero, en un solo color: la primera frase del antiguo titular
// animado era la que llevaba la keyword y es la que queda.
const titular = `${hero.h1} ${hero.typed[0]}`;
---

<section class="hero relative overflow-hidden text-white" style="background:var(--color-anil)">
  <div class="mx-auto w-full max-w-[1120px] px-6 pb-0 pt-[128px] sm:pt-[150px]">
    <h1 class="hero-h1 m-0 max-w-[17ch]">{titular}</h1>

    <p class="mt-7 max-w-[56ch] text-[17px] leading-[1.65] text-[#C9CDE0] sm:text-[18.5px]">
      Construimos sistemas a medida, apps móviles y el mantenimiento de lo que tu empresa ya tiene.
      El alcance y el precio van por escrito antes de programar, y el código queda a tu nombre.
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
      <a
        href={waLink('Hola BIT-ONE, quiero agendar una reunión para conversar un proyecto')}
        target="_blank"
        rel="noopener"
        class="btn btn--whatsapp !px-7 !py-3.5 !text-[15.5px]"
      >Agendar una reunión</a>
      <a href="/proyectos/" class="hero-enlace text-[15.5px]">Ver lo que hemos construido</a>
    </div>

    <!-- El quipu -->
    <figure class="quipu m-0 mt-16 sm:mt-20" aria-labelledby="quipu-leyenda">
      <div class="quipu__grupos">
        {grupos.map((g, gi) => (
          <div class="quipu__grupo">
            <div class="quipu__cuerda-madre" aria-hidden="true"></div>
            <ul class="quipu__cuerdas m-0 list-none p-0">
              {g.map((c, j) => (
                <li class="quipu__col" style={`--i:${gi * 3 + j};--color:${c.color};--largo:${c.largo}px`}>
                  <a href="/proyectos/" class="quipu__enlace" aria-label={`${c.nombre}: ${c.rubro}. Hecho con ${c.nudos.join(', ')}`}>
                    <span class="quipu__cuerda" aria-hidden="true">
                      {c.nudos.map((n, k) => (
                        <span class="quipu__nudo" style={`top:${24 + k * 22}px`} title={n}></span>
                      ))}
                    </span>
                    <span class="quipu__nombre">{c.nombre}</span>
                    <span class="quipu__rubro">{c.rubro}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <figcaption id="quipu-leyenda" class="quipu__leyenda">
        Cada cuerda es un sistema nuestro en producción, y cada nudo una tecnología con la que se construyó.
        Así registraban información los quipus: con cuerdas y nudos.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero-h1 {
    font-size: clamp(2.5rem, 7.4vw, 6.2rem);
    font-stretch: 125%;
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: #fff;
  }

  .hero-enlace {
    color: #fff;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-maiz);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .hero-enlace:hover { color: var(--color-maiz); }

  /* ---- Quipu ---- */
  .quipu { position: relative; padding-bottom: 56px; }
  .quipu__cuerda-madre {
    height: 5px;
    border-radius: 0;
    background: #E9E3D2;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.25);
  }
  .quipu__grupos { display: grid; grid-template-columns: 1fr 1fr; }
  .quipu__cuerdas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }
  .quipu__enlace {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-left: 18%;
    color: inherit;
    text-decoration: none;
  }
  .quipu__cuerda {
    position: relative;
    display: block;
    width: 4px;
    height: var(--largo);
    border-radius: 0 0 3px 3px;
    background: var(--color);
    transform-origin: top;
    animation: caer 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--i) * 90ms + 150ms);
  }
  .quipu__nudo {
    position: absolute;
    left: 50%;
    width: 13px;
    height: 10px;
    margin-left: -6.5px;
    border-radius: 50%;
    background: var(--color-maiz);
    box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.25);
    animation: aparecer 0.4s ease both;
    animation-delay: calc(var(--i) * 90ms + 800ms);
  }
  .quipu__nombre {
    margin-top: 14px;
    font-stretch: 112%;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    color: #fff;
    overflow-wrap: anywhere;
  }
  .quipu__rubro {
    margin-top: 3px;
    font-size: 12.5px;
    line-height: 1.35;
    color: #9BA2C0;
  }
  .quipu__enlace:hover .quipu__nombre { color: var(--color-maiz); }
  .quipu__enlace:hover .quipu__cuerda { width: 6px; }
  .quipu__leyenda {
    margin-top: 36px;
    max-width: 62ch;
    font-size: 13.5px;
    line-height: 1.6;
    color: #9BA2C0;
  }

  @keyframes caer { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes aparecer { from { opacity: 0; } to { opacity: 1; } }

  /* En el celular: un quipu debajo del otro, cuerdas más cortas. */
  @media (max-width: 720px) {
    .quipu__grupos { grid-template-columns: 1fr; row-gap: 40px; }
    .quipu__cuerda-madre { border-radius: 3px; }
    .quipu__cuerda { height: calc(var(--largo) * 0.6); }
    .quipu__nudo { width: 11px; height: 8px; margin-left: -5.5px; }
    .quipu__enlace { padding-left: 14%; }
    .quipu__nombre { font-size: 14px; font-stretch: 96%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .quipu__cuerda, .quipu__nudo { animation: none; }
  }
</style>
