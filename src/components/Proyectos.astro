---
import { proyectos } from '../data/proyectos';
---

<section class="surface px-6 py-20" aria-labelledby="proyectos-lista">
  <div class="mx-auto w-full max-w-[1120px]">
    <div class="reveal mx-auto max-w-[640px] text-center">
      <span class="eyebrow eyebrow--light">Trabajos</span>
      <h2 id="proyectos-lista" class="mt-5 font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
        Algunos de nuestros trabajos
      </h2>
      <p class="mt-4 text-[15px] leading-[1.65] text-slate-500 [text-wrap:pretty]">
        Están en línea ahora mismo. Entra y compruébalo.
      </p>
    </div>

    {/* 250px y no 280: con 280 los cuatro no entraban en la fila —4x280 más los
        3 huecos de 20 dan 1180 y el contenedor mide 1120— y quedaban tres arriba
        y uno solo abajo, más corto que los demás. Con 250 caben los cuatro y la
        rejilla los estira al mismo alto. */}
    <div class="mt-10 grid gap-5" style="grid-template-columns:repeat(auto-fit,minmax(250px,1fr))">
      {proyectos.map((p, i) => (
        <article class="proy-card reveal flex flex-col overflow-hidden rounded-[20px] bg-white" style={`--reveal-delay:${(i % 4) * 70}ms`}>
          {/* La captura y su hueco. Sin imagen no se deja un marco vacío ni un
              icono roto: se pinta una banda con el nombre del rubro, que se lee
              como una portada a propósito y no como un fallo de carga. */}
          {p.imagen ? (
            /* Un solo archivo y no un <picture> con versión chica: estas
               capturas en WebP pesan 35–45 KB, menos que muchas miniaturas, así
               que partirlas en dos tamaños añadiría archivos que mantener sin
               ahorrar nada. Si algún día entra una captura pesada, ahí sí. */
            <img
              src={`/proyectos/${p.imagen}.webp`}
              width="1152"
              height="778"
              alt={p.alt}
              loading="lazy"
              decoding="async"
              class="proy-card__img block w-full object-cover"
            />
          ) : (
            <div class="proy-card__vacio grid place-items-center" aria-hidden="true">
              <span class="font-display text-[13px] font-bold uppercase tracking-[0.16em] text-slate-400">{p.rubro}</span>
            </div>
          )}

          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-center gap-2">
              <h3 class="m-0 font-display text-[17px] font-bold text-dark">{p.nombre}</h3>
              {/* Aviso en pantalla mientras es relleno. Es incómodo a propósito:
                  así nadie lo publica creyendo que ya es un caso real. */}
              {p.esMarcador && (
                <span class="proy-card__pendiente">Por completar</span>
              )}
            </div>
            <p class="mt-1 text-[13px] font-semibold uppercase tracking-[0.1em] text-primary">{p.rubro}</p>
            <p class="mt-3 text-[14.5px] leading-[1.6] text-slate-600 [text-wrap:pretty]">{p.resumen}</p>

            <ul class="m-0 mt-4 flex list-none flex-wrap gap-1.5 p-0">
              {p.entregado.map((e) => (
                <li class="proy-chip">{e}</li>
              ))}
            </ul>

            {/* El botón solo existe si hay dirección de verdad. Es la regla que
                evita repetir el error de prometer "URL en vivo" sin tenerla. */}
            {p.url && (
              <a href={p.url} target="_blank" rel="noopener" class="proy-link mt-auto flex items-center gap-1.5 pt-5 text-[14px] font-bold text-primary no-underline">
                Ver en vivo
                <svg class="proy-link__flecha" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
                <span class="sr-only">{p.nombre}</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .proy-card {
    box-shadow: inset 0 0 0 1px var(--hairline);
    transition: transform 0.45s var(--ease-fluid), box-shadow 0.45s var(--ease-fluid);
  }
  .proy-card:hover {
    transform: translateY(-3px);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-primary) 30%, transparent),
      0 20px 40px -20px rgba(217, 16, 35, 0.16);
  }

  .proy-card__img { aspect-ratio: 40 / 27; }

  /* Mismo alto que tendrá la captura, para que al llegar las fotos reales la
     tarjeta no cambie de tamaño y la fila no se reacomode. */
  .proy-card__vacio {
    aspect-ratio: 40 / 27;
    background:
      linear-gradient(135deg, rgba(217, 16, 35, 0.05), rgba(232, 163, 23, 0.05)),
      #f8fafc;
    box-shadow: inset 0 -1px 0 var(--hairline);
  }

  .proy-card__pendiente {
    border-radius: 999px;
    padding: 3px 9px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #b45309;
    background: rgba(232, 163, 23, 0.16);
  }

  .proy-chip {
    border-radius: 999px;
    padding: 5px 11px;
    font-size: 12px;
    font-weight: 600;
    color: #475569;
    background: #f1f5f9;
  }

  .proy-link__flecha { transition: transform 0.4s var(--ease-fluid); }
  .proy-link:hover .proy-link__flecha { transform: translate(2px, -2px); }

  @media (prefers-reduced-motion: reduce) {
    .proy-card, .proy-link__flecha { transition: none; }
  }
</style>
