---
import { proyectos } from '../data/proyectos';
import { tecnologias } from '../data/tecnologias';

interface Props {
  /** Titular y bajada de la sección. Se pueden sobrescribir porque el bloque se
   *  usa en dos sitios que llegan con el lector en estados distintos: en la
   *  portada, quien lee todavía no sabe quiénes somos y esto es la prueba; en
   *  /proyectos/ ya entró a ver trabajos y el titular no tiene que convencer de
   *  nada, solo ordenar.
   *
   *  Sin cifras en ninguno de los dos, igual que en <AppsProduccion>: el día
   *  que se sume un proyecto, un "cinco" escrito a mano contradice a la lista
   *  que tiene debajo y nadie se acuerda de venir a cambiarlo. */
  title?: string;
  subtitle?: string;
}
const {
  title = 'Productos que construimos de cero',
  subtitle = 'No son encargos ejecutados: son productos que concebimos, construimos y publicamos. Los que tienen dirección pública se pueden abrir ahora mismo.',
} = Astro.props;
---

{/* Rehecho para que combine con <AppsProduccion>, que va justo debajo en la
    portada y en /proyectos/.

    Antes eran tarjetas claras con una captura de pantalla a lo ancho, el rubro
    en mayúsculas, un párrafo de tres o cuatro renglones y cuatro pastillas.
    Multiplicado por cinco proyectos, ocupaba media página y no se parecía en
    nada a la fila compacta y oscura de las apps: dos bloques que dicen lo mismo
    —esto lo construimos nosotros— con dos lenguajes visuales distintos, uno
    encima del otro.

    Ahora comparten anatomía exacta: misma banda oscura, mismo cuadrado
    redondeado para el logotipo, mismo tamaño de nombre, una sola línea de
    descripción y el enlace abajo del todo. Lo que cambia entre los dos bloques
    es solo la rejilla —tres columnas aquí, cuatro allá— porque son cinco y
    cuatro elementos. */}
<section class="proy-band relative isolate overflow-hidden px-6 py-20" aria-labelledby="proyectos-lista">

  <div class="relative mx-auto w-full max-w-[1120px]">
    <div class="reveal max-w-[720px]">
      <h2 id="proyectos-lista" class="m-0 font-display text-[clamp(1.6rem,3.6vw,2.3rem)] font-extrabold leading-[1.1] text-dark [text-wrap:balance]">
        {title}
      </h2>
      <p class="mt-4 max-w-[600px] text-[16px] leading-[1.7] text-[#5B6272] [text-wrap:pretty]">
        {subtitle}
      </p>
    </div>

    <ul class="proy-grid mt-11 grid list-none gap-4 p-0">
      {proyectos.map((p, i) => (
        <li class="reveal" style={`--reveal-delay:${(i % 3) * 70}ms`}>
          <a
            href={p.url ?? '#'}
            target={p.url ? '_blank' : undefined}
            rel={p.url ? 'noopener' : undefined}
            class="proy-card flex h-full flex-col no-underline"
            style={`--acento:${p.color}`}
          >
            {/* El logotipo real del sitio, o un monograma con el color del
                proyecto cuando no hay ninguno publicable. Los dos ocupan
                exactamente el mismo cuadrado, así que la fila no se descuadra
                aunque dos de los cinco no tengan logo. */}
            {p.logo ? (
              <img
                src={`/proyectos/logo-${p.logo}.webp`}
                width="256"
                height="256"
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
                class="proy-card__logo"
              />
            ) : (
              <span class="proy-card__logo proy-card__logo--mono" aria-hidden="true">{p.nombre.charAt(0)}</span>
            )}

            <span class="proy-card__cuerpo">
              <span class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                <span class="proy-card__nombre">{p.nombre}</span>
                {/* Aviso en pantalla mientras es relleno. Es incómodo a
                    propósito: así nadie lo publica creyendo que es un caso
                    real. */}
                {p.esMarcador && <span class="proy-card__pendiente">Por completar</span>}
              </span>

              <span class="proy-card__rubro">{p.rubro}</span>
              <span class="proy-card__que">{p.resumen}</span>

              {/* Lo entregado en una línea de texto separada por puntos, no en
                  pastillas. Cuatro pastillas por tarjeta y cinco tarjetas eran
                  veinte cápsulas de color compitiendo entre sí; en una línea se
                  lee igual de rápido y pesa la décima parte. */}
              <span class="proy-card__entregado">{p.entregado.join(', ')}</span>

              {p.stack.length > 0 && (
                <span class="proy-card__stack">
                  {p.stack.map((t) => (
                    <span class="proy-tech">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill={tecnologias[t].color} aria-hidden="true"><path d={tecnologias[t].path} /></svg>
                      {tecnologias[t].nombre}
                    </span>
                  ))}
                </span>
              )}

              {p.url && (
                <span class:list={['proy-card__link', p.acceso === 'privado' && 'proy-card__link--privado']}>
                  {p.acceso === 'privado' ? (
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                  ) : (
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18Z"/></svg>
                  )}
                  {p.acceso === 'privado' ? 'Acceso privado' : 'Ver en vivo'}
                  <svg class="proy-card__flecha" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
                  <span class="sr-only">{p.nombre}</span>
                </span>
              )}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Misma banda que <AppsProduccion>, un punto más clara. Al ir una encima de
     otra en la portada, esa diferencia mínima las separa sin cortar la
     continuidad: se leen como dos partes de un mismo bloque de prueba y no como
     dos secciones sin relación. */
  .proy-band { background: var(--surface-alt); }

  /* Tres columnas y no cuatro: son cinco proyectos, y con cuatro quedaría una
     fila de cuatro y otra de uno solo estirado a lo ancho. Con tres van 3 + 2 y
     la segunda fila se centra sola. */
  .proy-grid { grid-template-columns: 1fr; }
  @media (min-width: 620px) { .proy-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 980px) { .proy-grid { grid-template-columns: repeat(3, 1fr); } }

  .proy-card {
    height: 100%;
    border-radius: 10px;
    padding: 18px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--hairline);
    transition: box-shadow 0.25s ease;
  }
  .proy-card:hover { box-shadow: inset 0 0 0 2px var(--acento); }
  .proy-card:focus-visible {
    outline: 2px solid var(--acento);
    outline-offset: 3px;
  }

  /* El mismo cuadrado que el icono de una app, para que las dos filas rimen. */
  .proy-card__logo {
    display: block;
    height: 60px;
    width: 60px;
    border-radius: 8px;
    /* `outline` con offset negativo y no `box-shadow: inset`: una sombra
       interior no se ve sobre un <img>, el navegador pinta la imagen encima. */
    outline: 1px solid rgba(26, 32, 68, 0.1);
    outline-offset: -1px;
  }
  .proy-card__logo--mono {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 25px;
    font-weight: 800;
    line-height: 1;
    color: #fff;
    background: var(--acento);
    outline: none;
  }

  .proy-card__cuerpo {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-top: 15px;
  }
  .proy-card__nombre {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 800;
    font-stretch: 112%;
    color: var(--color-anil);
  }
  .proy-card__pendiente {
    border-radius: 999px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 700;
    color: #fcd34d;
    background: rgba(252, 211, 77, 0.14);
  }
  .proy-card__rubro {
    margin-top: 6px;
    font-size: 11px;
    font-weight: 700;
    color: color-mix(in srgb, var(--acento) 75%, #1A2044);
  }
  .proy-card__que {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.6;
    color: #3E4456;
    text-wrap: pretty;
  }
  .proy-card__entregado {
    margin-top: 12px;
    font-size: 12.5px;
    line-height: 1.55;
    color: #6B7185;
  }
  .proy-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-top: 14px;
  }
  .proy-tech {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 600;
    color: #3E4456;
  }

  .proy-card__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 15px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-anil);
  }
  /* El enlace a un sistema privado va apagado. El tono de acción promete "esto
     se puede abrir", y aquí lo que hay detrás es una pantalla de inicio de
     sesión: el color avisa antes de que se lea el texto. */
  .proy-card__link--privado { color: #8A90A0; }

  .proy-card__flecha { transition: transform 0.4s var(--ease-fluid); }
  .proy-card:hover .proy-card__flecha { transform: translate(2px, -2px); }

  @media (prefers-reduced-motion: reduce) {
    .proy-card, .proy-card__flecha, .proy-card__logo { transition: none; }
  }
</style>
