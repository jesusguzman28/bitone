---
// Las personas: retrato, nombre, rol y LinkedIn, en una fila de tres columnas a todo
// el ancho (escritorio y tableta) o una por fila (celular). Los retratos son lo único
// redondo de la marca: las personas no son módulos. Van en gris, dentro de un
// disco con el mismo fondo y el mismo aro, y chicos (72 px): son tres fotos
// distintas y de baja resolución, y así quedan parejas. Cada una lleva su encuadre
// (`encuadre`, en data/empresa.ts): el mismo que usa la portada de /nosotros/, para
// que las tres caras se vean igual en las dos páginas.
// El brief solo respalda nombre, rol y enlace: no se añaden cargos ni biografías.
import Imagen from './Imagen.astro';
import Icono from './Icono.astro';
import { cofundadores, type Cofundador } from '../data/empresa';

interface Props {
  personas?: Cofundador[];
  /** Nivel del nombre de cada persona. */
  nivel?: 3 | 4;
  class?: string;
}

const { personas = cofundadores, nivel = 3, class: clase, ...resto } = Astro.props;
const Nombre = `h${nivel}` as 'h3' | 'h4';
---

<ul class:list={['gente', clase]} style={`--n:${personas.length}`} {...resto}>
  {personas.map((p) => (
    <li class="persona" data-rev>
      <span class="persona__disco" style={p.encuadre ? `--zoom:${p.encuadre.zoom};--x:${p.encuadre.x}%;--y:${p.encuadre.y}%` : undefined}>
        {/* El nombre va escrito al lado: el retrato no lo repite al lector de pantalla.
            Se pide más ancho que los 72 px del disco porque la foto va ampliada. */}
        <Imagen src={p.foto} alt="" anchos={[120, 240, 360]} tamanos="120px" />
      </span>
      <div class="persona__txt">
        <p class="rotulo persona__rol">{p.rol}</p>
        <Nombre class="persona__n">{p.nombre}</Nombre>
      </div>
      <a class="enlace menor persona__ir" href={p.linkedin} target="_blank" rel="noopener">LinkedIn<span class="solo-lector"> de {p.nombre}</span><Icono nombre="fuera" /></a>
    </li>
  ))}
</ul>

<style>
  .gente { display: grid; grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr)); column-gap: calc(var(--u) * .5); border-top: 1px solid var(--filete-fuerte); }
  .persona { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: auto auto; align-items: center; column-gap: 18px; padding-top: 20px; }
  /* El disco: mismo fondo y mismo aro para las tres fotos, vengan como vengan. */
  .persona__disco { grid-row: 1 / 3; display: block; width: 72px; height: 72px; overflow: hidden; border-radius: 50%; background: var(--arena); box-shadow: 0 0 0 1px var(--linea-fuerte); }
  .persona__disco :global(picture) { width: 100%; height: 100%; }
  /* El encuadre amplía la foto (--zoom) y lleva al centro del disco el punto (--x, --y). */
  .persona__disco :global(img) {
    width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.08);
    transform: translate(calc((50% - var(--x, 50%)) * var(--zoom, 1)), calc((50% - var(--y, 50%)) * var(--zoom, 1))) scale(var(--zoom, 1));
  }
  .persona__txt { align-self: end; }
  .persona__rol { color: var(--texto-2); }
  .persona__n { margin-top: 2px; font-weight: 700; font-stretch: 110%; font-size: 1.25rem; letter-spacing: -.02em; line-height: 1.2; text-wrap: balance; }
  .persona__ir { grid-column: 2; align-self: start; justify-self: start; }

  @media (max-width: 959px) {
    .gente { column-gap: calc(var(--u) * .3); }
  }
  @media (max-width: 699px) {
    /* En celular, una persona por fila, como en un libro: retrato, rol y nombre, y
       LinkedIn a la derecha. En tres columnas un nombre largo se partía en tres renglones
       y cada enlace quedaba colgando con un hueco distinto. */
    .gente { grid-template-columns: minmax(0, 1fr); }
    .persona { grid-template-columns: 56px minmax(0, 1fr) auto; grid-template-rows: none; align-items: center; column-gap: 14px; padding-block: 4px; border-bottom: 1px solid var(--filete); }
    .persona__disco { grid-row: auto; width: 56px; height: 56px; }
    .persona__txt { align-self: center; }
    .persona__n { font-size: 1rem; }
    .persona__ir { grid-column: 3; align-self: center; }
  }
</style>
