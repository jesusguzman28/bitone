---
import { homeStats } from '../data/site';

// El campo `derivado` de cada cifra sobrevive aunque ahora ninguna lo use.
//
// Servía para una sola cosa: la "entrega mínima" salía del plazo más corto de
// las 12 landings de rubro en vez de estar escrita a mano, así no podía quedar
// vieja. Esas landings ya no existen y esa cifra tampoco, pero el mecanismo se
// queda porque el problema que resolvía sigue vigente: cualquier número que se
// pueda calcular a partir de los datos reales debe calcularse, no escribirse.
//
// Para volver a usarlo: se le pone a la cifra `derivado: 'loQueSea'` en
// site.ts y aquí se añade la rama que lo resuelve.
const stats = homeStats;
---

<section class="surface px-6 py-14" aria-label="Cifras de BIT-ONE">
  <div
    class="reveal mx-auto grid w-full max-w-[1120px] gap-4 rounded-[28px] px-[clamp(20px,4vw,44px)] py-[34px]"
    style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));background:linear-gradient(135deg,#151b29,#0e1521);box-shadow:0 30px 60px -30px rgba(14,21,33,0.6)"
  >
    {stats.map((s) => (
      <div class="text-center">
        <div class="font-display text-[clamp(1.9rem,4vw,2.6rem)] font-bold text-white">
          {/* El valor final va en el HTML: los rastreadores de Google y de los
              buscadores con IA no ejecutan JavaScript. La cuenta desde cero es
              solo un adorno que el script añade después. */}
          {s.prefix}<span data-count={s.n}>{s.n}</span>{!s.tight && ' '}<span class="text-[0.5em] text-accent">{s.suffix}</span>
        </div>
        <div class="mt-1 text-[12.5px] text-slate-400">{s.k}</div>
      </div>
    ))}
  </div>
</section>

<script>
  const els = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Sin soporte o con movimiento reducido no se toca nada: el número correcto
  // ya está escrito en el HTML.
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const target = e.target as HTMLElement;
        const end = Number(target.dataset.count);
        const t0 = performance.now();
        const dur = 1400;
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / dur);
          target.textContent = String(Math.round(end * (1 - Math.pow(1 - k, 3))));
          if (k < 1) requestAnimationFrame(step);
        };
        target.textContent = '0';
        requestAnimationFrame(step);
      }
    }, { threshold: 0.5 });
    els.forEach((el) => io.observe(el));
  }
</script>
