---
// Pares "Hoy / Con el sistema": el problema dicho como lo dice el dueño y cómo queda.
//   disposicion="columnas"  cada par es una columna (hasta tres); para acompañar algo
//   disposicion="filas"     tabla de dos columnas; para cuando los pares son el contenido
// Se colorea solo según el plano donde esté (claro, tinta o rojo).
import Icono from './Icono.astro';
import type { Par } from '../data/empresa';

interface Props {
  pares: Par[];
  disposicion?: 'columnas' | 'filas';
  /** Rótulo de la segunda parte. */
  rotuloDespues?: string;
  class?: string;
}

const { pares, disposicion = 'columnas', rotuloDespues = 'Con el sistema', class: clase, ...resto } = Astro.props;
---

<ul class:list={['pares', `pares--${disposicion}`, clase]} style={`--n:${Math.min(pares.length, 3)}`} {...resto}>
  {pares.map((par) => (
    <li class="par" data-rev>
      <p class="par__hoy"><span class="rotulo par__rot"><i class="par__pt par__pt--suelto" aria-hidden="true"></i>Hoy</span>{par.hoy}</p>
      <Icono nombre={disposicion === 'filas' ? 'derecha' : 'abajo'} class="par__flecha" />
      <p class="par__con"><span class="rotulo par__rot"><i class="par__pt" aria-hidden="true"></i>{rotuloDespues}</span>{par.despues}</p>
    </li>
  ))}
</ul>

<style>
  .pares { display: grid; }
  .par__rot { display: block; margin-bottom: 8px; color: var(--texto-2); }
  .par__con .par__rot { color: var(--acento); }
  .par__pt { display: inline-block; width: .62em; height: .62em; margin-right: .75em; background: var(--rojo); }
  .par__pt--suelto { background: none; box-shadow: inset 0 0 0 1.5px currentColor; transform: rotate(18deg); }
  .par__hoy { color: var(--texto-2); font-size: var(--t-texto); line-height: 1.4; text-wrap: pretty; }
  .par__con { font-weight: 700; font-stretch: 108%; font-size: var(--t-destacado); line-height: 1.15; letter-spacing: -.02em; text-wrap: balance; }
  .par :global(.par__flecha) { width: 18px; height: 18px; color: var(--rojo); }

  /* columnas: sobre la retícula, sin separación entre ellas. En un bloque de ocho
     módulos, dos pares arrancan en el 1 y el 5. El aire entre uno y el siguiente lo pone
     el relleno de cada par (el último no lleva: termina en el borde del bloque). */
  .pares--columnas { grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr)); column-gap: 0; }
  .pares--columnas .par { display: grid; grid-template-rows: subgrid; grid-row: span 3; row-gap: 14px; padding-top: 18px; border-top: 1px solid var(--filete-fuerte); }
  .pares--columnas .par:not(:last-child) { padding-right: calc(var(--u) * .5); }

  /* filas */
  .pares--filas { border-top: 1px solid var(--filete-fuerte); }
  .pares--filas .par { display: grid; grid-template-columns: minmax(0, 7fr) calc(var(--u) * 1) minmax(0, 8fr); align-items: start; padding-block: clamp(16px, calc(var(--u) * .28), 26px); border-bottom: 1px solid var(--filete); }
  .pares--filas .par :global(.par__flecha) { margin-top: 2.1em; }

  @media (max-width: 959px) {
    .pares--columnas { grid-template-columns: 1fr; }
    .pares--columnas .par { grid-template-rows: none; grid-row: auto; grid-template-columns: minmax(0, 1fr) 32px minmax(0, 1fr); align-items: start; row-gap: 0; padding-block: 16px; }
    .pares--columnas .par:not(:last-child) { padding-right: 0; }
    .pares--columnas .par :global(.par__flecha) { margin-top: 2em; transform: rotate(-90deg); }
  }
  @media (max-width: 699px) {
    .pares--columnas .par, .pares--filas .par { display: block; padding-block: 11px 12px; }
    .par :global(.par__flecha) { display: none; }
    /* El rótulo va en el mismo renglón que su frase: ocupa menos y se lee igual. */
    .par__hoy .par__rot { display: inline; margin: 0 .7em 0 0; }
    .par__con .par__rot { margin-bottom: 2px; }
    .par__hoy { margin-bottom: 8px; font-size: var(--t-menor); }
  }
</style>
