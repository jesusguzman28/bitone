---
// La portada de /nosotros/: la frase de la casa y, a su lado, quienes la firman.
// Donde las demás páginas llevan su signo, aquí van tres módulos con una persona
// dentro: un marco (el signo "medida") y, en el centro, un retrato redondo. Las
// personas son lo único redondo de la página; todo lo demás es módulo.
// En celular el orden es frase, personas y botón: se lee "quien" y se ve quiénes.
// Los retratos no pasan de 72 px: las fotos que hay no aguantan más (brief 03).
//
// ES LA MISMA PORTADA QUE PortadaInterior, con personas en vez de signo. Si una
// cambia, la otra cambia igual. Lo que tienen que compartir:
//   · la sección con aria-labelledby="titulo-pagina" y el único <h1> con ese id;
//   · el rótulo encima y el margen del titular bajo él;
//   · el tamaño del titular: --t-titulo por 1.3 en escritorio y por 1.12 en tableta y
//     celular (a 1.3, "con quien hace" no cabe en los ocho módulos de la tableta), y en
//     tableta el ancho de letra del celular (108 %);
//   · el aire: .9 módulos arriba y abajo; 22 y 28 px en celular; .45 sobre el botón;
//   · la cenefa: los dos frisos (18 columnas, semilla 33; 8 columnas, semilla 8),
//     `tonoDeAbajo` y sus tres cortes.
// Una diferencia, a propósito:
//   · las personas no arrancan en el 13 del signo: son tres módulos pegados, como en
//     el tejido. Desde 1280 px juntos miden cinco módulos de la página y arrancan en el
//     12 (el eje de las notas); desde 1440 px el módulo deja de crecer (132 px) y el
//     bloque se queda contra el margen derecho. En el escritorio angosto (960 a 1279 px)
//     cada uno mide dos módulos y arrancan en el 11. Así la cara (72 px como mucho)
//     llena siempre más de la mitad de su módulo: en uno de 160 px eran tres marcos
//     negros con una miniatura dentro.
// Orden del foco en escritorio: titular, los tres LinkedIn y el botón. Se deja así
// para que en celular el orden del HTML sea el que se ve (frase, personas, botón).
import Rotulo from '../Rotulo.astro';
import Friso from '../Friso.astro';
import BotonWhatsApp from '../BotonWhatsApp.astro';
import Imagen from '../Imagen.astro';
import Icono from '../Icono.astro';
import { cofundadores, type Cofundador } from '../../data/empresa';
import type { NombreSigno, TonoSigno } from '../../lib/signos';

interface Props {
  signo: NombreSigno;
  rotulo: string;
  /** Renglones del titular: cada uno es una frase que no se parte. */
  titulo: string[];
  /** Encabezado de la lista de personas, solo para lector de pantalla. */
  tituloPersonas: string;
  /** Cada persona trae el encuadre de su retrato (data/empresa.ts). */
  personas?: Cofundador[];
  textoBoton?: string;
  /** Un dato en rótulo junto al botón (el plazo de respuesta). */
  dato?: string;
  /** El plano de la sección que viene debajo, para que la cenefa no se disuelva en él. */
  tonoDeAbajo?: TonoSigno;
}

const { signo, rotulo, titulo, tituloPersonas, personas = cofundadores, textoBoton, dato, tonoDeAbajo } = Astro.props;

const gente = personas.map((p) => {
  const e = p.encuadre ?? { zoom: 1, x: 50, y: 50 };
  // El nombre se parte siempre igual: el de pila en su renglón y los apellidos debajo.
  const resto = p.nombre.startsWith(p.pila) ? p.nombre.slice(p.pila.length).trim() : '';
  return {
    ...p,
    primero: resto ? p.pila : p.nombre,
    apellidos: resto ? resto.split(' ') : [],
    encuadre: `--zoom:${e.zoom};--x:${e.x}%;--y:${e.y}%`,
  };
});
---

<section class="pf" aria-labelledby="titulo-pagina">
  <div class="reticula pf__r">
    <div class="pf__cab">
      <Rotulo>{rotulo}</Rotulo>
      <h1 class="titulo pf__t" id="titulo-pagina">
        {titulo.map((r, i) => <><span class="renglon">{r}</span>{i < titulo.length - 1 && ' '}</>)}
      </h1>
    </div>

    <div class="pf__gente">
      <h2 class="solo-lector">{tituloPersonas}</h2>
      <ul class="pf__lista" style={`--n:${gente.length}`}>
        {gente.map((p) => (
          <li class="pf__p">
            <span class="pf__modulo">
              <span class="pf__disco" style={p.encuadre}>
                {/* El nombre va escrito debajo: el retrato no lo repite al lector de pantalla.
                    Se pide más ancho que los 72 px del disco porque la foto va ampliada. */}
                <Imagen src={p.foto} alt="" anchos={[120, 240, 360]} tamanos="120px" prioridad />
              </span>
            </span>
            <p class="rotulo pf__rol">{p.rol}</p>
            <h3 class="pf__n"><span class="renglon">{p.primero}</span>{' '}{p.apellidos.map((a, i) => <span class="pf__ap">{a}{i < p.apellidos.length - 1 && ' '}</span>)}</h3>
            <a class="enlace menor pf__ir" href={p.linkedin} target="_blank" rel="noopener">LinkedIn<span class="solo-lector"> de {p.nombre}</span><Icono nombre="fuera" /></a>
          </li>
        ))}
      </ul>
    </div>

    <div class="pf__accion">
      <BotonWhatsApp texto={textoBoton} />
      {dato && <p class="rotulo pf__dato">{dato}</p>}
    </div>
  </div>

  <div class="pf__cenefa">
    <Friso tipo="tejido" columnas={18} filas={1} signo={signo} semilla={33} tonoDeAbajo={tonoDeAbajo} class="pf__friso pf__friso--ancho" />
    <Friso tipo="tejido" columnas={8} filas={1} signo={signo} semilla={8} tonoDeAbajo={tonoDeAbajo} class="pf__friso pf__friso--celular" />
  </div>
</section>

<style>
  /* ---------- escritorio ----------
     La frase ocupa los módulos 1 a 10 y las personas, del 11 al 16. Las personas
     asientan abajo, a la altura del botón, igual que el signo en las otras portadas. */
  .pf { padding-top: calc(var(--u) * .9); }
  .pf__r { align-items: end; padding-bottom: calc(var(--u) * .9); }
  .pf__cab { grid-column: 1 / 11; grid-row: 1; }
  /* El renglón más largo ("con quien hace") mide 8,3 veces el tamaño de la letra. */
  .pf__t { margin-top: clamp(14px, calc(var(--u) * .28), 26px); font-size: calc(var(--t-titulo) * 1.3); line-height: .96; }
  .pf__accion { grid-column: 1 / 11; grid-row: 2; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 28px; margin-top: calc(var(--u) * .45); }
  .pf__dato { color: var(--texto-2); }

  .pf__gente { grid-column: 11 / -1; grid-row: 1 / 3; }
  /* Las filas se comparten entre las tres columnas: rol, nombre y enlace quedan
     alineados aunque un nombre ocupe más renglones que otro. */
  .pf__lista {
    /* El lado del módulo son dos módulos de la página, hasta 132 px: más grande, el
       retrato, que no pasa de 72 px, se pierde dentro de su marco. Así va en celular, en
       tableta y en el escritorio angosto (del 11 al 16). Desde 1280 px, más abajo, los
       tres juntos miden cinco módulos de la página (del 12 al 16).
       Lo que sobra a cada lado del retrato (--resto) se reparte entre el margen, el
       marco (--marco, fino: manda la cara) y la luz que queda entre el marco y el retrato. */
    --lado: min(calc(var(--u) * 2), 132px);
    --cara: min(72px, calc(var(--lado) * .61));
    --resto: calc((var(--lado) - var(--cara)) / 2);
    --marco: calc(var(--resto) * .22);
    display: grid; grid-template-columns: repeat(var(--n, 3), var(--lado)); grid-template-rows: auto auto 1fr auto; justify-content: end;
  }
  .pf__p { position: relative; display: grid; grid-template-rows: subgrid; grid-row: span 4; justify-items: start; }

  /* El módulo de una persona: fondo arena, marco de tinta y el retrato en el vano. */
  .pf__modulo { position: relative; display: grid; place-items: center; width: 100%; aspect-ratio: 1; background: var(--arena); }
  .pf__modulo::before { content: ""; position: absolute; inset: var(--marco); border: var(--marco) solid var(--tinta); transition: border-color var(--d-toque) ease; }
  .pf__disco { position: relative; display: block; width: var(--cara); aspect-ratio: 1; overflow: hidden; border-radius: 50%; background: var(--arena); }
  .pf__disco :global(picture) { width: 100%; height: 100%; }
  /* En gris y con el mismo contraste: son tres fotos distintas y así quedan parejas.
     El encuadre amplía la foto (--zoom) y lleva al centro del disco el punto (--x, --y). */
  .pf__disco :global(img) {
    width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.08);
    transform: translate(calc((50% - var(--x, 50%)) * var(--zoom, 1)), calc((50% - var(--y, 50%)) * var(--zoom, 1))) scale(var(--zoom, 1));
  }

  .pf__rol { margin-top: 14px; color: var(--texto-2); }
  /* Una palabra por renglón: el corte del nombre no depende del ancho de la ventana. */
  .pf__n { margin-top: 2px; padding-right: 10px; font-weight: 700; font-stretch: 110%; font-size: var(--t-texto); letter-spacing: -.02em; line-height: 1.18; }
  .pf__ap { display: block; }
  .pf__ir { align-self: end; }

  .pf__cenefa { overflow: hidden; }
  .pf__cenefa :global(.pf__friso--celular) { display: none; }

  /* Con ratón, toda la persona lleva a su LinkedIn y su marco avisa en rojo ("ahora").
     Con el dedo el enlace es solo la palabra "LinkedIn", que ya mide 44 px: tocar una
     cara no saca a nadie de la página. */
  @media (hover: hover) and (pointer: fine) {
    .pf__ir::after { content: ""; position: absolute; inset: 0; }
    .pf__p:hover .pf__modulo::before { border-color: var(--rojo); }
  }
  /* Con teclado, el marco avisa igual que con el ratón. */
  .pf__p:has(.pf__ir:focus-visible) .pf__modulo::before { border-color: var(--rojo); }

  /* Con ancho de sobra, cada lado es un módulo y dos tercios, hasta los mismos 132 px
     (lo que mide a 1440): los tres juntos son cinco módulos y arrancan en el 12, el eje
     de las notas. */
  @media (min-width: 1280px) {
    .pf__lista { --lado: min(calc(var(--u) * 5 / 3), 132px); }
  }

  /* ---------- tableta ----------
     A 1.3 el renglón "con quien hace" no cabe en ocho módulos: va ya a 1.12. */
  @media (max-width: 959px) {
    .pf__cab, .pf__gente, .pf__accion { grid-column: 1 / -1; grid-row: auto; }
    .pf__t { font-size: calc(var(--t-titulo) * 1.12); }
    .pf__gente { margin-top: calc(var(--u) * .5); }
    .pf__lista { justify-content: start; }
    .pf__cenefa :global(.pf__friso--ancho) { width: 180%; margin-left: -40%; }
  }
  /* El mismo ancho de letra que PortadaInterior en tableta. */
  @media (min-width: 700px) and (max-width: 959px) {
    .pf__t { font-stretch: 108%; }
  }

  /* ---------- celular ----------
     Los tres módulos ocupan justo los seis del ancho. */
  @media (max-width: 699px) {
    .pf { padding-top: 22px; }
    .pf__r { padding-bottom: 28px; }
    .pf__t { line-height: 1; }
    .pf__gente { margin-top: 26px; }
    /* El módulo mide unos 118 px y la cara, el 61 %: aquí el marco aguanta más grueso. */
    .pf__lista { --marco: calc(var(--resto) * .36); }
    .pf__rol { margin-top: 10px; }
    .pf__n { padding-right: 8px; }
    .pf__accion { flex-direction: column; align-items: stretch; gap: 8px; margin-top: 18px; }
    .pf__cenefa :global(.pf__friso--ancho) { display: none; }
    .pf__cenefa :global(.pf__friso--celular) { display: block; }
  }
</style>
