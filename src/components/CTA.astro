---
import { waLink } from '../data/site';

interface Props {
  title?: string;
  subtitle?: string;
}
const {
  title = '¿Conversamos sobre tu proyecto?',
  subtitle = 'Escríbenos al WhatsApp y recibe una cotización gratis en menos de 24 horas. Sin compromiso, en soles y con facilidades de pago.',
} = Astro.props;
---

<!-- Banda de marca a todo el ancho: mismo cierre que bitwise.pe -->
<section class="band-brand relative isolate overflow-hidden px-6 py-24 text-center text-white">
  <div class="pointer-events-none absolute -left-24 -top-24 h-80 w-80 rounded-full opacity-25 blur-[80px]" style="background:radial-gradient(circle,#fff,transparent 70%)"></div>
  <div class="pointer-events-none absolute -bottom-24 -right-24 h-80 w-80 rounded-full opacity-20 blur-[80px]" style="background:radial-gradient(circle,#fff,transparent 70%)"></div>

  <div class="reveal relative mx-auto max-w-[720px]">
    <h2 class="font-display text-[clamp(1.9rem,4.5vw,2.75rem)] font-extrabold leading-[1.1]">{title}</h2>
    <p class="mx-auto mt-4 max-w-[520px] text-[16.5px] leading-[1.65] text-white/90">{subtitle}</p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={waLink()} target="_blank" rel="noopener" class="btn btn--whatsapp group !py-3 !pl-[26px] !text-[15px]">
        Cotizar por WhatsApp
        <span class="btn__icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </span>
      </a>
      <a href="/contacto" class="btn btn--white">Otras formas de contacto</a>
    </div>
  </div>
</section>
