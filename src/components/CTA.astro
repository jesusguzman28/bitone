---
import { waLink } from '../data/site';

interface Props {
  title?: string;
  subtitle?: string;
}
const {
  title = '¿Conversamos sobre tu proyecto?',
  subtitle = 'Escríbenos al WhatsApp y recibe una cotización gratis en menos de 24 horas. Sin compromiso, con alcance y precio por escrito.',
} = Astro.props;
---

<!-- Banda de marca a todo el ancho -->
<section class="band-brand relative isolate overflow-hidden px-6 py-24 text-white">

  <div class="reveal relative mx-auto w-full max-w-[1120px]">
    <h2 class="max-w-[16ch] font-display text-[clamp(2rem,5vw,3.4rem)] font-extrabold leading-[1.02]">{title}</h2>
    <p class="mt-4 max-w-[520px] text-[16.5px] leading-[1.65] text-[#C9CDE0]">{subtitle}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href={waLink()} target="_blank" rel="noopener" class="btn btn--whatsapp group !py-3 !pl-[26px] !text-[15px]">
        Cotizar por WhatsApp
        <span class="btn__icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </span>
      </a>
      <a href="/contacto/" class="btn btn--white">Otras formas de contacto</a>
    </div>
  </div>
</section>
