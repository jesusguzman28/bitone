---
import { nav, waLink } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header id="nav-barra" class="fixed inset-x-0 top-0 z-[60] bg-white">
  <nav class="mx-auto flex h-[68px] w-full max-w-[1120px] items-center justify-between gap-4 px-6">
    <a href="/" class="marca no-underline" aria-label="BIT-ONE, inicio">BIT<span class="marca__guion">-</span>ONE</a>

    <ul class="nav-desktop m-0 hidden list-none items-center gap-6 p-0 md:flex">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={['nav-link text-[14.5px] no-underline', isActive(item.href) && 'nav-active']}
          >{item.label}</a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a href={waLink()} target="_blank" rel="noopener" class="btn btn--primary hidden md:inline-flex">Cotizar</a>

      <button id="nav-toggle" class="grid h-10 w-10 cursor-pointer place-items-center border-0 bg-transparent md:hidden" aria-label="Menú" aria-expanded="false">
        <span class="relative block h-4 w-5">
          <span id="bar1" class="absolute left-0 top-0 h-0.5 w-5 bg-dark transition-all duration-300"></span>
          <span id="bar2" class="absolute bottom-0 left-0 h-0.5 w-5 bg-dark transition-all duration-300"></span>
        </span>
      </button>
    </div>
  </nav>
</header>

<!-- Overlay móvil -->
<div
  id="nav-overlay"
  inert
  class="pointer-events-none fixed inset-0 z-[55] flex flex-col items-start justify-center gap-3 px-8 opacity-0 transition-opacity duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] md:hidden"
  style="background:#fff"
>
  {nav.map((item, i) => (
    <a
      href={item.href}
      class:list={[
        'nav-ov-item translate-y-7 font-display text-3xl font-bold no-underline opacity-0 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]',
        isActive(item.href) ? 'text-primary' : 'text-dark',
      ]}
      style={`transition-delay:${i * 60}ms`}
    >{item.label}</a>
  ))}
  <a
    href={waLink()}
    target="_blank"
    rel="noopener"
    class="nav-ov-item btn btn--primary mt-5 translate-y-7 !px-[26px] !py-[13px] !text-[15px] opacity-0 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
    style={`transition-delay:${nav.length * 60}ms`}
  >Cotizar por WhatsApp</a>
</div>

<script>
  const toggle = document.getElementById('nav-toggle');
  const overlay = document.getElementById('nav-overlay');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const items = document.querySelectorAll('.nav-ov-item');
  let open = false;

  function setOpen(v: boolean) {
    open = v;
    toggle?.setAttribute('aria-expanded', String(v));
    document.body.style.overflow = v ? 'hidden' : '';
    if (v) {
      overlay?.removeAttribute('inert');
      overlay?.classList.add('opacity-100', 'pointer-events-auto');
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
      bar1?.classList.add('nav-x-top');
      bar2?.classList.add('nav-x-bottom');
      items.forEach((el) => el.classList.remove('translate-y-7', 'opacity-0'));
    } else {
      overlay?.setAttribute('inert', '');
      overlay?.classList.remove('opacity-100', 'pointer-events-auto');
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      bar1?.classList.remove('nav-x-top');
      bar2?.classList.remove('nav-x-bottom');
      items.forEach((el) => el.classList.add('translate-y-7', 'opacity-0'));
    }
  }

  toggle?.addEventListener('click', () => setOpen(!open));
  overlay?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) { setOpen(false); toggle?.focus(); }
  });

  // Una línea fina bajo la barra en cuanto la página se mueve: separa el menú
  // del contenido sin sombras.
  const barra = document.getElementById('nav-barra');
  addEventListener('scroll', () => barra?.classList.toggle('con-borde', window.scrollY > 8), { passive: true });
</script>

<style>
  .marca {
    font-stretch: 125%;
    font-size: 21px;
    font-weight: 850;
    letter-spacing: -0.02em;
    color: var(--color-anil);
  }
  .marca__guion { color: var(--color-grana); }
  #nav-barra { transition: box-shadow 0.2s ease; }
  #nav-barra.con-borde { box-shadow: 0 1px 0 var(--hairline); }
  .nav-link { color: var(--color-piedra); font-weight: 550; padding: 6px 0; }
  .nav-link:hover { color: var(--color-anil); }
  .nav-active { color: var(--color-anil); font-weight: 700; box-shadow: inset 0 -2px 0 var(--color-grana); }
  .nav-x-top { top: 50% !important; transform: translateY(-50%) rotate(45deg); }
  .nav-x-bottom { bottom: 50% !important; transform: translateY(50%) rotate(-45deg); }
</style>
