---
import Stars from './Stars.astro';

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  flag?: boolean;
  compact?: boolean;
}
const { eyebrow, title, subtitle, flag = false, compact = false } = Astro.props;
---

<section class:list={['hero-dark relative isolate overflow-hidden px-6 text-center text-white', compact ? 'pb-[66px] pt-[150px]' : 'pb-[70px] pt-[150px]']}>
  <Stars />

  <span class="eyebrow eyebrow--dark">
    {flag && (
      <svg width="20" height="13" viewBox="0 0 3 2" aria-hidden="true" style="border-radius:2px;box-shadow:0 0 0 1px rgba(255,255,255,0.15)">
        <rect width="1" height="2" x="0" fill="#D91023"/><rect width="1" height="2" x="1" fill="#fff"/><rect width="1" height="2" x="2" fill="#D91023"/>
      </svg>
    )}
    {eyebrow}
  </span>
  <h1 class="mx-auto mt-[18px] max-w-[700px] font-display text-[clamp(1.9rem,5vw,3rem)] font-bold leading-[1.08]" set:html={title} />
  {subtitle && <p class="mx-auto mt-4 max-w-[540px] text-base leading-[1.65] text-slate-300">{subtitle}</p>}
  <slot />
</section>
