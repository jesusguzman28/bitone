---

// Sin rótulo sobre el titular.
//
// Este componente tenía un `eyebrow`: la etiqueta pequeña que iba encima del H1
// —"Contacto", "Metodología", "Sobre nosotros"—. Se quitó en todo el sitio, y
// no por gusto: en cada caso decía exactamente lo mismo que el menú de arriba
// ya marca como sección activa y lo que el propio titular dice debajo. Una
// etiqueta que repite dos veces lo que ya está en pantalla no es jerarquía, es
// relleno, y es una de las cosas que hacen que una página se lea como
// plantilla generada en vez de como algo escrito para este sitio.
//
// El mismo criterio se aplicó a los rótulos de sección de los componentes
// (Servicios, Proyectos, FAQ, Comparativa…) y a la banderita del pie.
interface Props {
  title: string;
  /** Frase de entrada bajo el H1. Sirve para que un titular de marca pueda
   *  convivir con un H1 que lleva la keyword, sin perder el copy. */
  lead?: string;
  subtitle?: string;
  compact?: boolean;
}
// Aquí también iba una banderita peruana junto al rótulo de /nosotros/, y se
// fue por lo mismo: la razón social, el RUC y la dirección de Lima están en el
// pie, en /contacto/ y en el dato estructurado, que es donde se comprueban.
const { title, lead, subtitle, compact = false } = Astro.props;
---

<section class:list={['hero-dark relative isolate overflow-hidden px-6 text-white', compact ? 'pb-16 pt-[132px]' : 'pb-20 pt-[140px]']}>
  <div class="mx-auto w-full max-w-[1120px]">
    <h1
      class="page-h1 m-0 max-w-[18ch]"
      set:html={title}
    />
    {lead && <p class="mt-4 max-w-[560px] font-display text-[clamp(1.05rem,2.4vw,1.25rem)] font-semibold leading-[1.4] text-white" set:html={lead} />}
    {subtitle && <p class="mt-4 max-w-[540px] text-base leading-[1.65] text-[#C9CDE0]">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .page-h1 {
    font-size: clamp(2.1rem, 5.6vw, 4rem);
    font-stretch: 125%;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }
</style>
