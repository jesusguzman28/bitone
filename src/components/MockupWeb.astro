---
import Icono from './Icono.astro';
import { iconoPara } from '../data/iconos';

// Esquema de la web del rubro, dibujado con CSS.
//
// A propósito NO es una captura: no existe todavía la web de ese cliente y
// mostrar una imagen que parezca real sería inventar un trabajo entregado.
// Lo que se ve son las secciones que la landing promete un poco más abajo,
// con sus nombres reales, así que el dibujo dice la verdad y además cambia
// de rubro en rubro.

interface Props {
  emoji: string;
  titulo: string;
  /** Nombres de las secciones que tendría la web. Se usan los 4 primeros. */
  secciones: readonly string[];
  /** Ruta que se muestra en la barra del navegador. */
  ruta: string;
}
const { emoji, titulo, secciones, ruta } = Astro.props;
const visibles = secciones.slice(0, 4);
---

<div class="mockup" aria-hidden="true">
  <!-- Barra del navegador -->
  <div class="mockup__barra">
    <span class="mockup__punto" style="background:#ff5f57"></span>
    <span class="mockup__punto" style="background:#febc2e"></span>
    <span class="mockup__punto" style="background:#28c840"></span>
    <span class="mockup__url">{ruta}</span>
  </div>

  <div class="mockup__lienzo">
    <!-- Cabecera del sitio imaginado -->
    <div class="mockup__nav">
      <span class="mockup__marca">
        <span class="mockup__logo">{emoji}</span>
        <span class="mockup__barrita" style="width:46px"></span>
      </span>
      <span class="mockup__menu">
        <span class="mockup__barrita" style="width:22px"></span>
        <span class="mockup__barrita" style="width:22px"></span>
        <span class="mockup__cta"></span>
      </span>
    </div>

    <!-- Portada -->
    <div class="mockup__hero">
      <span class="mockup__h1">{titulo}</span>
      <span class="mockup__barrita" style="width:78%"></span>
      <span class="mockup__barrita" style="width:54%"></span>
      <span class="mockup__boton">Pedir por WhatsApp</span>
    </div>

    <!-- Las secciones reales del rubro -->
    <div class="mockup__grid">
      {visibles.map((s) => (
        <span class="mockup__tarjeta">
          <span class="mockup__ico">
            <Icono name={iconoPara(s)} size={13} />
          </span>
          <span class="mockup__etiqueta">{s}</span>
        </span>
      ))}
    </div>
  </div>
</div>

<style>
  .mockup {
    border-radius: 16px;
    overflow: hidden;
    background: #0b111d;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 40px 80px -40px rgba(0, 0, 0, 0.9);
    transform: perspective(1400px) rotateY(-7deg) rotateX(2deg);
    transform-origin: center left;
  }

  .mockup__barra {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    background: rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .mockup__punto { height: 8px; width: 8px; border-radius: 999px; flex: none; }
  .mockup__url {
    margin-left: 8px;
    padding: 3px 10px;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 10px;
    color: #64748b;
    background: rgba(255, 255, 255, 0.05);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mockup__lienzo { padding: 14px; background: #fff; }

  .mockup__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid #eef1f6;
  }
  .mockup__marca { display: flex; align-items: center; gap: 7px; }
  .mockup__logo {
    display: grid;
    place-items: center;
    height: 22px;
    width: 22px;
    border-radius: 7px;
    font-size: 12px;
    background: #f1f5f9;
  }
  .mockup__menu { display: flex; align-items: center; gap: 8px; }
  .mockup__barrita {
    display: block;
    height: 6px;
    border-radius: 999px;
    background: #e6e9ef;
  }
  .mockup__cta {
    height: 16px;
    width: 42px;
    border-radius: 999px;
    background: var(--gradient-brand);
  }

  .mockup__hero { display: grid; gap: 7px; padding: 16px 0 14px; }
  .mockup__h1 {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -0.02em;
  }
  .mockup__boton {
    justify-self: start;
    margin-top: 4px;
    padding: 6px 12px;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, #2bde72, #14a04f);
  }

  .mockup__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid #eef1f6;
  }
  .mockup__tarjeta {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px;
    border-radius: 10px;
    background: #f8fafc;
    box-shadow: inset 0 0 0 1px #eef1f6;
  }
  .mockup__ico {
    display: grid;
    place-items: center;
    height: 22px;
    width: 22px;
    flex: none;
    border-radius: 7px;
    color: var(--color-primary);
    background: rgba(217, 16, 35, 0.08);
  }
  .mockup__etiqueta {
    font-family: var(--font-sans);
    font-size: 9.5px;
    font-weight: 600;
    line-height: 1.25;
    color: #475569;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* En pantallas chicas se endereza: en perspectiva se lee peor y ya
     compite con el texto por el poco alto disponible. */
  @media (max-width: 1023px) {
    .mockup { transform: none; }
  }
</style>
