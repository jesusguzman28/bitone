---
// Las apps publicadas de /apps/, en filas de libro (FilaLibro, la forma de listar del
// sitio): el icono real, el nombre y para quién es, qué hace y el enlace a su ficha
// de Google Play. Fue una repisa de cinco casillas iguales; se rehízo como lista para
// no repetir el esquema de los pasos (columnas con figura arriba) ni dejar huecos.
// Solo salen las apps que se pueden abrir. De la cuarta, de uso interno, hay una
// frase debajo: sin nombre, sin icono y sin enlace (ver data/apps.ts).
// Los iconos son objetos, no módulos: conservan sus esquinas redondas. El icono
// también abre la ficha, pero el enlace con nombre (el que se enfoca y se lee) es el
// que va bajo el texto.
// Va directo dentro de una sección sobre plano tinta: trae su retícula.
import FilaLibro from '../FilaLibro.astro';
import Imagen from '../Imagen.astro';
import Icono from '../Icono.astro';
import { apps } from '../../data/proyectos';
import { app } from '../../data/apps';
import { existe, paginas, enlaceA } from '../../data/navegacion';

interface Props {
  class?: string;
}

const { class: clase, ...resto } = Astro.props;
const d = app.publicadas;
// En el orden de la página y solo las que tienen su texto escrito: si mañana se suma
// una app a data/proyectos.ts, aquí no sale a medias.
const publicadas = d.orden.flatMap((paquete) => {
  const a = apps.find((x) => x.paquete === paquete);
  return a && d.apps[paquete] ? [{ ...a, ...d.apps[paquete] }] : [];
});
---

<div class:list={['reticula', 'estante', clase]} {...resto}>
  <!-- libro--mitades: el texto de cada fila arranca en el módulo 9 y su enlace va debajo. -->
  <ul class="libro libro--mitades todo">
    {publicadas.map((a) => (
      <FilaLibro titulo={a.nombre} rotulo={a.rotulo} data-rev>
        <a slot="marca" class="estante__ico" href={a.ficha} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
          <Imagen src={a.icono} alt="" anchos={[72, 144, 216]} tamanos="72px" />
        </a>
        {a.texto}
        <a slot="fin" class="enlace menor" href={a.ficha} target="_blank" rel="noopener"><span class="solo-lector">Abrir {a.nombre} en </span>Google Play<Icono nombre="fuera" /></a>
      </FilaLibro>
    ))}
  </ul>
  {d.nota && <p class="menor estante__nota">{d.nota}</p>}
  {existe(paginas.proyectos.ruta) && (
    <a class="enlace estante__mas" href={paginas.proyectos.ruta}>{enlaceA.proyectos}<Icono nombre="derecha" /></a>
  )}
</div>

<style>
  .estante__ico { display: block; }
  .estante__ico :global(img) { display: block; width: 72px; height: 72px; border-radius: 22%; }

  /* Debajo de la lista: la frase de la cuarta a la izquierda y, en el eje de las
     notas (módulo 12), el enlace a todos los proyectos. */
  .estante__nota { grid-column: 1 / 9; align-self: center; margin-top: 12px; color: var(--texto-2); }
  .estante__mas { grid-column: 12 / -1; margin-top: 12px; }

  @media (prefers-reduced-motion: no-preference) {
    .estante__ico :global(img) { transition: transform .2s var(--salida); }
    .estante__ico:active :global(img) { transform: scale(.96); }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .estante__ico:hover :global(img) { transform: translateY(-3px); }
  }

  @media (max-width: 959px) {
    .estante__nota, .estante__mas { grid-column: 1 / -1; }
    .estante__mas { margin-top: 2px; }
  }
</style>
