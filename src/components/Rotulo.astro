---
// Rótulo: la voz "bit" del sitio. Letra de cuadrícula, mayúsculas, 12,5 px.
// Lleva delante un punto, que es un módulo en miniatura:
//   lleno (dicho) · hueco (interno o neutro) · suelto (todavía en desorden) · oro · ninguno
interface Props {
  punto?: 'lleno' | 'hueco' | 'suelto' | 'oro' | 'ninguno';
  /** Etiqueta HTML. Usa "h3" o "h2" solo si de verdad encabeza un bloque. */
  como?: 'p' | 'span' | 'h2' | 'h3' | 'dt' | 'div';
  /** Color de acento (rojo hondo sobre claro) en vez del secundario. */
  acento?: boolean;
  class?: string;
}

const { punto = 'lleno', como: Etiqueta = 'p', acento = false, class: clase, ...resto } = Astro.props;
---

<Etiqueta class:list={['rotulo', 'rot', { 'rot--acento': acento }, clase]} {...resto}>
  {punto !== 'ninguno' && <span class:list={['rot__pt', `rot__pt--${punto}`]} aria-hidden="true" />}<slot />
</Etiqueta>

<style>
  .rot { color: var(--texto-2); }
  .rot--acento { color: var(--acento); }
  .rot__pt { display: inline-block; width: .62em; height: .62em; margin-right: .75em; vertical-align: .02em; background: var(--rojo); }
  .rot__pt--hueco { background: none; box-shadow: inset 0 0 0 1.5px currentColor; }
  .rot__pt--suelto { background: none; box-shadow: inset 0 0 0 1.5px currentColor; transform: rotate(18deg); }
  .rot__pt--oro { background: var(--oro); }
  /* Sobre el campo rojo el punto rojo no se vería. */
  :global(.plano--rojo) .rot__pt--lleno { background: #fff; }
</style>
