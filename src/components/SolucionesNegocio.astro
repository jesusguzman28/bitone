---
// Bloque de enlazado interno de la portada hacia los 12 rubros.
//
// Hasta ahora la portada solo enlazaba a /, /blog, /contacto, /nosotros,
// /proyectos y /servicios: las 12 páginas de rubro quedaban huérfanas y casi
// no recibían autoridad. Este bloque las conecta directamente desde la página
// más enlazada del sitio.
//
// El anchor dice la keyword completa ("Página web para pollerías") y no "ver
// más": el texto del enlace es de las señales más fuertes que tiene Google
// para entender de qué trata el destino, y "ver más" no dice nada.
import { rubros, anchorRubro } from '../data/rubros';
import { hrefRubro } from '../data/landings';
---

<section class="surface--alt px-6 py-20" aria-labelledby="soluciones-negocio">
  <div class="mx-auto w-full max-w-[1120px]">
    <div class="reveal mx-auto max-w-[640px] text-center">
      <span class="eyebrow eyebrow--light">Por tipo de negocio</span>
      <h2
        id="soluciones-negocio"
        class="mx-auto mt-5 font-display text-[clamp(1.7rem,4vw,2.5rem)] font-extrabold leading-[1.15] text-dark"
      >
        Soluciones por <span class="gradient-text">tipo de negocio</span>
      </h2>
      {/* Sin bajada. Decía "Cada rubro tiene su propia página, con las secciones
          y funciones que ese negocio necesita de verdad. Entra al tuyo y mira
          qué incluye": tres renglones para explicar lo que la propia lista de
          abajo enseña de un vistazo, y encima con la línea de cierre repitiendo
          la misma invitación. */}
    </div>

    {/* Al quitar la bajada, el titular quedaba encima de la lista casi pegado.
        Se recupera parte de ese aire aquí para que el bloque respire igual que
        antes. */}
    <ul class="mt-12 grid list-none gap-3 p-0" style="grid-template-columns:repeat(auto-fill,minmax(280px,1fr))">
      {rubros.map((r, i) => (
        <li class="reveal" style={`--reveal-delay:${(i % 4) * 70}ms`}>
          <a href={hrefRubro(r.slug)} class="sn-card flex items-center gap-3 rounded-[16px] bg-white p-4 no-underline">
            <span class="text-[24px] leading-none" aria-hidden="true">{r.emoji}</span>
            <span class="flex-1 font-display text-[15px] font-bold leading-[1.3] text-dark">
              {anchorRubro[r.slug]}
            </span>
            <svg class="sn-arrow shrink-0 text-primary" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
              <path d="M5 12h14m-6-6 6 6-6 6"/>
            </svg>
          </a>
        </li>
      ))}
    </ul>

    <p class="reveal mt-8 text-center text-[15px] leading-[1.7] text-slate-600">
      ¿Tu rubro no está en la lista? Igual lo trabajamos:
      <a href="/servicios" class="font-semibold text-primary">mira los servicios</a> o
      <a href="/contacto" class="font-semibold text-primary">cuéntanos qué necesitas</a>.
    </p>
  </div>
</section>

<style>
  .sn-card {
    box-shadow: inset 0 0 0 1px var(--hairline), 0 1px 2px rgba(0, 0, 0, 0.05);
    transition: transform 0.45s var(--ease-fluid), box-shadow 0.45s var(--ease-fluid);
  }
  .sn-card:hover {
    transform: translateY(-3px);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-primary) 45%, transparent),
      0 20px 40px -14px rgba(217, 16, 35, 0.16);
  }
  .sn-arrow { transition: transform 0.45s var(--ease-fluid); }
  .sn-card:hover .sn-arrow { transform: translateX(3px); }

  @media (prefers-reduced-motion: reduce) {
    .sn-card, .sn-arrow { transition: none; }
  }
</style>
