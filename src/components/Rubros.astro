---
import { rubros, rubroCats, totalModulos } from '../data/rubros';
import { hrefRubro } from '../data/landings';

interface Props { variant?: 'marquee' | 'grid'; }
const { variant = 'marquee' } = Astro.props;

const loop = [...rubros, ...rubros];
const countFor = (cat: string) =>
  cat === rubroCats[0] ? rubros.length : rubros.filter((r) => r.cat === cat).length;
---

{variant === 'marquee' ? (
  <section class="surface overflow-hidden pb-[72px] pt-10">
    <p class="m-0 mb-[22px] text-center text-xs font-bold uppercase tracking-[0.2em] text-slate-400">
      Soluciones probadas para tu rubro
    </p>
    <div class="marquee-wrap relative">
      <div class="marquee flex w-max gap-3">
        {loop.map((r, i) => (
          <a
            href={hrefRubro(r.slug)}
            aria-hidden={i >= rubros.length ? 'true' : undefined}
            tabindex={i >= rubros.length ? -1 : undefined}
            class="chip-rubro inline-flex items-center gap-2 whitespace-nowrap rounded-full px-[18px] py-[9px] text-sm font-semibold text-slate-700 no-underline transition-all duration-300"
          >
            <span>{r.emoji}</span>{r.title}
          </a>
        ))}
      </div>
    </div>
  </section>
) : (
  <section id="rubros" class="surface--alt px-6 pb-24 pt-[72px]">
    <div class="mx-auto w-full max-w-[1120px]">
      <div class="reveal text-center">
        <span class="eyebrow eyebrow--light">Soluciones por rubro</span>
        <h2 class="mx-auto mt-5 max-w-[680px] font-display text-[clamp(1.7rem,4vw,2.5rem)] font-extrabold leading-[1.15] text-dark">
          No partimos de cero: tu rubro ya tiene<br /><span class="gradient-text">arquitectura probada</span>
        </h2>
        <p class="mx-auto mt-4 max-w-[560px] text-[15px] leading-[1.65] text-slate-500 [text-wrap:pretty]">
          Cada plataforma nace de módulos probados en tu sector —mobile-first, con WhatsApp integrado y pasarelas peruanas— y se adapta a tu marca.
        </p>
      </div>

      <!-- Filtro por categoría con conteo. En móvil es una sola fila que se
           desliza: apilado en tres filas ocupaba media pantalla. -->
      <div class="reveal cats-wrap mt-10">
        <div class="cats-track">
          {rubroCats.map((c, i) => (
            <button type="button" data-cat={c} class:list={['rubro-filter cat-pill', i === 0 && 'is-active']}>
              {c}
              <span class="cat-count">{countFor(c)}</span>
            </button>
          ))}
        </div>
      </div>

      <div id="rubro-grid" class="rubro-track mt-9 gap-5">
        {rubros.map((r) => (
          <a
            href={hrefRubro(r.slug)}
            class="rubro-item rubro-card flex flex-col rounded-[20px] bg-white p-6 no-underline"
            data-cat={r.cat}
          >
            <span class="text-[38px] leading-none">{r.emoji}</span>
            <h3 class="mt-4 font-display text-[20px] font-bold leading-[1.25] text-dark">{r.title}</h3>
            <p class="mt-2 text-[14.5px] leading-[1.55] text-slate-500">{r.tagline}</p>

            <div class="mt-4 flex flex-wrap gap-2">
              <span class="tag tag--time">Entrega en {r.deliveryTime}</span>
              <span class="tag tag--mods">{totalModulos(r)} módulos</span>
            </div>

            <div class="mt-5 flex items-center justify-between border-t border-dashed border-slate-200 pt-4">
              <span class="text-sm font-semibold text-primary">Ver módulos</span>
              <svg class="rubro-arrow text-primary" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

{variant === 'grid' && (
  <script>
    const btns = document.querySelectorAll<HTMLElement>('.rubro-filter');
    const items = document.querySelectorAll<HTMLElement>('.rubro-item');
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        const cat = b.dataset.cat;
        btns.forEach((x) => x.classList.remove('is-active'));
        b.classList.add('is-active');
        items.forEach((it) => {
          const show = cat === 'Todos los rubros' || it.dataset.cat === cat;
          it.style.display = show ? '' : 'none';
          if (show) {
            it.classList.remove('anim-in');
            void it.offsetWidth;
            it.classList.add('anim-in');
          }
        });
      })
    );
  </script>
)}

<style>
  /* ---- Marquee (home) ---- */
  .chip-rubro {
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--hairline), 0 4px 6px -1px rgba(0, 0, 0, 0.06);
  }
  .chip-rubro:hover { background: rgba(217, 16, 35, 0.07); color: #D91023; }

  .marquee { animation: bwMarquee 36s linear infinite; }
  .marquee-wrap {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee-wrap:hover .marquee { animation-play-state: paused; }

  /* ---- Filtro con contador ---- */
  .cat-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: none;
    cursor: pointer;
    border-radius: 999px;
    padding: 9px 14px;
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 600;
    color: #475569;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--hairline);
    transition: all 0.4s var(--ease-fluid);
  }
  .cat-pill:hover { color: var(--color-primary); }
  .cat-pill.is-active {
    color: #fff;
    background: var(--color-dark);
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.3);
  }
  .cat-count {
    display: grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    color: #64748b;
    background: #f1f5f9;
  }
  .cat-pill.is-active .cat-count { color: var(--color-dark); background: #fff; }

  /* ---- Las tarjetas siempre en grilla ---- */
  .rubro-track {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  /* ---- Las etiquetas: una sola fila deslizable en móvil ---- */
  .cats-wrap { display: flex; justify-content: center; }

  .cats-track {
    display: inline-flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 767px) {
    .cats-wrap {
      justify-content: flex-start;
      margin-inline: -24px;
      padding-inline: 24px;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      touch-action: pan-x pan-y;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent);
      mask-image: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent);
    }
    .cats-wrap::-webkit-scrollbar { display: none; }

    .cats-track {
      flex-wrap: nowrap;
      padding-block: 2px;
    }
    .cat-pill { white-space: nowrap; }
  }

  /* ---- Tarjeta de rubro ---- */
  .rubro-card {
    box-shadow: inset 0 0 0 1px var(--hairline), 0 1px 2px rgba(0, 0, 0, 0.05);
    transition: transform 0.5s var(--ease-fluid), box-shadow 0.5s var(--ease-fluid);
  }
  .rubro-card:hover {
    transform: translateY(-4px);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-primary) 45%, transparent),
      0 25px 50px -12px rgba(217, 16, 35, 0.16);
  }
  .rubro-arrow { transition: transform 0.5s var(--ease-fluid); }
  .rubro-card:hover .rubro-arrow { transform: translateX(4px); }

  .tag {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 5px 11px;
    font-size: 12px;
    font-weight: 700;
  }
  .tag--time { color: #B8820F; background: rgba(232, 163, 23, 0.14); }
  .tag--mods { color: var(--color-primary); background: rgba(217, 16, 35, 0.08); }

  @media (prefers-reduced-motion: reduce) {
    .marquee { animation: none; }
  }
</style>
