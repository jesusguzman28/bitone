---
interface Props {
  variant?: 'h' | 'v';
  alt?: string;
  class?: string;
}
const {
  variant = 'h',
  alt = 'Sitio web desarrollado por Bitwise mostrado en un iMac',
  class: className = '',
} = Astro.props;

const src = variant === 'h' ? 'imac-h' : 'imac-v';
const w = variant === 'h' ? 1280 : 720;
const h = variant === 'h' ? 720 : 1280;
const ratio = variant === 'h' ? '16 / 9' : '9 / 16';
---

<div class:list={['device-mockup', `device-mockup--${variant}`, className]} style={`aspect-ratio:${ratio}`}>
  <picture>
    <source srcset={`/mockup/${src}.webp`} type="image/webp" />
    <img
      src={`/mockup/${src}.jpg`}
      width={w}
      height={h}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="device-mockup__img"
    />
  </picture>
  <span class="device-mockup__sheen" aria-hidden="true"></span>
  <span class="device-mockup__glow" aria-hidden="true"></span>
</div>

<style>
  .device-mockup {
    position: relative;
    overflow: hidden;
    width: 100%;
    border-radius: 22px;
    box-shadow:
      0 34px 80px -34px rgba(0, 0, 0, 0.65),
      inset 0 0 0 1px rgba(255, 255, 255, 0.07);
  }

  .device-mockup__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: 46% 44%;
    animation: dm-kenburns 18s cubic-bezier(0.37, 0, 0.63, 1) infinite alternate;
  }
  .device-mockup--v .device-mockup__img {
    transform-origin: 34% 40%;
    animation-name: dm-kenburns-v;
  }
  @keyframes dm-kenburns {
    from { transform: scale(1) translate3d(0, 0, 0); }
    to   { transform: scale(1.14) translate3d(-2.2%, -1.4%, 0); }
  }
  @keyframes dm-kenburns-v {
    from { transform: scale(1) translate3d(0, 0, 0); }
    to   { transform: scale(1.16) translate3d(2%, -2.4%, 0); }
  }

  /* glass sheen — a slow highlight sweep so the screen reads as "on" */
  .device-mockup__sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: screen;
    background: linear-gradient(
      115deg,
      transparent 32%,
      rgba(255, 255, 255, 0.14) 46%,
      rgba(255, 255, 255, 0.03) 56%,
      transparent 72%
    );
    transform: translateX(-35%);
    animation: dm-sheen 11s ease-in-out infinite;
  }
  @keyframes dm-sheen {
    0%, 55% { transform: translateX(-35%); opacity: 0; }
    68%     { opacity: 1; }
    85%     { opacity: 1; }
    100%    { transform: translateX(35%); opacity: 0; }
  }

  /* soft ambient screen glow, gentle breathing */
  .device-mockup__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: screen;
    background: radial-gradient(58% 44% at 40% 40%, rgba(130, 175, 255, 0.1), transparent 70%);
    animation: dm-glow 7s ease-in-out infinite;
  }
  .device-mockup--v .device-mockup__glow {
    background: radial-gradient(52% 34% at 33% 38%, rgba(130, 175, 255, 0.1), transparent 70%);
  }
  @keyframes dm-glow {
    0%, 100% { opacity: 0.45; }
    50%      { opacity: 0.85; }
  }

  @media (prefers-reduced-motion: reduce) {
    .device-mockup__img { animation: none; transform: none; }
    .device-mockup__sheen { display: none; }
    .device-mockup__glow { animation: none; opacity: 0.5; }
  }
</style>
