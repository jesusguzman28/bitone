---
import { iconos } from '../data/iconos';

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 18, class: cls = '' } = Astro.props;
const ico = iconos[name];
---

{ico && (
  ico.brand ? (
    <svg
      width={size}
      height={size}
      viewBox={ico.vb ?? '0 0 24 24'}
      class={cls}
      aria-hidden="true"
      set:html={ico.d}
    />
  ) : (
    <svg
      width={size}
      height={size}
      viewBox={ico.vb ?? '0 0 24 24'}
      fill="none"
      stroke="currentColor"
      stroke-width="1.9"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={cls}
      aria-hidden="true"
      set:html={ico.d}
    />
  )
)}
