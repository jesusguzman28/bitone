---
import { site, nav, waLink } from '../data/site';
const year = new Date().getFullYear();

const socialItems = [
  { label: 'Facebook', href: site.socials.facebook, path: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z' },
  { label: 'Instagram', href: site.socials.instagram, path: '', stroke: true },
  { label: 'TikTok', href: site.socials.tiktok, path: 'M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z' },
  { label: 'LinkedIn', href: site.socials.linkedin, path: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V9h4v1.5A6 6 0 0 1 16 8zM2 9h4v12H2zM4 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4z' },
];
---

<footer class="px-6 pb-8 pt-16 text-slate-400" style="background:#0a0f1c">
  <div class="mx-auto grid w-full max-w-[1120px] gap-10 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <a href="/" class="inline-flex items-center gap-[9px] font-display text-xl font-bold text-white no-underline">
        <span class="grid h-[34px] w-[34px] place-items-center rounded-[11px] text-[13px] font-bold text-white" style="background:linear-gradient(135deg,#D91023,#E8A317)">/B</span>
        Bitwise
      </a>
      <p class="mt-3.5 max-w-[280px] text-sm leading-relaxed">
        Páginas web, tiendas online y sistemas a medida para MYPEs peruanas.
      </p>
      <div class="mt-[18px] flex gap-2.5">
        {socialItems.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener"
            aria-label={s.label}
            class="social-dot grid h-9 w-9 place-items-center rounded-full text-slate-300 no-underline transition-all duration-300"
            style="background:rgba(255,255,255,0.06);box-shadow:inset 0 0 0 1px rgba(255,255,255,0.12)"
          >
            {s.stroke ? (
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
              </svg>
            ) : (
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path}/></svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <div>
      <h4 class="m-0 mb-3.5 font-display text-[13px] font-bold uppercase tracking-[0.14em] text-slate-200">Navegación</h4>
      <ul class="m-0 grid list-none gap-[9px] p-0 text-sm">
        {nav.map((item) => (
          <li><a href={item.href} class="text-slate-400 no-underline transition-colors duration-300 hover:text-white">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="m-0 mb-3.5 font-display text-[13px] font-bold uppercase tracking-[0.14em] text-slate-200">Contacto</h4>
      <ul class="m-0 grid list-none gap-[11px] p-0 text-sm">
        <li class="flex items-center gap-[9px]">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg>
          <a href={waLink()} target="_blank" rel="noopener" class="text-slate-200 no-underline hover:text-white">{site.phone}</a>
        </li>
        <li class="flex items-center gap-[9px]">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#E8A317" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          <a href={`mailto:${site.email}`} class="text-slate-200 no-underline hover:text-white">{site.email}</a>
        </li>
        <li class="flex items-center gap-[9px]">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#D91023" stroke-width="2" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          {site.city}
        </li>
        {/* El RUC, si está cargado. Va en el pie y no escondido en una página
            legal: es la prueba de las cinco veces que el sitio dice "empresa
            formal con RUC", y quien desconfía lo busca justamente aquí abajo. */}
        {site.ruc && (
          <li class="flex items-center gap-[9px]">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2bde72" stroke-width="2" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4M8 13h8M8 17h5"/></svg>
            RUC {site.ruc}
          </li>
        )}
        <li class="flex items-center gap-[9px]">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          {site.hours}
        </li>
      </ul>
    </div>
  </div>

  <div class="mx-auto mt-12 flex w-full max-w-[1120px] flex-wrap justify-between gap-3 border-t border-white/10 pt-6 text-[13px] text-slate-500">
    <span>© {year} {site.legalName} · Hecho en Lima 🇵🇪</span>
  </div>
</footer>

<style>
  .social-dot:hover {
    background: rgba(217, 16, 35, 0.25) !important;
    color: #fff;
  }
</style>
