---
import { marcas } from '../data/site';

// Los logotipos dibujados se declaran UNA vez como <symbol> y luego se
// referencian con <use>: así podemos repetir la pista muchas veces sin
// multiplicar el peso del HTML.
const simbolos = marcas
  .map((m, i) => {
    if (!m.svg) return null;
    const vb = m.svg.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 100 100';
    const body = m.svg.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
    return { id: `marca-${i}`, vb, body };
  })
  .filter(Boolean) as { id: string; vb: string; body: string }[];

const simboloDe = (i: number) => simbolos.find((s) => s.id === `marca-${i}`);

// Cada mitad de la pista repite el set 3 veces. La animación desplaza -50%,
// o sea una mitad completa: al llegar al final, la segunda mitad ya está en
// la misma posición y el bucle no muestra huecos ni en pantallas anchas.
const REPETICIONES = 6;
const pista = Array.from({ length: REPETICIONES }, () => marcas).flat();
---

<!-- Va pegado al hero (también oscuro): la línea superior evita que se fundan -->
<section class="section-dark relative isolate overflow-hidden border-t border-white/10 px-0 py-16">
  <div class="pointer-events-none absolute -left-24 top-0 h-72 w-72 rounded-full opacity-25 blur-[80px]" style="background:radial-gradient(circle,#D91023,transparent 70%)"></div>
  <div class="pointer-events-none absolute -right-24 bottom-0 h-72 w-72 rounded-full opacity-20 blur-[80px]" style="background:radial-gradient(circle,#E8A317,transparent 70%)"></div>

  <!-- Definiciones: no se dibujan, solo se referencian -->
  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <defs>
      {simbolos.map((s) => <symbol id={s.id} viewBox={s.vb} set:html={s.body} />)}
    </defs>
  </svg>

  <p class="relative m-0 px-6 text-center text-[11px] font-bold uppercase tracking-[0.24em] text-slate-500">
    Software que construimos y está en producción
  </p>

  <div class="mb-wrap relative mt-9">
    <div class="mb-track flex w-max items-center gap-[clamp(40px,7vw,80px)]">
      {pista.map((m, idx) => {
        const i = idx % marcas.length;
        const primeraVuelta = idx < marcas.length;
        const sim = simboloDe(i);
        const inner = sim ? (
          <svg class:list={['mb-mark', m.wide ? 'h-14 w-[150px] sm:h-16 sm:w-[172px]' : 'h-16 w-16 sm:h-[68px] sm:w-[68px]']} viewBox={sim.vb} role="img" aria-label={primeraVuelta ? m.name : undefined} aria-hidden={primeraVuelta ? undefined : 'true'}>
            <use href={`#${sim.id}`} />
          </svg>
        ) : m.logo ? (
          /* La pista repite el set 6 veces. Solo la primera vuelta describe el
             logo; las copias van con alt="" y aria-hidden para no repetir el
             mismo nombre 6 veces en el lector de pantalla.
             Van como dos ramas y no como alt={cond ? x : ''} porque Astro
             renderiza el string vacío como un atributo `alt` suelto, sin valor,
             y los auditores lo cuentan como imagen sin alt. */
          primeraVuelta ? (
            <img src={m.logo} alt={m.alt} width="48" height="48" loading="lazy" decoding="async" class="mb-mark h-12 w-12 rounded-[12px] object-cover" />
          ) : (
            <img src={m.logo} alt="" aria-hidden="true" width="48" height="48" loading="lazy" decoding="async" class="mb-mark h-12 w-12 rounded-[12px] object-cover" />
          )
        ) : (
          <>
            {m.name}
            {m.dot && <span class="text-accent">.</span>}
          </>
        );
        const cls = sim || m.logo
          ? 'mb-item inline-flex'
          : 'mb-item whitespace-nowrap font-display text-[clamp(1.3rem,2.6vw,1.9rem)] font-bold';
        return m.link && primeraVuelta ? (
          <a href={m.link} target="_blank" rel="noopener" class:list={[cls, 'no-underline']} style={m.style}>{inner}</a>
        ) : (
          <span class:list={[cls]} style={m.style} aria-hidden={primeraVuelta ? undefined : 'true'}>{inner}</span>
        );
      })}
    </div>
  </div>
</section>

<style>
  .mb-wrap {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  /* La duración escala con el largo de la pista para que la velocidad
     percibida no cambie al añadir repeticiones. */
  .mb-track { animation: bwMarquee 90s linear infinite; }
  .mb-wrap:hover .mb-track { animation-play-state: paused; }

  .mb-item {
    color: rgba(255, 255, 255, 0.45);
    transition: color 0.4s var(--ease-fluid);
  }
  .mb-item:hover { color: #fff; }

  /* Los logotipos dibujados heredan currentColor; la imagen va en gris hasta el hover */
  .mb-mark {
    display: block;
    opacity: 0.55;
    transition: opacity 0.4s var(--ease-fluid), filter 0.4s var(--ease-fluid);
  }
  .mb-item img.mb-mark { filter: grayscale(1); }
  .mb-item:hover .mb-mark { opacity: 1; filter: grayscale(0); }

  @media (prefers-reduced-motion: reduce) {
    .mb-track { animation: none; flex-wrap: wrap; justify-content: center; width: auto; }
  }
</style>
