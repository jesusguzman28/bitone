---
import { site, formulario } from '../data/site';

interface Props {
  /** Contexto que se añade al mensaje de WhatsApp (ej. el rubro). */
  context?: string;
  title?: string;
  subtitle?: string;
  id?: string;
}
const {
  context = '',
  title = 'Escríbenos y te respondemos hoy',
  subtitle = 'Déjanos tus datos y tu pregunta — se abre WhatsApp con el mensaje listo.',
  id = 'contact-form',
} = Astro.props;
---

<div
  class="reveal panel-dark rounded-[28px] p-[clamp(24px,4vw,36px)] text-white"
  style="box-shadow:0 30px 60px -30px rgba(14,21,33,0.7)"
>
  <h2 class="m-0 font-display text-xl font-bold">{title}</h2>
  <p class="mt-2 text-[13.5px] leading-[1.6] text-slate-400">{subtitle}</p>

  <form id={id} class="mt-6 grid gap-3.5" data-context={context}>
    <div>
      <label for={`${id}-nombre`} class="mb-2 block text-xs font-bold uppercase tracking-[0.06em] text-slate-400">Nombre</label>
      <input id={`${id}-nombre`} name="nombre" class="field" type="text" required placeholder="Tu nombre" />
    </div>

    <div>
      <label for={`${id}-celular`} class="mb-2 block text-xs font-bold uppercase tracking-[0.06em] text-slate-400">Celular</label>
      <input
        id={`${id}-celular`}
        name="celular"
        class="field"
        type="tel"
        required
        inputmode="numeric"
        pattern="[0-9\s+]{6,15}"
        placeholder="999 888 777"
      />
    </div>

    <div>
      <label for={`${id}-pregunta`} class="mb-2 block text-xs font-bold uppercase tracking-[0.06em] text-slate-400">Tu pregunta</label>
      <textarea id={`${id}-pregunta`} name="pregunta" class="field resize-y" rows="3" required placeholder="¿Qué necesitas para tu negocio?"></textarea>
    </div>

    <button type="submit" class="btn btn--whatsapp group mt-2 justify-self-start !py-3 !pl-[26px] !text-[15px]">
      Enviar por WhatsApp
      <span class="btn__icon" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
      </span>
    </button>
  </form>
</div>

<script define:vars={{ waBase: `https://wa.me/${site.whatsapp}`, formId: id, endpoint: formulario.endpoint, accessKey: formulario.accessKey }}>
  const form = document.getElementById(formId);
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const nombre = String(data.get('nombre') || '').trim();
    const celular = String(data.get('celular') || '').trim();
    const pregunta = String(data.get('pregunta') || '').trim();
    const context = form.dataset.context;

    const parts = [`Hola BIT-ONE, soy ${nombre}.`];
    if (context) parts.push(`Tengo ${context}.`);
    if (pregunta) parts.push(pregunta);
    if (celular) parts.push(`Mi celular: ${celular}.`);
    const mensaje = parts.join(' ');

    // Copia por correo, si hay dónde mandarla. Va ANTES de abrir WhatsApp y sin
    // esperar respuesta: si el envío falla o tarda, el visitante no se entera y
    // WhatsApp se abre igual. Nunca se le bloquea el camino por el respaldo.
    //
    // `keepalive` es lo que hace que la petición sobreviva aunque el navegador
    // cambie de pestaña al abrir WhatsApp; sin eso, la mitad de los envíos se
    // cortarían a medio camino.
    if (endpoint) {
      const cuerpo = { nombre, celular, pregunta, contexto: context || '', pagina: location.pathname, mensaje };
      if (accessKey) cuerpo.access_key = accessKey;
      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(cuerpo),
        keepalive: true,
      }).catch(() => {
        // Silencio a propósito: el visitante ya se fue a WhatsApp y avisarle de
        // un fallo del respaldo solo lo asustaría. El contacto no se pierde.
      });
    }

    window.open(`${waBase}?text=${encodeURIComponent(mensaje)}`, '_blank', 'noopener');
  });
</script>
