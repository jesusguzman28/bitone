---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Stars from '../components/Stars.astro';
import CTA from '../components/CTA.astro';
import { site, waLink, serviciosTabs } from '../data/site';
import { rubros, soles } from '../data/rubros';
import { hrefRubro } from '../data/landings';

const url = `${site.domain}/cuanto-cuesta-una-pagina-web-en-peru/`;

// El piso de precio sale de los mismos datos que alimentan el resto del sitio:
// si mañana cambia, cambia aquí, en el Offer y en el llms.txt a la vez.
const web = serviciosTabs.find((t) => t.id === 'web')!;
const tienda = serviciosTabs.find((t) => t.id === 'tienda')!;
const rubroMasBarato = [...rubros].sort((a, b) => a.startingPrice - b.startingPrice)[0];

// Rangos de mercado. Son tramos cualitativos de lo que se cotiza en Perú, no
// precios de competidores concretos: nombrar cifras ajenas sería inventarlas.
const tramos = [
  {
    rango: 'S/300 – S/800',
    tipo: 'Plantilla armada por un freelance',
    detalle:
      'Una plantilla comprada y rellenada con tus textos. Sirve para existir, no para vender. Normalmente sin dominio propio, sin panel para editar y sin nadie que responda cuando algo falla.',
    ojo: 'Suele excluir dominio, hosting y correo: gastos que aparecen después.',
  },
  {
    rango: 'S/1,500 – S/3,000',
    tipo: 'Página web profesional a medida',
    detalle:
      'Diseño propio, panel administrable, optimización para Google y todo el paquete de arranque incluido. Es el tramo donde se ubica una web que realmente trae clientes a una MYPE.',
    ojo: 'Aquí está nuestra página web profesional, desde S/1,500 + IGV.',
    destacado: true,
  },
  {
    rango: 'S/3,000 – S/7,000',
    tipo: 'Tienda online con cobros',
    detalle:
      'Catálogo con stock, carrito, pasarelas peruanas y facturación electrónica. El precio sube según cuántos módulos necesites y qué tan complejo sea tu catálogo.',
    ojo: 'Nuestra tienda online arranca en S/3,000.',
  },
  {
    rango: 'Desde S/7,000',
    tipo: 'Sistemas a medida y ERPs',
    detalle:
      'Software hecho para tu operación: ventas, inventario, reportes, integraciones con SUNAT o billeteras. No se cotiza por página sino por alcance.',
    ojo: 'Se define en una reunión: no hay precio de lista honesto para esto.',
  },
];

const incluido = [
  'Diseño propio, no una plantilla rellenada',
  'Dominio .com por el primer año',
  'Hosting por el primer año',
  'Certificado de seguridad (el candado del navegador)',
  'Correo corporativo con tu dominio',
  'Panel para que edites textos, fotos y precios sin depender de nosotros',
  'Optimización básica para Google y analítica',
  'WhatsApp flotante y formulario de contacto',
  'Capacitación grabada y 30 días de garantía',
];

const noIncluido = [
  'Redacción de textos largos o sesión de fotos profesional',
  'Inversión en publicidad pagada',
  'Renovación de dominio y hosting a partir del segundo año',
  'Módulos que sumes después del alcance acordado',
];

const faqs = [
  {
    q: '¿Cuánto cuesta una página web en Perú en 2026?',
    a: 'Una plantilla básica se cotiza entre S/300 y S/800, una página web profesional a medida entre S/1,500 y S/3,000, y una tienda online con cobros desde S/3,000. En Bitwise la página web profesional arranca en S/1,500 + IGV con dominio, hosting, SSL y correo corporativo incluidos el primer año.',
  },
  {
    q: '¿Hacen páginas web baratas?',
    a: 'Hacemos páginas web económicas, que no es lo mismo. No competimos con los S/300 de una plantilla, porque a ese precio algo se está omitiendo: casi siempre el dominio, el hosting o el soporte cuando la web se cae. Nuestro piso es S/1,500 + IGV y ahí entra todo lo necesario para que la web funcione un año sin que pagues nada extra.',
  },
  {
    q: '¿Qué diferencia hay entre una web de S/500 y una de S/1,500?',
    a: 'La de S/500 suele ser una plantilla con tus textos: carga lenta, no la puedes editar y no está preparada para aparecer en Google. La de S/1,500 tiene diseño propio, panel administrable, velocidad optimizada y estructura pensada para posicionar. La diferencia se nota el día que buscas tu negocio en Google y no apareces.',
  },
  {
    q: '¿Se puede pagar en partes?',
    a: 'Sí. Trabajamos con 50% de adelanto y 50% contra entrega. En proyectos grandes se puede dividir hasta en 3 cuotas sin interés. Aceptamos Yape, Plin, transferencia y tarjeta, y emitimos boleta o factura electrónica SUNAT en cada pago.',
  },
  {
    q: '¿El precio incluye IGV?',
    a: 'No. Los S/1,500 son sin IGV. Lo decimos claro desde el inicio para que no aparezca una sorpresa en la cotización final. Somos empresa formal con RUC y emitimos comprobante electrónico.',
  },
  {
    q: '¿El dominio y el código quedan a mi nombre?',
    a: 'Sí, al 100%. El dominio se registra con tus datos y el código fuente es tuyo desde el primer día. Si mañana quieres migrar a otra agencia, te entregamos los accesos completos sin condiciones.',
  },
  {
    q: '¿Cuánto demora tener la web lista?',
    a: `Una página web profesional toma ${web.time} desde que apruebas el diseño. Una tienda online, ${tienda.time}. El proyecto más rápido que hemos entregado fue de 7 días, con el contenido ya listo por parte del cliente.`,
  },
  {
    q: '¿Trabajan fuera de Lima?',
    a: 'Sí. Atendemos MYPEs en todo el Perú de forma 100% remota, por Zoom y WhatsApp. Mismo precio y mismo plazo sin importar la ciudad: no cobramos extra por ubicación.',
  },
];

const schema = [
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@type': 'Service',
    '@id': `${url}#servicio`,
    name: 'Página web profesional para MYPEs en Perú',
    serviceType: 'Diseño y desarrollo de páginas web',
    description:
      'Página web a medida con dominio, hosting, certificado de seguridad y correo corporativo incluidos el primer año.',
    provider: { '@id': `${site.domain}/#org` },
    areaServed: { '@type': 'Country', name: 'Perú' },
    offers: {
      '@type': 'Offer',
      priceCurrency: 'PEN',
      price: '1500',
      priceSpecification: {
        '@type': 'PriceSpecification',
        priceCurrency: 'PEN',
        minPrice: '1500',
        valueAddedTaxIncluded: false,
      },
      availability: 'https://schema.org/InStock',
      url,
    },
  },
];
---

<BaseLayout
  title="¿Cuánto cuesta una página web en Perú? Precios reales 2026"
  description="Precios reales en soles: plantilla desde S/300, página web profesional desde S/1,500 + IGV y tienda online desde S/3,000. Qué incluye cada rango y qué te van a cobrar aparte."
  breadcrumbLabel="Cuánto cuesta una página web"
  schema={schema}
>
  <!-- Hero -->
  <section class="hero-dark relative isolate overflow-hidden px-6 pb-20 pt-[140px] text-white">
    <Stars />
    <div class="mx-auto w-full max-w-[900px]">
      <span class="eyebrow eyebrow--dark">Precios 2026</span>

      <h1 class="mt-5 max-w-[820px] font-display text-[clamp(2rem,5.5vw,3.25rem)] font-extrabold leading-[1.08]">
        ¿Cuánto cuesta una página web en Perú?
      </h1>

      <!-- Respuesta directa y arriba: es lo que cita un buscador con IA cuando
           alguien pregunta el precio, y lo que lee quien llega desde Google. -->
      <p class="mt-6 max-w-[680px] text-[17px] leading-[1.7] text-slate-200">
        En 2026 una <strong class="text-white">plantilla básica</strong> se cotiza entre
        <strong class="text-white">S/300 y S/800</strong>; una
        <strong class="text-white">página web profesional a medida</strong>, entre
        <strong class="text-white">S/1,500 y S/3,000</strong>; y una
        <strong class="text-white">tienda online con cobros</strong>, desde
        <strong class="text-white">S/3,000</strong>.
      </p>
      <p class="mt-4 max-w-[680px] text-[16px] leading-[1.7] text-slate-400">
        En Bitwise la página web profesional arranca en <strong class="text-accent">S/1,500 + IGV</strong>,
        con dominio, hosting, certificado de seguridad y correo corporativo incluidos el primer año.
        Abajo está el desglose de cada rango y lo que suele quedar fuera de la cotización.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={waLink('Hola Bitwise 👋 quiero saber cuánto costaría la página web de mi negocio')} target="_blank" rel="noopener" class="btn btn--whatsapp group !py-3 !pl-[26px] !text-[15px]">
          Pedir cotización gratis
          <span class="btn__icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </span>
        </a>
        <a href="#tramos" class="btn btn--on-dark !px-[26px] !py-3 !text-[15px]">Ver los rangos</a>
      </div>
    </div>
  </section>

  <!-- Tramos de precio -->
  <section id="tramos" class="surface scroll-mt-24 px-6 py-20">
    <div class="mx-auto w-full max-w-[880px]">
      <h2 class="reveal font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
        Los cuatro rangos de precio en el mercado peruano
      </h2>
      <p class="reveal mt-5 text-[16.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">
        La pregunta no tiene una sola respuesta porque «página web» significa cosas muy distintas.
        Estos son los tramos en los que se mueve una cotización en Perú y qué recibes en cada uno.
      </p>

      <div class="mt-10 grid gap-4">
        {tramos.map((t) => (
          <article class:list={['reveal tramo rounded-[20px] bg-white p-6 sm:p-7', t.destacado && 'tramo--nuestro']}>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="m-0 font-display text-[1.35rem] font-extrabold text-dark [font-variant-numeric:tabular-nums]">{t.rango}</h3>
              <span class="text-[13px] font-bold uppercase tracking-[0.1em] text-slate-500">{t.tipo}</span>
            </div>
            <p class="mt-3 text-[15.5px] leading-[1.7] text-slate-600 [text-wrap:pretty]">{t.detalle}</p>
            <p class:list={['mt-3 text-[14px] leading-[1.6]', t.destacado ? 'font-semibold text-primary' : 'text-slate-500']}>
              {t.ojo}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Qué entra y qué no -->
  <section class="surface--alt px-6 py-20">
    <div class="mx-auto w-full max-w-[1120px]">
      <div class="reveal mx-auto max-w-[760px]">
        <h2 class="font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
          Qué debería incluir el precio (y qué te van a cobrar aparte)
        </h2>
        <p class="mt-5 text-[16.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">
          La diferencia entre dos cotizaciones casi nunca está en el diseño: está en lo que una
          incluye y la otra deja fuera. Pide siempre esta lista por escrito antes de firmar.
        </p>
      </div>

      <div class="mt-10 grid gap-6" style="grid-template-columns:repeat(auto-fit,minmax(320px,1fr))">
        <div class="reveal card rounded-[20px] bg-white p-7">
          <h3 class="m-0 font-display text-[17px] font-bold text-dark">Incluido en nuestros S/1,500</h3>
          <ul class="m-0 mt-4 grid list-none gap-2.5 p-0 text-[14.5px] text-slate-600">
            {incluido.map((t) => (
              <li class="flex items-start gap-2.5">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="3" stroke-linecap="round" class="mt-1 shrink-0" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                {t}
              </li>
            ))}
          </ul>
        </div>

        <div class="reveal card rounded-[20px] bg-white p-7" style="--reveal-delay:120ms">
          <h3 class="m-0 font-display text-[17px] font-bold text-dark">Se cotiza aparte</h3>
          <ul class="m-0 mt-4 grid list-none gap-2.5 p-0 text-[14.5px] text-slate-600">
            {noIncluido.map((t) => (
              <li class="flex items-start gap-2.5">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" class="mt-1 shrink-0" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                {t}
              </li>
            ))}
          </ul>
          <p class="mt-4 text-[13.5px] leading-[1.6] text-slate-500">
            Lo decimos antes de empezar. Una cotización que no menciona nada de esto suele
            terminar costando más que una que sí lo hace.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Páginas web económicas -->
  <section class="surface px-6 py-20">
    <div class="mx-auto w-full max-w-[880px]">
      <h2 class="reveal font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
        ¿Existen las páginas web económicas de verdad?
      </h2>
      <div class="mt-6 grid gap-5">
        <p class="reveal m-0 text-[16.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">
          Sí, pero conviene separar «económico» de «barato». Barato es pagar S/300 por una
          plantilla que no puedes editar, que no aparece en Google y que nadie mantiene cuando
          se cae. Económico es pagar un precio justo por algo que funciona y que no te obliga a
          rehacerlo en seis meses.
        </p>
        <p class="reveal m-0 text-[16.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">
          Nuestro piso es <strong class="text-dark">S/1,500 + IGV</strong> y ahí ya entra el
          primer año completo de dominio, hosting, certificado de seguridad y correo. Si al
          comparar cotizaciones sumas esos costos que otras dejan fuera, la diferencia real
          entre una web de S/800 y una de S/1,500 se acorta bastante.
        </p>
        <p class="reveal m-0 text-[16.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">
          Para negocios que recién arrancan, el camino más barato de verdad es empezar por
          módulos: una web con lo esencial y sumar funciones cuando el negocio las pida. El
          rubro con el arranque más bajo hoy es{' '}
          <a href="/paginas-web-para-bodegas" class="font-semibold text-primary">bodegas y minimarkets</a>,
          desde {soles(rubroMasBarato.startingPrice)}.
        </p>
      </div>
    </div>
  </section>

  <!-- Precio por rubro -->
  <section class="surface--alt px-6 py-20">
    <div class="mx-auto w-full max-w-[1120px]">
      <div class="reveal mx-auto max-w-[760px]">
        <h2 class="font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
          Cuánto cuesta según tu tipo de negocio
        </h2>
        <p class="mt-5 text-[16.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">
          El precio cambia con lo que tu rubro necesita: una pollería necesita carta y pedidos,
          una ferretería un catálogo de miles de productos. Estos son los pisos por rubro, cada
          uno con su página y su detalle.
        </p>
      </div>

      <div class="mt-10 grid gap-3" style="grid-template-columns:repeat(auto-fill,minmax(300px,1fr))">
        {[...rubros].sort((a, b) => a.startingPrice - b.startingPrice).map((r) => (
          <a href={hrefRubro(r.slug)} class="precio-rubro flex items-center gap-3 rounded-[16px] bg-white p-4 no-underline">
            <span class="text-[22px] leading-none" aria-hidden="true">{r.emoji}</span>
            <span class="flex-1 font-display text-[14.5px] font-bold leading-[1.3] text-dark">{r.title}</span>
            <span class="font-display text-[14px] font-bold text-primary [font-variant-numeric:tabular-nums]">{soles(r.startingPrice)}</span>
          </a>
        ))}
      </div>
      <p class="reveal mt-6 text-center text-[14px] text-slate-500">
        Todos los precios son el punto de partida, sin IGV, y se ajustan según los módulos que elijas.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="surface px-6 py-20">
    <div class="mx-auto w-full max-w-[760px]">
      <h2 class="reveal font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
        Preguntas frecuentes sobre precios
      </h2>

      <div class="mt-8 grid gap-3">
        {faqs.map((f) => (
          <details class="lp-faq reveal rounded-[16px] bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between gap-4 font-display text-[16px] font-bold text-dark">
              {f.q}
              <svg class="lp-faq__ico shrink-0 text-primary" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <p class="mt-3 text-[15px] leading-[1.7] text-slate-600 [text-wrap:pretty]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Formulario -->
  <section id="formulario" class="surface--alt scroll-mt-24 px-6 py-20">
    <div class="mx-auto grid w-full max-w-[1120px] items-start gap-9" style="grid-template-columns:repeat(auto-fit,minmax(300px,1fr))">
      <ContactForm
        id="precio-form"
        title="¿Cuánto costaría la tuya?"
        subtitle="Déjanos tu nombre, celular y qué necesitas. Te mandamos una cotización por escrito en menos de 24 horas."
      />

      <div class="reveal card rounded-[20px] bg-white p-6">
        <h2 class="m-0 font-display text-base font-bold text-dark">Cómo cotizamos</h2>
        <ul class="m-0 mt-3 grid list-none gap-2.5 p-0 text-[14px] text-slate-600">
          {[
            'Conversamos 15 minutos para entender tu negocio',
            'Te enviamos la propuesta por escrito, en soles y con el alcance detallado',
            '50% de adelanto para arrancar, 50% contra entrega',
            'Hasta 3 cuotas sin interés en proyectos grandes',
            'Boleta o factura electrónica SUNAT en cada pago',
          ].map((t) => (
            <li class="flex items-start gap-2.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="3" stroke-linecap="round" class="mt-1 shrink-0" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
              {t}
            </li>
          ))}
        </ul>
        <p class="mt-4 text-[13.5px] leading-[1.6] text-slate-500">
          ¿Quieres el detalle de cada servicio? Está en
          <a href="/servicios" class="font-semibold text-primary">servicios y precios</a>.
        </p>
      </div>
    </div>
  </section>

  <CTA
    title="Pide tu cotización sin compromiso"
    subtitle="Te respondemos en menos de 2 horas hábiles, en soles y con el alcance por escrito."
  />
</BaseLayout>

<style>
  .tramo {
    box-shadow: inset 0 0 0 1px var(--hairline);
    transition: box-shadow 0.4s var(--ease-fluid), transform 0.4s var(--ease-fluid);
  }
  .tramo:hover {
    transform: translateY(-2px);
    box-shadow: inset 0 0 0 1px var(--hairline-strong), 0 14px 30px -14px rgba(0, 0, 0, 0.12);
  }
  /* El tramo en el que estamos: se distingue sin gritar */
  .tramo--nuestro {
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--color-primary) 45%, transparent),
      0 14px 30px -14px rgba(217, 16, 35, 0.16);
  }

  .precio-rubro {
    box-shadow: inset 0 0 0 1px var(--hairline);
    transition: box-shadow 0.4s var(--ease-fluid), transform 0.4s var(--ease-fluid);
  }
  .precio-rubro:hover {
    transform: translateY(-2px);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-primary) 45%, transparent),
      0 14px 30px -12px rgba(217, 16, 35, 0.16);
  }

  .lp-faq {
    box-shadow: inset 0 0 0 1px var(--hairline);
    transition: box-shadow 0.4s var(--ease-fluid);
  }
  .lp-faq:hover { box-shadow: inset 0 0 0 1px var(--hairline-strong); }
  .lp-faq summary::-webkit-details-marker { display: none; }
  .lp-faq summary { list-style: none; }
  .lp-faq__ico { transition: transform 0.4s var(--ease-fluid); }
  .lp-faq[open] .lp-faq__ico { transform: rotate(45deg); }

  @media (prefers-reduced-motion: reduce) {
    .tramo, .precio-rubro, .lp-faq__ico { transition: none; }
  }
</style>
