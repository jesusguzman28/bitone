---
// Para tu negocio: el mismo servicio (un sistema a medida) contado en cuatro rubros, con
// las palabras de cada dueño. No son cuatro productos.
// Orden: la portada · elige tu negocio, con los dos cuadros enlazados, los otros rubros y
// la prueba que se abre (tinta) · lo que no cambia de un rubro a otro (rojo) · cuándo no
// conviene · preguntas · cierre.
// Ninguna sección repite el esquema de la anterior: banda de opciones y dos cuadros en
// diagonal, titular con cuatro columnas, una frase con su nota, título y preguntas.
// El peso mayor es de "Elige tu negocio": es lo único que solo tiene esta página, y en
// escritorio va a cartel menor. El campo rojo repite lo de todo el sitio: va a título.
// El dinero vive en /como-trabajamos/: aquí el precio se nombra una vez, en el campo rojo.
import Base from '../layouts/Base.astro';
import PortadaInterior from '../components/PortadaInterior.astro';
import EligeNegocio from '../components/negocios/EligeNegocio.astro';
import Cifras from '../components/Cifras.astro';
import Franqueza from '../components/Franqueza.astro';
import Dudas from '../components/Dudas.astro';
import CierreWhatsApp from '../components/CierreWhatsApp.astro';
import Icono from '../components/Icono.astro';
import ListaApps from '../components/ListaApps.astro';
import { mensajes, enlaceWhatsApp } from '../data/empresa';
import { paginas, existe, destino } from '../data/navegacion';
import { porNegocio } from '../data/servicios';
import { apps } from '../data/proyectos';
import { rubros, negocios as d } from '../data/negocios';

const pagina = paginas.negocios;
// La prueba de la página: la app con la que un negocio recibe y despacha, con su icono
// real y su ficha de Google Play (data/proyectos.ts) y la frase que lleva aquí.
const appDePrueba = apps.filter((a) => a.paquete === d.prueba.app.paquete).map((a) => ({ ...a, frase: d.prueba.app.frase }));
---

<Base
  titulo="Sistemas para distribuidora, ferretería, restaurante y bodega"
  descripcion="Cómo queda un sistema a medida en una distribuidora, una ferretería, un restaurante y una bodega. Y cuándo te basta un programa ya hecho."
  signo={pagina.signo}
  mensajeWhatsApp={mensajes.sistema}
>
  <PortadaInterior signo={pagina.signo} tonoDeAbajo="tinta" tono={porNegocio.tono} rotulo={pagina.nombre} titulo={d.portada.titulo} entrada={d.portada.entrada} mensaje={mensajes.sistema} textoBoton={d.portada.boton} />

  <!-- 1 · Elige tu negocio: la frase del dueño, lo que cambia y su botón.
       La cabeza es la de TituloSeccion (título a la izquierda, nota en el módulo 12), escrita
       aquí porque su título es el más grande de la página: va a cartel menor, en un renglón
       de once módulos. -->
  <section class="seccion plano plano--tinta elige" id="rubros" aria-labelledby="t-rubros">
    <header class="reticula elige__cab">
      <h2 class="titulo titulo--mayor elige__t" id="t-rubros">{d.elige.titulo}</h2>
      <p class="entrada elige__e">{d.elige.entrada}</p>
    </header>
    <EligeNegocio rubros={rubros} leyenda={d.elige.leyenda} rotulos={d.elige.rotulos} />

    <!-- Dos renglones, no otra sección: los rubros que no están entre los cuatro y la
         prueba, que se abre en /proyectos/ -->
    <ul class="mas">
      <li class="reticula mas__f">
        <p class="mas__txt"><strong class="destacado">{d.otros.pregunta}</strong> {d.otros.texto}</p>
        <a class="enlace mas__ir" href={enlaceWhatsApp(d.otros.mensaje)} target="_blank" rel="noopener">{d.otros.enlace}<span class="solo-lector"> (abre WhatsApp)</span><Icono nombre="fuera" /></a>
      </li>
      <li class="reticula mas__f mas__f--prueba">
        <p class="mas__txt"><strong class="destacado">{d.prueba.pregunta}</strong> {d.prueba.texto}</p>
        <!-- Lo que se nombra se enseña: la app real, con su ficha, y debajo el camino a los demás -->
        <div class="mas__ver">
          {appDePrueba.length > 0 && <ListaApps apps={appDePrueba} class="mas__app" />}
          <a class="enlace" href={destino(paginas.proyectos)}>{d.prueba.enlace}<Icono nombre="derecha" /></a>
        </div>
      </li>
    </ul>
  </section>

  <!-- 2 · Lo que no cambia. Aquí se nombra el precio, una sola vez -->
  <section class="seccion plano plano--rojo trato" aria-labelledby="t-trato">
    <div class="reticula trato__r">
      <h2 class="titulo trato__t" id="t-trato">{d.trato.titulo.map((r, i) => <><span class="renglon">{r}</span>{i < d.trato.titulo.length - 1 && ' '}</>)}</h2>
      <Cifras cifras={d.trato.condiciones} class="trato__cifras" data-rev />
      {existe(paginas.comoTrabajamos.ruta) && (
        <a class="enlace trato__ir" href={paginas.comoTrabajamos.ruta}>{d.trato.enlace}<Icono nombre="derecha" /></a>
      )}
    </div>
  </section>

  <!-- 3 · Cuándo no conviene -->
  <section class="seccion" aria-labelledby="t-franca">
    <Franqueza id="t-franca" titulo={d.franca.titulo} texto={d.franca.texto}>
      {existe(paginas.sistemas.ruta) && (
        <a class="enlace todo franca__ir" href={paginas.sistemas.ruta}>{d.franca.enlace}<Icono nombre="derecha" /></a>
      )}
    </Franqueza>
  </section>

  <Dudas titulo="Lo que pregunta todo negocio." preguntas={d.dudas} grupo="negocios" />

  <CierreWhatsApp interes={d.portada.interes} ejemplo={d.portada.ejemplo} general={mensajes.sistema} />
</Base>

<style>
  /* ---------- 1 · elige tu negocio ---------- */
  /* La cabeza: el título a la izquierda y la nota en el módulo 12, asentada en su renglón. */
  .elige__cab { align-items: end; padding-bottom: var(--aire-corto); }
  .elige__t { grid-column: 1 / 12; }
  .elige__e { grid-column: 12 / -1; padding-bottom: .2em; }
  /* El titular más grande de la página: en escritorio sube a cartel menor
     (.titulo--mayor). Son 17 letras: caben en un renglón de once módulos. */
  @media (min-width: 960px) {
    .elige__t { white-space: nowrap; }
  }

  /* Los dos renglones bajo los cuadros, cada uno con su filete: la frase a la izquierda y
     el enlace en el módulo 9, el eje del cuadro del sistema. */
  .mas { margin-top: calc(var(--u) * .8); }
  .mas__f { align-items: center; padding-block: calc(var(--u) * .3); border-top: 1px solid var(--filete); }
  .mas__f:last-child { padding-bottom: 0; }
  .mas__txt { grid-column: 1 / 8; color: var(--texto-2); text-wrap: pretty; }
  .mas__txt strong { margin-right: .35em; color: var(--texto); }
  .mas__ir { grid-column: 9 / -1; justify-self: start; }
  /* El renglón de la prueba: en el módulo 9, la app que se puede abrir y, debajo, el
     enlace a todos los proyectos. La frase se asienta arriba, a la altura de la app. */
  .mas__f--prueba { align-items: start; }
  .mas__ver { grid-column: 9 / -1; display: grid; justify-items: start; row-gap: 4px; }
  .mas__ver :global(.mas__app) { justify-self: stretch; }

  /* ---------- 2 · lo que no cambia ---------- */
  .trato__r { align-items: end; row-gap: var(--aire-corto); }
  .trato__t { grid-column: 1 / 11; grid-row: 1; }
  /* Las condiciones, sobre la retícula: Cifras ya pone cada columna en su módulo (1, 5,
     9 y 13), de dos en dos en tableta y en filas en celular. */
  .trato :global(.trato__cifras) { grid-column: 1 / -1; grid-row: 2; }
  /* El enlace va bajo las cuatro condiciones. Con ancho de sobra es una nota lateral: en
     el módulo 12, asentada en el segundo renglón del titular. */
  .trato__ir { grid-column: 1 / -1; grid-row: 3; justify-self: start; margin-top: calc(var(--u) * -.4); }
  @media (min-width: 1280px) {
    .trato__ir { grid-column: 12 / -1; grid-row: 1; margin-top: 0; margin-bottom: -6px; }
  }

  /* ---------- 3 · cuándo no conviene ---------- */
  .franca__ir { margin-top: clamp(10px, calc(var(--u) * .2), 18px); }

  @media (max-width: 959px) {
    .elige__t, .elige__e { grid-column: 1 / -1; }
    .elige__e { margin-top: 18px; padding-bottom: 0; }

    .mas__txt, .mas__ir, .mas__ver { grid-column: 1 / -1; }
    .mas__ir { margin-top: 4px; }
    .mas__ver { margin-top: 12px; }

    .trato__t { grid-column: 1 / -1; }
    .trato__ir { margin-top: calc(var(--u) * -.2); }
  }
  @media (max-width: 699px) {
    .elige__e { margin-top: 14px; }

    .mas { margin-top: 26px; }
    .mas__f { padding-block: 16px 8px; }
    .mas__f:last-child { padding-bottom: 0; }

    .trato__r { row-gap: 18px; }
    .trato__ir { margin-top: -8px; }
    .franca__ir { margin-top: 4px; }
  }
</style>
