      de ser una llamada a la acción y pasa a ser ruido.

      Se queda el formulario, que además deja el contacto por escrito, y el botón
      flotante de WhatsApp sigue disponible en toda la página. */}
</BaseLayout>

<script>
  // Tarjetas del problema: los botones mueven el carril y los puntos marcan en
  // cuál se está. El carril es scroll nativo, así que en el celular también se
  // pasa deslizando con el dedo sin que este código intervenga.
  const track = document.querySelector<HTMLElement>('[data-fc-track]');
  if (track) {
    const cards = Array.from(track.children) as HTMLElement[];
    const dotsWrap = document.querySelector<HTMLElement>('[data-fc-dots]')!;
    const prev = document.querySelector<HTMLButtonElement>('[data-fc-prev]')!;
    const next = document.querySelector<HTMLButtonElement>('[data-fc-next]')!;

    const dots = cards.map((_, i) => {
      const d = document.createElement('span');
      d.className = 'fc-dot' + (i === 0 ? ' is-on' : '');
      dotsWrap.append(d);
      return d;
    });

    // La tarjeta activa se deduce del desplazamiento real del carril, no de un
    // contador propio: así deslizar con el dedo y usar los botones no se
    // desincronizan nunca.
    const actual = () => {
      const paso = cards[0].offsetWidth + 14; // ancho + gap
      return Math.min(cards.length - 1, Math.round(track.scrollLeft / paso));
    };

    // El índice vive en una variable y no se deduce del scroll al hacer clic:
    // dos clics rápidos leerían el desplazamiento a mitad de la animación y el
    // segundo repetiría la misma tarjeta.
    let idx = 0;

    const pintar = () => {
      dots.forEach((d, di) => d.classList.toggle('is-on', di === idx));
      prev.toggleAttribute('disabled', idx === 0);
      next.toggleAttribute('disabled', idx === cards.length - 1);
    };

    const irA = (i: number) => {
      idx = Math.max(0, Math.min(cards.length - 1, i));
      track.scrollTo({ left: idx * (cards[0].offsetWidth + 14), behavior: 'smooth' });
      pintar();
    };

    prev.addEventListener('click', () => irA(idx - 1));
    next.addEventListener('click', () => irA(idx + 1));
    // Al deslizar con el dedo, el índice se recalcula del scroll real
    track.addEventListener('scroll', () => { idx = actual(); pintar(); }, { passive: true });
    pintar();
  }

  // Volteo de cada flashcard. El 3D se enciende solo mientras dura el giro y
  // se apaga al terminar, para que el texto vuelva a dibujarse nítido; y al
  // apagarlo se corta la transición un instante, porque quitar la clase con la
  // transición viva animaba un segundo giro de regreso.
  document.querySelectorAll<HTMLElement>('[data-fc-flip]').forEach((flip) => {
    const inner = flip.querySelector<HTMLElement>('.fc-inner')!;
    const [frente, dorso] = Array.from(flip.querySelectorAll<HTMLElement>('.fc-face'));
    let limpieza = 0;

    const apagar3D = () => {
      clearTimeout(limpieza);
      inner.style.transition = 'none';
      flip.classList.remove('is-animating');
      void inner.offsetWidth;
      inner.style.transition = '';
    };
    inner.addEventListener('transitionend', (e) => {
      if (e.propertyName === 'transform') apagar3D();
    });

    flip.querySelectorAll<HTMLElement>('[data-fc-voltear]').forEach((btn) =>
      btn.addEventListener('click', () => {
        clearTimeout(limpieza);
        // Fija el punto de partida sin animarlo antes del giro real
        inner.style.transition = 'none';
        flip.classList.add('is-animating');
        void inner.offsetWidth;
        inner.style.transition = '';

        const alDorso = !flip.classList.contains('is-flipped');
        flip.classList.toggle('is-flipped', alDorso);
        // La cara oculta queda inerte: sin foco ni clics fantasma
        frente.toggleAttribute('inert', alDorso);
        dorso.toggleAttribute('inert', !alDorso);
        // Red de seguridad si transitionend no llega (reduced motion, pestaña oculta)
        limpieza = window.setTimeout(apagar3D, 900);
      })
    );
  });
</script>

<style>
  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 12px;
    padding: 10px 16px;
    font-size: 14px;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
  }
  .hero-chip :global(svg) { color: #94a3b8; }

  /* ---- Foto de ambiente del rubro: banda ancha ----
     La proporción panorámica reserva el alto antes de cargar y muestra la
     escena entera; la versión en columna la recortaba raro. */
  .foto-rubro {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    aspect-ratio: 21 / 9;
    box-shadow:
      inset 0 0 0 1px var(--hairline),
      0 30px 60px -35px rgba(15, 23, 42, 0.45);
  }
  /* Velo de marca: iguala doce fotos de fuentes distintas para que la página
     no parezca un collage de stock. */
  .foto-rubro::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--color-primary) 14%, transparent),
      transparent 55%
    );
    pointer-events: none;
  }
  .foto-rubro picture { display: block; height: 100%; }

  @media (max-width: 767px) {
    .foto-rubro { aspect-ratio: 16 / 10; }
  }

  /* ---- Tarjetas del problema (pregunta y respuesta) ----
     Carril horizontal con imán por tarjeta: se pasa con los botones o
     deslizando con el dedo. La siguiente asoma por el borde como invitación. */
  .fc-track {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    /* overflow-x:auto fuerza el eje Y a auto y aparece un scroll vertical
       fantasma de 1-2px: se apaga explícito. */
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    touch-action: pan-x pan-y;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    padding: 2px;
  }
  .fc-track::-webkit-scrollbar { display: none; }

  .fc-flip {
    flex: none;
    width: calc(100% - 44px); /* deja asomar la siguiente */
    scroll-snap-align: start;
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .fc-flip { width: 62%; }
  }
  /* En escritorio caben las tres a la vez: el carril se vuelve grilla y la
     navegación de móvil se oculta (lg:hidden en el HTML). */
  @media (min-width: 1024px) {
    .fc-track {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      overflow: visible;
    }
    .fc-flip { width: auto; }
  }

  /* Las dos caras comparten celda: la altura la marca la más alta y la
     tarjeta no salta al voltear. */
  .fc-inner {
    display: grid;
    height: 100%;
    transition: transform 0.7s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .fc-face {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    padding: 24px;
  }
  .fc-front { box-shadow: inset 0 0 0 1px var(--hairline), 0 1px 2px rgba(0, 0, 0, 0.05); }
  .fc-back {
    color: #fff;
    background: linear-gradient(160deg, #131c2e, #0b111d);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1), 0 20px 40px -25px rgba(14, 21, 33, 0.7);
  }

  /* El 3D vive solo mientras dura el giro: en reposo el navegador dibuja el
     texto como texto y no como una textura reescalada (lo que pixelaba otras
     tarjetas en el celular). En reposo solo se decide qué cara se ve. */
  .fc-flip:not(.is-animating) .fc-back { visibility: hidden; }
  .fc-flip.is-flipped:not(.is-animating) .fc-front { visibility: hidden; }
  .fc-flip.is-flipped:not(.is-animating) .fc-back { visibility: visible; }

  .fc-flip.is-animating { perspective: 1400px; }
  .fc-flip.is-animating .fc-inner { transform-style: preserve-3d; }
  .fc-flip.is-animating .fc-face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .fc-flip.is-animating .fc-back { transform: rotateY(180deg); }
  .fc-flip.is-animating.is-flipped .fc-inner { transform: rotateY(180deg); }

  /* Botón que voltea la tarjeta */
  .fc-voltear {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: none;
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-primary);
  }
  .fc-voltear--claro { color: var(--color-accent); }
  .fc-voltear__ico {
    display: grid;
    place-items: center;
    height: 26px;
    width: 26px;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 12%, transparent);
    transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .fc-voltear:hover .fc-voltear__ico { transform: rotate(-180deg); }

  /* Desplegable con el texto completo */
  .fc-detalle {
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .fc-detalle summary::-webkit-details-marker { display: none; }
  .fc-detalle__ico { transition: transform 0.4s var(--ease-fluid); }
  .fc-detalle[open] .fc-detalle__ico { transform: rotate(180deg); }

  .fc-num {
    display: grid;
    place-items: center;
    height: 34px;
    min-width: 34px;
    flex: none;
    border-radius: 10px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 9%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-primary) 18%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .fc-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 0;
    cursor: pointer;
    border-radius: 999px;
    padding: 10px 14px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    color: #475569;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--hairline);
    transition: all 0.35s var(--ease-fluid);
  }
  .fc-btn:hover { color: var(--color-primary); }
  .fc-btn--primario {
    padding-inline: 20px;
    color: #fff;
    background: var(--gradient-brand);
    box-shadow: 0 10px 25px -5px rgba(217, 16, 35, 0.4);
  }
  .fc-btn--primario:hover { color: #fff; filter: brightness(1.06); }
  .fc-btn[disabled] { opacity: 0.35; pointer-events: none; }

  .fc-dot {
    height: 7px;
    width: 7px;
    border-radius: 999px;
    background: #cbd5e1;
    transition: all 0.35s var(--ease-fluid);
  }
  .fc-dot.is-on { width: 22px; background: var(--color-primary); }

  /* ---- El problema ---- */
  .prob-ico {
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 9%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-primary) 18%, transparent);
  }
  /* ---- Chips del bloque de precio ---- */
  .precio-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
    color: #475569;
    background: #f8fafc;
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .precio-chip :global(svg) { color: var(--color-primary); }

  /* ---- Viñetas ----
     Una lista en columnas que se recorre de un vistazo. El icono va delante y
     del mismo tamaño en todas para que la vista baje en línea recta; en cuanto
     los iconos bailan de tamaño, la lista deja de leerse como lista. */
  .vinetas { grid-template-columns: 1fr; }
  @media (min-width: 640px) { .vinetas { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .vinetas { grid-template-columns: repeat(3, 1fr); } }

  .vineta {
    display: flex;
    align-items: center;
    gap: 11px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    color: #334155;
  }
  .vineta__ico,
  .vineta__emoji {
    display: grid;
    place-items: center;
    height: 34px;
    width: 34px;
    flex: none;
    border-radius: 11px;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 9%, transparent);
    transition: transform 0.4s var(--ease-fluid);
  }
  .vineta__ico--acento {
    color: #16a34a;
    background: rgba(22, 163, 74, 0.11);
  }
  .vineta__emoji {
    font-size: 17px;
    background: #f1f5f9;
  }
  .vineta:hover .vineta__ico,
  .vineta:hover .vineta__emoji { transform: scale(1.1); }

  /* ---- Desplegable con el texto largo ----
     Lo visible son las viñetas; el detalle de cada punto vive aquí dentro,
     cerrado. Google lo lee porque está en el HTML, y quien navega no paga
     scroll por un texto que no iba a leer. */
  .detalle-plegado {
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .detalle-plegado summary {
    display: flex;
    cursor: pointer;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    font-family: var(--font-display);
    font-size: 14.5px;
    font-weight: 700;
    color: var(--color-dark);
  }
  .detalle-plegado summary::-webkit-details-marker { display: none; }
  .detalle-plegado__ico {
    flex: none;
    color: var(--color-primary);
    transition: transform 0.4s var(--ease-fluid);
  }
  .detalle-plegado[open] .detalle-plegado__ico { transform: rotate(180deg); }

  @media (prefers-reduced-motion: reduce) {
    .vineta__ico, .vineta__emoji, .detalle-plegado__ico { transition: none; }
    .fc-inner, .fc-voltear__ico, .fc-detalle__ico { transition: none; }
  }

  /* Las preguntas van en <details>: el contenido queda en el HTML servido, así
     que Google lo indexa aunque esté plegado en pantalla. */
  .lp-faq {
    box-shadow: inset 0 0 0 1px var(--hairline);
    transition: box-shadow 0.4s var(--ease-fluid);
  }
  .lp-faq:hover { box-shadow: inset 0 0 0 1px var(--hairline-strong); }
  .lp-faq summary::-webkit-details-marker { display: none; }
  .lp-faq summary { list-style: none; }
  .lp-faq__ico { transition: transform 0.4s var(--ease-fluid); }
  .lp-faq[open] .lp-faq__ico { transform: rotate(45deg); }

  @media (prefers-reduced-motion: reduce) {
    .lp-faq__ico { transition: none; }
  }
</style>
