---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Stars from '../components/Stars.astro';
import CTA from '../components/CTA.astro';
import Icono from '../components/Icono.astro';
import MockupWeb from '../components/MockupWeb.astro';
import { landings, rubroDeLanding, hrefRubro, type Landing } from '../data/landings';
import { rubros, soles, totalModulos, afinesRubro, anchorRubro } from '../data/rubros';
import { iconoPara } from '../data/iconos';
import { fotoDeRubro } from '../data/fotos';
import { preguntasProblema } from '../data/preguntasProblema';
import { site, waLink } from '../data/site';

export function getStaticPaths() {
  return landings.map((landing) => ({ params: { rubro: landing.param }, props: { landing } }));
}

interface Props { landing: Landing }
const { landing } = Astro.props;

const rubro = rubroDeLanding(landing);
const url = `${site.domain}/paginas-web-para-${landing.param}/`;

// Si un rubro nuevo todavía no tiene foto, la sección cae al layout de una
// columna en vez de dejar un hueco.
const foto = fotoDeRubro(landing.param);

// Preguntas de cabecera de las tarjetas del problema, en el mismo orden que
// los párrafos. Si el rubro aún no las tiene, la tarjeta usa un rótulo neutro.
const preguntas = preguntasProblema[landing.param] ?? [];

const afines = (afinesRubro[rubro.slug] ?? [])
  .map((slug) => rubros.find((r) => r.slug === slug))
  .filter((r): r is (typeof rubros)[number] => Boolean(r));

// El precio y el plazo salen de rubros.ts, la misma fuente que alimenta el
// texto visible del bloque "Precio y plazo". Así el Offer no puede decir una
// cosa mientras la página dice otra.
const schema = [
  {
    '@type': 'Service',
    '@id': `${url}#servicio`,
    name: landing.h1,
    serviceType: rubro.keyword,
    description: landing.metaDescription,
    provider: { '@id': `${site.domain}/#org` },
    areaServed: { '@type': 'Country', name: 'Perú' },
    offers: {
      '@type': 'Offer',
      priceCurrency: 'PEN',
      price: String(rubro.startingPrice),
      priceSpecification: {
        '@type': 'PriceSpecification',
        priceCurrency: 'PEN',
        minPrice: String(rubro.startingPrice),
        valueAddedTaxIncluded: false,
      },
      availability: 'https://schema.org/InStock',
      url,
    },
  },
  {
    // Preguntas propias de este rubro. No se solapan con el FAQPage de la
    // portada, que responde dudas generales de contratación.
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: landing.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const modulos = totalModulos(rubro);

const waMsg = `Hola Bitwise 👋 quiero cotizar una página web para mi ${rubro.short}`;
---

<BaseLayout
  title={landing.metaTitle}
  description={landing.metaDescription}
  breadcrumbLabel={landing.breadcrumb}
  schema={schema}
>
  <!-- Hero: texto a la izquierda, esquema de la web a la derecha -->
  <section class="hero-dark relative isolate overflow-hidden px-6 pb-20 pt-[140px] text-white">
    <Stars />
    <div class="mx-auto grid w-full max-w-[1120px] items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <nav aria-label="Ruta" class="mb-8 text-[13px] text-slate-400">
          <a href="/proyectos" class="text-slate-400 no-underline transition-colors hover:text-white">Proyectos</a>
          <span class="mx-2 text-slate-600">/</span>
          <span class="text-slate-300">{landing.breadcrumb}</span>
        </nav>

        <span class="eyebrow eyebrow--dark">
          <span class="text-[15px] leading-none" aria-hidden="true">{rubro.emoji}</span>
          {landing.eyebrow}
        </span>

        <h1 class="mt-5 font-display text-[clamp(2rem,5vw,3rem)] font-extrabold leading-[1.08]">
          {landing.h1}
        </h1>
        <p class="mt-5 max-w-[560px] text-[17px] leading-[1.65] text-slate-300">{landing.intro}</p>

        <div class="mt-7 flex flex-wrap gap-3">
          <span class="hero-chip">
            <Icono name="etiqueta" size={15} />
            Desde <strong class="text-accent">{soles(rubro.startingPrice)} + IGV</strong>
          </span>
          <span class="hero-chip">
            <Icono name="reloj" size={15} />
            Entrega en <strong class="text-accent">{rubro.deliveryTime}</strong>
          </span>
          <span class="hero-chip">
            <Icono name="www" size={15} />
            Dominio y hosting <strong class="text-accent">incluidos</strong>
          </span>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={waLink(waMsg)} target="_blank" rel="noopener" class="btn btn--whatsapp group !py-3 !pl-[26px] !text-[15px]">
            Cotizar por WhatsApp
            <span class="btn__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
            </span>
          </a>
          <a href="#formulario" class="btn btn--on-dark !px-[26px] !py-3 !text-[15px]">Formulario de contacto</a>
        </div>
      </div>

      <MockupWeb
        emoji={rubro.emoji}
        titulo={landing.secciones.items[0]?.title ?? rubro.title}
        secciones={landing.secciones.items.map((s) => s.title)}
        ruta={`tu-${rubro.short.replace(/\s+/g, '')}.com`}
      />
    </div>
  </section>

  <!-- 1. El problema, como tarjetas de pregunta y respuesta -->
  <section class="surface px-6 py-20">
    <div class="mx-auto w-full max-w-[960px]">
      <div class="reveal flex items-start gap-4">
        <span class="prob-ico grid h-12 w-12 flex-none place-items-center rounded-[14px]">
          <Icono name="campanaAlerta" size={22} />
        </span>
        <h2 class="m-0 pt-1 font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
          {landing.problema.title}
        </h2>
      </div>

      {foto && (
        // Banda ancha en vez de columna lateral: la escena se ve completa sin
        // pelear altura con el texto. Es ambiente del rubro, no un trabajo
        // entregado por nosotros.
        <figure class="reveal foto-rubro m-0 mt-8">
          <picture>
            <source media="(max-width: 1023px)" srcset={`/rubros/${landing.param}-sm.webp`} width="560" height="380" />
            <img
              src={`/rubros/${landing.param}.webp`}
              width="880"
              height="600"
              alt={foto.alt}
              loading="lazy"
              decoding="async"
              class="block h-full w-full object-cover"
            />
          </picture>
        </figure>
      )}

      <!-- Una tarjeta por idea: pregunta arriba, respuesta abajo, y se pasa a
           la siguiente con el botón o deslizando. Todo el texto está en el
           HTML desde el inicio: para Google no hay nada oculto. -->
      <div class="reveal mt-8">
        <div class="fc-track" data-fc-track>
          {landing.problema.parrafos.map((p, i) => (
            <article class="fc-card rounded-[20px] bg-white">
              <header class="flex items-start gap-3.5">
                <span class="fc-num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="m-0 pt-1.5 font-display text-[17.5px] font-extrabold leading-[1.3] text-dark [text-wrap:balance]">
                  {preguntas[i] ?? `El problema, parte ${i + 1}`}
                </h3>
              </header>
              <p class="m-0 mt-4 text-[15.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">{p}</p>
            </article>
          ))}
        </div>

        <div class="mt-5 flex items-center justify-between gap-4">
          <div class="flex gap-2" data-fc-dots aria-hidden="true"></div>
          <div class="flex gap-2">
            <button type="button" data-fc-prev aria-label="Tarjeta anterior" class="fc-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M19 12H5m6 6-6-6 6-6"/></svg>
            </button>
            <button type="button" data-fc-next aria-label="Siguiente tarjeta" class="fc-btn fc-btn--primario">
              Siguiente
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Qué secciones necesita -->
  <section class="surface--alt px-6 py-20">
    <div class="mx-auto w-full max-w-[1120px]">
      <div class="reveal mx-auto max-w-[760px]">
        <h2 class="font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
          {landing.secciones.title}
        </h2>
        <p class="mt-5 text-[16.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">{landing.secciones.intro}</p>
      </div>

      <ol class="mt-10 grid list-none gap-4 p-0" style="grid-template-columns:repeat(auto-fill,minmax(320px,1fr))">
        {landing.secciones.items.map((s, i) => (
          <li class="reveal seccion-card rounded-[20px] bg-white p-6" style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <div class="flex items-center justify-between">
              <span class="seccion-ico grid h-11 w-11 place-items-center rounded-[13px]">
                <Icono name={iconoPara(s.title)} size={20} />
              </span>
              {/* El número en insignia: en gris claro sobre blanco directamente
                  no se veía. */}
              <span class="seccion-num">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="mt-4 font-display text-[17px] font-bold leading-[1.3] text-dark">{s.title}</h3>
            {/* El texto completo queda en el HTML (es contenido que indexa);
                visualmente se recorta a cuatro líneas para que la grilla
                respire y las tarjetas midan parecido. */}
            <p class="seccion-desc mt-2 text-[13.5px] leading-[1.6] text-slate-500">{s.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3. Funcionalidades del rubro -->
  <section class="surface px-6 py-20">
    <div class="mx-auto w-full max-w-[1120px]">
      <div class="reveal mx-auto max-w-[760px]">
        <h2 class="font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
          {landing.funciones.title}
        </h2>
        <p class="mt-5 text-[16.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">{landing.funciones.intro}</p>
      </div>

      <div class="mt-10 grid gap-4" style="grid-template-columns:repeat(auto-fill,minmax(320px,1fr))">
        {landing.funciones.items.map((f, i) => (
          <div class="reveal func-card rounded-[20px] bg-white p-6" style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <div class="flex items-start gap-3.5">
              {/* Icono según lo que hace la función: antes las seis tarjetas
                  llevaban el mismo check verde y no se distinguían de un vistazo. */}
              <span class="func-ico grid h-11 w-11 flex-none place-items-center rounded-[13px]">
                <Icono name={iconoPara(f.title)} size={20} />
              </span>
              <h3 class="m-0 pt-2 font-display text-[17px] font-bold leading-[1.3] text-dark">{f.title}</h3>
            </div>
            <p class="mt-3 text-[14.5px] leading-[1.65] text-slate-500">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Precio y plazo -->
  <section class="surface--alt px-6 py-20">
    <div class="mx-auto w-full max-w-[760px]">
      <h2 class="reveal font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
        {landing.precio.title}
      </h2>

      <div class="reveal mt-7 rounded-[20px] bg-white p-6" style="box-shadow:inset 0 0 0 1px var(--hairline)">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">Desde</span>
          <span class="font-display text-[2rem] font-extrabold text-dark [font-variant-numeric:tabular-nums]">{soles(rubro.startingPrice)}</span>
          <span class="text-[14px] text-slate-500">+ IGV</span>
        </div>

        {/* Lo que ese precio ya trae, de un vistazo y con su icono. El detalle
            en texto sigue abajo: esto es el resumen, no el reemplazo. */}
        <div class="mt-5 flex flex-wrap gap-2.5 border-t border-dashed border-slate-200 pt-5">
          {[
            { icono: 'reloj', texto: `Entrega en ${rubro.deliveryTime}` },
            { icono: 'www', texto: 'Dominio y hosting 1 año' },
            { icono: 'candado', texto: 'Certificado de seguridad' },
            { icono: 'tarjeta', texto: '50% inicio · 50% entrega' },
          ].map((c) => (
            <span class="precio-chip">
              <Icono name={c.icono} size={15} />
              {c.texto}
            </span>
          ))}
        </div>
      </div>

      <div class="mt-6 grid gap-5">
        {landing.precio.parrafos.map((p) => (
          <p class="reveal m-0 text-[16.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">{p}</p>
        ))}
      </div>

      <p class="reveal mt-6 text-[15px] leading-[1.7] text-slate-600">
        Puedes ver el detalle completo de lo que incluye cada servicio en
        <a href="/servicios" class="font-semibold text-primary">nuestra página de servicios</a>, o
        <a href="/contacto" class="font-semibold text-primary">escribirnos por el formulario</a>
        para recibir una cotización por escrito en 24 horas.
      </p>
    </div>
  </section>

  <!-- 4a. Por qué Bitwise. Solo condiciones reales que ya están publicadas en
       el resto del sitio (pago, garantía, entrega): nada de clientes ni cifras
       inventadas. Panel oscuro para que se distinga del bloque de precio. -->
  <section class="surface--alt px-6 pb-20">
    <div class="reveal panel-dark mx-auto w-full max-w-[1120px] overflow-hidden rounded-[28px] p-8 text-white sm:p-10" style="box-shadow:0 30px 60px -30px rgba(14,21,33,0.55)">
      <span class="eyebrow eyebrow--dark">Por qué elegir Bitwise</span>
      <h2 class="mt-4 max-w-[560px] font-display text-[clamp(1.4rem,3vw,1.9rem)] font-extrabold leading-[1.2]">
        Condiciones claras antes de empezar, no sobre la marcha
      </h2>

      <div class="mt-8 grid gap-4" style="grid-template-columns:repeat(auto-fill,minmax(300px,1fr))">
        {[
          { icono: 'documento', titulo: 'Cotización cerrada por escrito', desc: 'El alcance y el precio quedan en un documento antes de arrancar. Lo que no está ahí, no se cobra después.' },
          { icono: 'tarjeta', titulo: 'Pagas en dos partes', desc: '50% para empezar y 50% contra entrega, con boleta o factura SUNAT en cada pago. Hasta 3 cuotas sin interés en proyectos grandes.' },
          { icono: 'reloj', titulo: `Entrega en ${rubro.deliveryTime}`, desc: 'El plazo corre desde que apruebas el diseño, y lo conoces antes de dar el adelanto.' },
          { icono: 'candado', titulo: 'El dominio y el código son tuyos', desc: 'Todo queda registrado a tu nombre. Si mañana trabajas con otra empresa, te llevas tu web completa.' },
          { icono: 'escudo', titulo: '30 días de garantía', desc: 'Después de la entrega, cualquier error se corrige sin costo. El soporte va por WhatsApp, sin mesa de ayuda.' },
          { icono: 'tablero', titulo: 'No dependes de nosotros', desc: 'Panel administrable y capacitación grabada: tus textos, fotos y precios los cambias tú, cuando quieras.' },
        ].map((v, i) => (
          <div class="porque-item rounded-[18px] p-5" style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <span class="porque-ico grid h-11 w-11 place-items-center rounded-[13px]">
              <Icono name={v.icono} size={20} />
            </span>
            <h3 class="mt-4 font-display text-[15.5px] font-bold leading-[1.3] text-white">{v.titulo}</h3>
            <p class="mt-2 text-[13.5px] leading-[1.6] text-slate-400">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4b. Catálogo de módulos.
       Va justo después del precio porque ahí se dice que varias funciones "se
       suman como módulos": esta sección es la que responde cuáles. -->
  <section class="surface px-6 py-20">
    <div class="mx-auto w-full max-w-[1120px]">
      <div class="reveal mx-auto max-w-[760px]">
        <h2 class="font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
          Los {modulos} módulos que puedes sumar
        </h2>
        <p class="mt-5 text-[16.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">
          Tu {rubro.short} arranca con lo esencial y crece por partes. Estos son todos los
          módulos disponibles, agrupados por lo que resuelven; se cotizan solo los que elijas.
        </p>
      </div>

      {rubro.moduleGroups.map((group) => (
        <div class="mt-11">
          <h3 class="reveal flex items-center gap-3 font-display text-[14px] font-bold uppercase tracking-[0.12em] text-slate-500">
            <span class="h-px w-8 bg-primary"></span>
            {group.name}
          </h3>
          <div class="mt-5 grid gap-4" style="grid-template-columns:repeat(auto-fill,minmax(280px,1fr))">
            {group.modules.map((m, i) => (
              <div class="reveal card card--lift rounded-[20px] p-6" style={`--reveal-delay:${(i % 3) * 90}ms`}>
                <span class="text-[24px] leading-none">{m.emoji}</span>
                <h4 class="mt-3 font-display text-[16px] font-bold leading-[1.3] text-dark">{m.title}</h4>
                <p class="mt-2 text-[13.5px] leading-[1.6] text-slate-500">{m.desc}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 5. Preguntas frecuentes del rubro -->
  <section class="surface--alt px-6 py-20">
    <div class="mx-auto w-full max-w-[760px]">
      <h2 class="reveal font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
        Preguntas frecuentes
      </h2>

      <div class="mt-8 grid gap-3">
        {landing.faqs.map((f) => (
          <details class="lp-faq reveal rounded-[16px] bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between gap-4 font-display text-[16px] font-bold text-dark">
              {f.q}
              <svg class="lp-faq__ico shrink-0 text-primary" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <p class="mt-3 text-[15px] leading-[1.7] text-slate-600 [text-wrap:pretty]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Formulario + rubros afines -->
  <section id="formulario" class="surface scroll-mt-24 px-6 py-20">
    <div class="mx-auto grid w-full max-w-[1120px] items-start gap-9" style="grid-template-columns:repeat(auto-fit,minmax(300px,1fr))">
      <ContactForm
        id="landing-form"
        context={`una ${rubro.short}`}
        title={`¿Hablamos de tu ${rubro.short}?`}
        subtitle="Déjanos tu nombre, celular y tu pregunta. Te respondemos en menos de 2 horas hábiles."
      />

      <div class="grid gap-4">
        <div class="reveal card rounded-[20px] bg-white p-6">
          <h2 class="m-0 font-display text-base font-bold text-dark">Lo que incluye tu proyecto</h2>
          <ul class="m-0 mt-3 grid list-none gap-2.5 p-0 text-[14px] text-slate-600">
            {[
              `Entrega en ${rubro.deliveryTime} desde la aprobación del diseño`,
              'Dominio, hosting y certificado de seguridad el primer año',
              'Panel administrable y capacitación grabada',
              '50% de adelanto y 50% contra entrega, con factura SUNAT',
              '30 días de garantía y soporte por WhatsApp',
            ].map((t) => (
              <li class="flex items-start gap-2.5">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="3" stroke-linecap="round" class="mt-1 shrink-0"><path d="m5 13 4 4L19 7"/></svg>
                {t}
              </li>
            ))}
          </ul>
        </div>

        {afines.length > 0 && (
          <div class="reveal card rounded-[20px] bg-white p-6" style="--reveal-delay:120ms">
            <h2 class="m-0 font-display text-base font-bold text-dark">También trabajamos estos rubros</h2>
            <ul class="m-0 mt-3 grid list-none gap-2 p-0 text-[14px]">
              {afines.map((o) => (
                <li>
                  <a href={hrefRubro(o.slug)} class="inline-flex items-center gap-2 font-semibold text-primary no-underline">
                    <span>{o.emoji}</span>{anchorRubro[o.slug]}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                  </a>
                </li>
              ))}
              <li>
                <a href="/proyectos" class="inline-flex items-center gap-2 font-semibold text-slate-600 no-underline">
                  Ver los 12 rubros
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                </a>
              </li>
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <CTA
    title={`¿Listo para tener la web de tu ${rubro.short}?`}
    subtitle="Cotización gratis en menos de 24 horas, en soles y con facilidades de pago. Sin compromiso."
  />
</BaseLayout>

<script>
  // Tarjetas del problema: los botones mueven el carril y los puntos marcan en
  // cuál se está. El carril es scroll nativo, así que en el celular también se
  // pasa deslizando con el dedo sin que este código intervenga.
  const track = document.querySelector<HTMLElement>('[data-fc-track]');
  if (track) {
    const cards = Array.from(track.children) as HTMLElement[];
    const dotsWrap = document.querySelector<HTMLElement>('[data-fc-dots]')!;
    const prev = document.querySelector<HTMLButtonElement>('[data-fc-prev]')!;
    const next = document.querySelector<HTMLButtonElement>('[data-fc-next]')!;

    const dots = cards.map((_, i) => {
      const d = document.createElement('span');
      d.className = 'fc-dot' + (i === 0 ? ' is-on' : '');
      dotsWrap.append(d);
      return d;
    });

    // La tarjeta activa se deduce del desplazamiento real del carril, no de un
    // contador propio: así deslizar con el dedo y usar los botones no se
    // desincronizan nunca.
    const actual = () => {
      const paso = cards[0].offsetWidth + 14; // ancho + gap
      return Math.min(cards.length - 1, Math.round(track.scrollLeft / paso));
    };

    // El índice vive en una variable y no se deduce del scroll al hacer clic:
    // dos clics rápidos leerían el desplazamiento a mitad de la animación y el
    // segundo repetiría la misma tarjeta.
    let idx = 0;

    const pintar = () => {
      dots.forEach((d, di) => d.classList.toggle('is-on', di === idx));
      prev.toggleAttribute('disabled', idx === 0);
      next.toggleAttribute('disabled', idx === cards.length - 1);
    };

    const irA = (i: number) => {
      idx = Math.max(0, Math.min(cards.length - 1, i));
      track.scrollTo({ left: idx * (cards[0].offsetWidth + 14), behavior: 'smooth' });
      pintar();
    };

    prev.addEventListener('click', () => irA(idx - 1));
    next.addEventListener('click', () => irA(idx + 1));
    // Al deslizar con el dedo, el índice se recalcula del scroll real
    track.addEventListener('scroll', () => { idx = actual(); pintar(); }, { passive: true });
    pintar();
  }
</script>

