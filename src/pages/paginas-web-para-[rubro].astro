---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Stars from '../components/Stars.astro';
import Icono from '../components/Icono.astro';
import { landings, rubroDeLanding, hrefRubro, type Landing } from '../data/landings';
import { rubros, soles, afinesRubro, anchorRubro } from '../data/rubros';
import { iconoPara } from '../data/iconos';
import { fotoDeRubro } from '../data/fotos';
import { flashcardsProblema } from '../data/preguntasProblema';
import { site, waLink } from '../data/site';

export function getStaticPaths() {
  return landings.map((landing) => ({ params: { rubro: landing.param }, props: { landing } }));
}

interface Props { landing: Landing }
const { landing } = Astro.props;

const rubro = rubroDeLanding(landing);
const url = `${site.domain}/paginas-web-para-${landing.param}/`;

// Si un rubro nuevo todavía no tiene foto, la sección cae al layout de una
// columna en vez de dejar un hueco.
const foto = fotoDeRubro(landing.param);

// Flashcards del problema (pregunta + respuesta corta), en el mismo orden que
// los párrafos. Si el rubro aún no las tiene, la tarjeta muestra un rótulo
// neutro al frente y el párrafo completo al dorso.
const cartas = flashcardsProblema[landing.param] ?? [];

const afines = (afinesRubro[rubro.slug] ?? [])
  .map((slug) => rubros.find((r) => r.slug === slug))
  .filter((r): r is (typeof rubros)[number] => Boolean(r));

// El precio y el plazo salen de rubros.ts, la misma fuente que alimenta el
// texto visible del bloque "Precio y plazo". Así el Offer no puede decir una
// cosa mientras la página dice otra.
const schema = [
  {
    '@type': 'Service',
    '@id': `${url}#servicio`,
    name: landing.h1,
    serviceType: rubro.keyword,
    description: landing.metaDescription,
    provider: { '@id': `${site.domain}/#org` },
    areaServed: { '@type': 'Country', name: 'Perú' },
    offers: {
      '@type': 'Offer',
      priceCurrency: 'PEN',
      price: String(rubro.startingPrice),
      priceSpecification: {
        '@type': 'PriceSpecification',
        priceCurrency: 'PEN',
        minPrice: String(rubro.startingPrice),
        valueAddedTaxIncluded: false,
      },
      availability: 'https://schema.org/InStock',
      url,
    },
  },
  {
    // Preguntas propias de este rubro. No se solapan con el FAQPage de la
    // portada, que responde dudas generales de contratación.
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: landing.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

// ---- Módulos: solo los que NO vienen ya incluidos ----
//
// El catálogo de `rubros.ts` se escribió aparte de las listas de secciones y
// funciones, y acabaron describiendo lo mismo. La página quedaba diciendo
// "tu web tendrá galería de trabajos" arriba y "galería de trabajos es un
// módulo que se suma" tres pantallas después. Medido en las doce landings: 59
// módulos repetían algo ya prometido. En bodegas eran 8 de 9.
//
// Eso no es texto de sobra, es una contradicción de precio: el cliente llega a
// la reunión creyendo que pagó por algo que se cobra aparte. Aquí se filtra:
// "módulo" pasa a significar lo único que puede significar, algo que todavía no
// está incluido.
//
// El emparejado va por palabras con carga: se tiran las vacías ("online", "de",
// "por"…) y basta con que compartan una para considerarlos lo mismo. Es
// deliberadamente generoso: ante la duda preferimos NO ofrecer como extra algo
// que quizá ya prometimos, porque ese error se paga en la reunión de venta y el
// contrario solo cuesta una viñeta menos.
const VACIAS = new Set([
  'online', 'digital', 'digitales', 'web', 'para', 'con', 'por', 'del', 'los', 'las',
  'que', 'una', 'uno', 'tus', 'tu', 'the', 'and', 'sin', 'más', 'mas', 'cada', 'opcional',
]);
const carga = (t: string) =>
  new Set(
    t
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z ]/g, ' ')
      .split(' ')
      .filter((w) => w.length > 4 && !VACIAS.has(w)),
  );

const yaIncluido = [
  ...landing.secciones.items.map((s) => s.title),
  ...landing.funciones.items.map((f) => f.title),
].map(carga);

const esNuevo = (titulo: string) => {
  const t = carga(titulo);
  return !yaIncluido.some((inc) => [...t].some((w) => inc.has(w)));
};

const gruposExtra = rubro.moduleGroups
  .map((g) => ({ ...g, modules: g.modules.filter((m) => esNuevo(m.title)) }))
  .filter((g) => g.modules.length > 0);

const modulos = gruposExtra.reduce((n, g) => n + g.modules.length, 0);

const waMsg = `Hola Bitwise 👋 quiero cotizar una página web para mi ${rubro.short}`;
---

<BaseLayout
  title={landing.metaTitle}
  description={landing.metaDescription}
  breadcrumbLabel={landing.breadcrumb}
  schema={schema}
>
  <!-- Hero: texto a la izquierda, esquema de la web a la derecha -->
  <section class="hero-dark relative isolate overflow-hidden px-6 pb-20 pt-[140px] text-white">
    <Stars />
    <div class="mx-auto grid w-full max-w-[1120px] items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <nav aria-label="Ruta" class="mb-8 text-[13px] text-slate-400">
          <a href="/proyectos" class="text-slate-400 no-underline transition-colors hover:text-white">Proyectos</a>
          <span class="mx-2 text-slate-600">/</span>
          <span class="text-slate-300">{landing.breadcrumb}</span>
        </nav>

        <span class="eyebrow eyebrow--dark">
          <span class="text-[15px] leading-none" aria-hidden="true">{rubro.emoji}</span>
          {landing.eyebrow}
        </span>

        <h1 class="mt-5 font-display text-[clamp(2rem,5vw,3rem)] font-extrabold leading-[1.08]">
          {landing.h1}
        </h1>
        <p class="mt-5 max-w-[560px] text-[17px] leading-[1.65] text-slate-300">{landing.intro}</p>

        <div class="mt-7 flex flex-wrap gap-3">
          <span class="hero-chip">
            <Icono name="etiqueta" size={15} />
            Desde <strong class="text-accent">{soles(rubro.startingPrice)} + IGV</strong>
          </span>
          <span class="hero-chip">
            <Icono name="reloj" size={15} />
            Entrega en <strong class="text-accent">{rubro.deliveryTime}</strong>
          </span>
          <span class="hero-chip">
            <Icono name="www" size={15} />
            Dominio y hosting <strong class="text-accent">incluidos</strong>
          </span>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={waLink(waMsg)} target="_blank" rel="noopener" class="btn btn--whatsapp group !py-3 !pl-[26px] !text-[15px]">
            Cotizar por WhatsApp
            <span class="btn__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
            </span>
          </a>
          <a href="#formulario" class="btn btn--on-dark !px-[26px] !py-3 !text-[15px]">Formulario de contacto</a>
        </div>
      </div>

      {/* La foto del rubro, aquí arriba. Antes este hueco lo ocupaba un dibujo
          de navegador hecho con CSS —secciones inventadas dentro de una ventana
          falsa— y abajo, a media página, iba la foto de verdad. El dibujo no le
          decía nada a nadie: quien busca "página web para pollería" reconoce un
          pollo a la brasa en medio segundo, y una ventana con rectángulos grises
          no la reconoce nunca. */}
      {foto && (
        <figure class="foto-hero-rubro reveal m-0">
          <picture>
            <source media="(max-width: 1023px)" srcset={`/rubros/${landing.param}-sm.webp`} width="560" height="380" />
            <img
              src={`/rubros/${landing.param}.webp`}
              width="880"
              height="600"
              alt={foto.alt}
              fetchpriority="high"
              decoding="async"
              class="block h-full w-full object-cover"
            />
          </picture>
        </figure>
      )}
    </div>
  </section>

  <!-- 1. El problema, en flashcards que se voltean -->
  <section class="surface px-6 py-20">
    <div class="mx-auto w-full max-w-[1020px]">
      <div class="reveal flex items-start gap-4">
        <span class="prob-ico grid h-12 w-12 flex-none place-items-center rounded-[14px]">
          <Icono name="campanaAlerta" size={22} />
        </span>
        <h2 class="m-0 pt-1 font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
          {landing.problema.title}
        </h2>
      </div>

      <!-- Flashcards: la pregunta al frente, la tarjeta se voltea con
           animación y al dorso está la respuesta corta. En escritorio se ven
           las tres a la vez; en móvil se pasan deslizando. -->
      <div class="reveal mt-8">
        <div class="fc-track" data-fc-track>
          {landing.problema.parrafos.map((p, i) => (
            <article class="fc-flip" data-fc-flip>
              <div class="fc-inner">
                <div class="fc-face fc-front rounded-[20px] bg-white">
                  <span class="fc-num">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="m-0 mt-4 font-display text-[18px] font-extrabold leading-[1.35] text-dark [text-wrap:balance]">
                    {cartas[i]?.q ?? `El problema, parte ${i + 1}`}
                  </h3>
                  <button type="button" data-fc-voltear class="fc-voltear mt-auto pt-6">
                    <span class="fc-voltear__ico" aria-hidden="true">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v5h-5"/></svg>
                    </span>
                    Ver la respuesta
                  </button>
                </div>

                <div class="fc-face fc-back rounded-[20px]" inert>
                  <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-accent">Respuesta</span>
                  <p class="m-0 mt-3 text-[14.5px] leading-[1.7] text-slate-300 [text-wrap:pretty]">
                    {cartas[i]?.r ?? p}
                  </p>
                  <button type="button" data-fc-voltear class="fc-voltear fc-voltear--claro mt-auto pt-5">
                    <span class="fc-voltear__ico" aria-hidden="true">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 3v5h5"/></svg>
                    </span>
                    Volver a la pregunta
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- Navegación del carril: solo tiene sentido en móvil, donde las
             tarjetas se pasan de una en una. -->
        <div class="fc-nav mt-5 flex items-center justify-between gap-4 lg:hidden">
          <div class="flex gap-2" data-fc-dots aria-hidden="true"></div>
          <div class="flex gap-2">
            <button type="button" data-fc-prev aria-label="Tarjeta anterior" class="fc-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M19 12H5m6 6-6-6 6-6"/></svg>
            </button>
            <button type="button" data-fc-next aria-label="Siguiente tarjeta" class="fc-btn fc-btn--primario">
              Siguiente
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- El texto completo de los tres problemas, desplegable. Aquí vive el
           contenido largo que indexa Google; las flashcards son el resumen. -->
      <details class="fc-detalle reveal mt-6 overflow-hidden rounded-[16px] bg-white">
        <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 font-display text-[15px] font-bold text-dark">
          Lee el detalle completo de estos tres problemas
          <svg class="fc-detalle__ico shrink-0 text-primary" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="grid gap-4 px-5 pb-5">
          {landing.problema.parrafos.map((p) => (
            <p class="m-0 text-[15.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">{p}</p>
          ))}
        </div>
      </details>
    </div>
  </section>

  {/* Secciones y funciones, en viñetas.

      Antes eran doce tarjetas —seis y seis— con icono, título y un párrafo cada
      una: 484 palabras que hay que leer una por una para saber qué te dan. Nadie
      lee doce párrafos para decidir si pide una cotización.

      Ahora es una lista de viñetas con su icono: se recorre entera de un vistazo
      y el mensaje que queda es "esto trae muchas cosas y las entiendo todas". El
      texto largo de cada punto no se pierde: vive en el desplegable del final de
      cada bloque, cerrado. Google lo lee igual —es el mismo HTML— y al visitante
      no le cuesta ni un píxel de scroll. Es el mismo truco que ya usaba la
      sección del problema en esta página. */}
  <section class="surface--alt px-6 py-20">
    <div class="mx-auto w-full max-w-[1020px]">
      <div class="reveal mx-auto max-w-[760px]">
        <h2 class="font-display text-[clamp(1.5rem,3.2vw,2rem)] font-extrabold leading-[1.18] text-dark">
          {landing.secciones.title}
        </h2>
      </div>

      <ul class="vinetas mt-8 grid list-none gap-x-6 gap-y-3.5 p-0">
        {landing.secciones.items.map((s, i) => (
          <li class="vineta reveal" style={`--reveal-delay:${(i % 4) * 60}ms`}>
            <span class="vineta__ico">
              <Icono name={iconoPara(s.title)} size={17} />
            </span>
            {s.title}
          </li>
        ))}
      </ul>

      <details class="detalle-plegado reveal mt-7 overflow-hidden rounded-[16px] bg-white">
        <summary>
          Ver qué hace cada sección
          <svg class="detalle-plegado__ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="grid gap-3.5 px-5 pb-5">
          {landing.secciones.items.map((s) => (
            <p class="m-0 text-[14.5px] leading-[1.7] text-slate-600">
              <strong class="text-dark">{s.title}.</strong> {s.desc}
            </p>
          ))}
        </div>
      </details>
    </div>
  </section>

  <section class="surface px-6 py-20">
    <div class="mx-auto w-full max-w-[1020px]">
      <div class="reveal mx-auto max-w-[760px]">
        <h2 class="font-display text-[clamp(1.5rem,3.2vw,2rem)] font-extrabold leading-[1.18] text-dark">
          {landing.funciones.title}
        </h2>
      </div>

      <ul class="vinetas mt-8 grid list-none gap-x-6 gap-y-3.5 p-0">
        {landing.funciones.items.map((f, i) => (
          <li class="vineta reveal" style={`--reveal-delay:${(i % 4) * 60}ms`}>
            <span class="vineta__ico vineta__ico--acento">
              <Icono name={iconoPara(f.title)} size={17} />
            </span>
            {f.title}
          </li>
        ))}
      </ul>

      <details class="detalle-plegado reveal mt-7 overflow-hidden rounded-[16px] bg-white">
        <summary>
          Ver qué hace cada función
          <svg class="detalle-plegado__ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="grid gap-3.5 px-5 pb-5">
          {landing.funciones.items.map((f) => (
            <p class="m-0 text-[14.5px] leading-[1.7] text-slate-600">
              <strong class="text-dark">{f.title}.</strong> {f.desc}
            </p>
          ))}
        </div>
      </details>
    </div>
  </section>

  {/* Precio y plazo, con el detalle.

      Estuvo un rato justo debajo de la portada, por una medición mal hecha: se
      midió dónde caía el H2 "Precio y plazo", no dónde se veía el precio. El
      precio ya está en la portada, en la primera pantalla, en la pastilla
      "Desde S/… + IGV". Subir esta sección solo consiguió decir la misma cifra
      dos veces en dos pantallas seguidas.

      Aquí abajo es donde corresponde: primero se entiende qué se compra —el
      problema, las secciones, las funciones del rubro— y recién entonces cuánto
      cuesta y cómo se paga. Esta sección no repite la cifra: la explica. */}
  <section class="surface--alt px-6 py-20">
    <div class="mx-auto w-full max-w-[760px]">
      <h2 class="reveal font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
        {landing.precio.title}
      </h2>

      <div class="reveal mt-7 rounded-[20px] bg-white p-6" style="box-shadow:inset 0 0 0 1px var(--hairline)">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">Desde</span>
          <span class="font-display text-[2rem] font-extrabold text-dark [font-variant-numeric:tabular-nums]">{soles(rubro.startingPrice)}</span>
          <span class="text-[14px] text-slate-500">+ IGV</span>
        </div>

        {/* Solo lo que la portada NO dice ya. Arriba, en la primera pantalla,
            las pastillas del titular anuncian el plazo de entrega y que el
            dominio y el hosting van incluidos; repetirlos aquí abajo no informa
            de nada, solo llena. Quedan las dos cosas nuevas: el certificado y
            cómo se reparte el pago. */}
        <div class="mt-5 flex flex-wrap gap-2.5 border-t border-dashed border-slate-200 pt-5">
          {[
            { icono: 'candado', texto: 'Certificado de seguridad' },
            { icono: 'tarjeta', texto: '50% inicio · 50% entrega' },
          ].map((c) => (
            <span class="precio-chip">
              <Icono name={c.icono} size={15} />
              {c.texto}
            </span>
          ))}
        </div>
      </div>

      <div class="mt-6 grid gap-5">
        {landing.precio.parrafos.map((p) => (
          <p class="reveal m-0 text-[16.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">{p}</p>
        ))}
      </div>

      <p class="reveal mt-6 text-[15px] leading-[1.7] text-slate-600">
        Puedes ver el detalle completo de lo que incluye cada servicio en
        <a href="/servicios" class="font-semibold text-primary">nuestra página de servicios</a>, o
        <a href="/contacto" class="font-semibold text-primary">escribirnos por el formulario</a>
        para recibir una cotización por escrito en 24 horas.
      </p>
    </div>
  </section>



  {/* Condiciones, en una tira compacta.

      Era un panel oscuro con seis tarjetas, cada una con su icono, su título y
      su párrafo. Medido: ese bloque es 99% idéntico en las doce landings —lo
      comparé entre pollerías, bodegas, clínicas y gimnasios— y repite lo que ya
      dice /servicios. Texto que se repite igual en doce páginas no suma nada
      para Google, porque no es contenido propio de ninguna, y al visitante le
      añade una pantalla de scroll antes de llegar a lo que sí es de su rubro.

      Quedan los seis títulos, que es lo que de verdad tranquiliza, sin los
      párrafos que nadie lee dos veces. El detalle sigue entero en /servicios. */}
  <section class="surface--alt px-6 pb-16">
    <div class="reveal mx-auto w-full max-w-[900px]">
      <ul class="m-0 flex list-none flex-wrap justify-center gap-x-5 gap-y-3 p-0">
        {[
          'Cotización cerrada por escrito',
          '50% inicio · 50% entrega',
          `Entrega en ${rubro.deliveryTime}`,
          'Dominio y código a tu nombre',
          '30 días de garantía',
          'Lo administras tú',
        ].map((t) => (
          <li class="flex items-center gap-2 text-[14px] font-medium text-slate-600">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
            {t}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Módulos, en viñetas por grupo. Eran once tarjetas con emoji, título y
      párrafo; ahora es la lista de lo que puedes sumar, agrupada, y el detalle
      de cada módulo va plegado igual que arriba. */}
  <section class="surface--alt px-6 py-20">
    <div class="mx-auto w-full max-w-[1020px]">
      <div class="reveal mx-auto max-w-[760px]">
        <h2 class="font-display text-[clamp(1.5rem,3.2vw,2rem)] font-extrabold leading-[1.18] text-dark">
          Los {modulos} módulos que puedes sumar
        </h2>
        <p class="mt-4 text-[15.5px] leading-[1.7] text-slate-600 [text-wrap:pretty]">
          Tu {rubro.short} arranca con lo esencial y crece por partes. Se cotizan solo los que elijas.
        </p>
      </div>

      {gruposExtra.map((group) => (
        <div class="mt-9">
          <h3 class="reveal flex items-center gap-3 font-display text-[13px] font-bold uppercase tracking-[0.12em] text-slate-500">
            <span class="h-px w-8 bg-primary"></span>
            {group.name}
          </h3>
          <ul class="vinetas mt-4 grid list-none gap-x-6 gap-y-3 p-0">
            {group.modules.map((m, i) => (
              <li class="vineta reveal" style={`--reveal-delay:${(i % 4) * 60}ms`}>
                <span class="vineta__emoji" aria-hidden="true">{m.emoji}</span>
                {m.title}
              </li>
            ))}
          </ul>
        </div>
      ))}

      <details class="detalle-plegado reveal mt-8 overflow-hidden rounded-[16px] bg-white">
        <summary>
          Ver qué hace cada módulo
