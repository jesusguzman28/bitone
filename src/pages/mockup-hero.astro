---
import BaseLayout from '../layouts/BaseLayout.astro';
import { hero, waLink, heroPrecios } from '../data/site';

const pills = [
  { label: 'Rápidas', color: '#f59e0b', icon: '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>' },
  { label: 'Accesibles', color: '#22c55e', icon: '<circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/>' },
  { label: 'Profesionales', color: '#818cf8', icon: '<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/>' },
];
---

<BaseLayout title="Preview hero con video HD" description="Prueba interna del hero con video aplicado.">
  <section class="hero relative isolate flex min-h-[100dvh] flex-col justify-center overflow-hidden pt-24 pb-14 text-white sm:pt-28 sm:pb-16" style="background:radial-gradient(120% 78% at 50% 8%,#1c2331 0%,#141b28 46%,#0e1521 100%)">
    <!-- Fondo de VIDEO (solo desktop) -->
    <div class="pointer-events-none absolute inset-0 -z-10 hidden sm:block">
      <video
        class="absolute inset-0 h-full w-full object-cover"
        style="object-position:center"
        autoplay muted loop playsinline preload="auto"
        poster="/mockup/imac-h.jpg"
      >
        <source src="/mockup/imac-h.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0" style="background:linear-gradient(105deg,rgba(5,8,20,0.92) 0%,rgba(5,8,20,0.78) 34%,rgba(5,8,20,0.35) 62%,rgba(5,8,20,0.15) 100%)"></div>
      <div class="absolute -left-16 top-10 h-96 w-96 rounded-full opacity-40 blur-3xl" style="background:radial-gradient(circle,#D91023,transparent 70%)"></div>
    </div>

    <div class="section w-full">
      <!-- Vitrina de VIDEO vertical (solo móvil) -->
      <div class="relative mb-6 sm:hidden">
        <div class="pointer-events-none absolute -inset-6 -z-10 opacity-60 blur-3xl" style="background:radial-gradient(60% 55% at 50% 30%,rgba(217,16,35,0.35),transparent 72%)"></div>
        <div class="relative overflow-hidden rounded-[1.5rem]" style="aspect-ratio:5/4;box-shadow:0 30px 62px -28px rgba(0,0,0,0.8)">
          <video
            class="absolute inset-0 h-full w-full object-cover"
            style="object-position:center 30%"
            autoplay muted loop playsinline preload="auto"
            poster="/mockup/imac-v.jpg"
          >
            <source src="/mockup/imac-v-med.mp4" type="video/mp4" />
          </video>
          <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(180deg,rgba(5,8,20,0.28) 0%,transparent 24%,transparent 62%,rgba(5,8,20,0.62) 100%)"></div>
          <div class="absolute left-3 top-3 flex items-center gap-2 rounded-full py-1.5 pl-2.5 pr-3.5 text-xs font-semibold text-white" style="background:rgba(8,12,24,0.55);backdrop-filter:blur(10px);box-shadow:inset 0 0 0 1px rgba(255,255,255,0.16)">
            <span class="hero-live-dot"></span>
            <span>Tienda en vivo</span>
          </div>
        </div>
      </div>

      <div class="max-w-2xl">
        <div class="relative">
          <div class="pointer-events-none absolute -inset-7 -z-10 rounded-[3rem] opacity-100 blur-2xl sm:hidden" style="background:radial-gradient(72% 64% at 22% 20%,rgba(217,16,35,0.72),transparent 64%),radial-gradient(68% 62% at 86% 84%,rgba(232,163,23,0.56),transparent 66%),radial-gradient(92% 82% at 50% 50%,rgba(90,120,185,0.32),transparent 72%)"></div>
          <div class="rounded-[2rem] p-6 text-center sm:p-9 sm:text-left" style="background:rgba(11,16,27,0.5);box-shadow:inset 0 1px 1px rgba(255,255,255,0.1),inset 0 0 0 1px rgba(255,255,255,0.14),0 40px 90px -30px rgba(0,0,0,0.9),0 0 0 1px rgba(217,16,35,0.08);backdrop-filter:blur(20px) saturate(125%);-webkit-backdrop-filter:blur(20px) saturate(125%)">
            <span class="eyebrow eyebrow--dark" style="display:inline-flex;align-items:center;gap:8px">
              <svg width="20" height="13" viewBox="0 0 3 2" aria-hidden="true" style="border-radius:2px;box-shadow:0 0 0 1px rgba(255,255,255,0.15)">
                <rect width="1" height="2" x="0" fill="#D91023" /><rect width="1" height="2" x="1" fill="#fff" /><rect width="1" height="2" x="2" fill="#D91023" />
              </svg>
              {hero.eyebrow}
            </span>
            <h1 class="mt-5 font-display text-[clamp(2.55rem,7.2vw,3.8rem)] font-bold leading-[1.05]" style="min-height:calc(3 * 1.05em)">
              {hero.h1}<br />
              <span id="typed" class="typed-text"></span><span id="cursor" class="typed-cursor">|</span>
            </h1>
            {/* Esta prueba interna usaba `hero.titleA`, `hero.subtitle` y
                `hero.h1Destacado`, que desaparecieron cuando el titular del hero
                pasó a ser una línea fija más una frase que se escribe y se
                borra. Se queda con el H1 y esa frase, que es lo que hay ahora en
                la portada de verdad. */}
            <p class="mx-auto mt-5 max-w-lg text-base leading-relaxed text-slate-300 sm:mx-0 sm:text-lg">{hero.typed[0]}</p>

            <div class="mt-5 flex flex-wrap justify-center gap-2 sm:justify-start">
              {pills.map((p) => (
                <span class="inline-flex items-center gap-1.5 rounded-full py-1.5 pl-2.5 pr-3 text-xs font-medium text-slate-100" style="background:rgba(255,255,255,0.06);box-shadow:inset 0 0 0 1px rgba(255,255,255,0.12)">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke={p.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
                  {p.label}
                </span>
              ))}
            </div>

            <div class="mt-7 flex flex-wrap justify-center gap-3 sm:justify-start">
              <a href={waLink('Hola Bitwise 👋 quiero agendar una reunión para mi negocio')} target="_blank" rel="noopener" class="btn btn--whatsapp group text-base">
                Agendar reunión
                <span class="btn__icon" aria-hidden="true">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
                </span>
              </a>
              <a href="/proyectos" class="btn btn--on-dark text-base">Ver proyectos</a>
            </div>
          </div>
        </div>

        <dl class="mx-auto mt-8 grid max-w-md grid-cols-2 gap-4 text-center sm:mx-0">
          {heroPrecios.map((s) => {
            const price = s.v.replace(/^Desde\s*/i, '');
            return (
              <div class="group flex flex-col items-center rounded-2xl px-5 py-4" style="background:rgba(8,12,24,0.72);box-shadow:inset 0 1px 0 rgba(255,255,255,0.08),inset 0 0 0 1px rgba(255,255,255,0.1),0 20px 42px -24px rgba(0,0,0,0.7)">
                <dt class="text-[11px] font-semibold uppercase tracking-[0.15em] text-slate-400">{s.k}</dt>
                <dd class="mt-2 flex items-baseline gap-1.5">
                  <span class="text-[10px] font-medium uppercase tracking-wide text-slate-500">Desde</span>
                  <span class="font-display text-2xl font-bold leading-none text-white [font-variant-numeric:tabular-nums]">{price}</span>
                </dd>
              </div>
            );
          })}
        </dl>
      </div>
    </div>
  </section>

  <script define:vars={{ phrases: hero.typed }}>
    const typedEl = document.getElementById('typed');
    const cursorEl = document.getElementById('cursor');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (typedEl) {
      if (reduce) {
        typedEl.textContent = phrases[0];
        document.querySelectorAll('video[autoplay]').forEach((v) => v.pause());
      } else {
        let p = 0, c = 0, deleting = false;
        const tick = () => {
          const full = phrases[p];
          c += deleting ? -1 : 1;
          typedEl.textContent = full.slice(0, c);
          let delay = deleting ? 40 : 75;
          if (!deleting && c === full.length) { delay = 1600; deleting = true; }
          else if (deleting && c === 0) { deleting = false; p = (p + 1) % phrases.length; delay = 350; }
          setTimeout(tick, delay);
        };
        tick();
        setInterval(() => cursorEl && (cursorEl.style.opacity = cursorEl.style.opacity === '0' ? '1' : '0'), 500);
      }
    }
  </script>

  <style>
    .typed-text { background: linear-gradient(120deg, #3b82f6, #6366f1, #a855f7); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .typed-cursor { color: #a855f7; font-weight: 400; }
    .hero-live-dot { height: 7px; width: 7px; border-radius: 999px; background: #22c55e; box-shadow: 0 0 0 0 rgba(34,197,94,0.6); animation: heroLivePulse 2s cubic-bezier(0.4,0,0.6,1) infinite; }
    @keyframes heroLivePulse { 0% { box-shadow: 0 0 0 0 rgba(34,197,94,0.55); } 70% { box-shadow: 0 0 0 6px rgba(34,197,94,0); } 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); } }
    @media (prefers-reduced-motion: reduce) { .hero-live-dot { animation: none; } }
  </style>
</BaseLayout>
