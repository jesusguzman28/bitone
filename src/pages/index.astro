---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import SolucionesNegocio from '../components/SolucionesNegocio.astro';
import Stats from '../components/Stats.astro';
import Resenas from '../components/Resenas.astro';
import MarcasBanner from '../components/MarcasBanner.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
---

<BaseLayout
  preloadImages={[
    { href: '/hero/uno.webp', media: '(min-width: 641px)', type: 'image/webp' },
    { href: '/hero/celular/uno.webp', media: '(max-width: 640px)', type: 'image/webp' },
  ]}
>
  <Hero />
  <MarcasBanner />
  <Servicios />
  <SolucionesNegocio />
  <Stats />
  {/* Va después de los números y antes de las preguntas: los números dicen lo
      que prometemos nosotros, la reseña lo dice quien ya pagó. Mientras no haya
      ninguna cargada, el componente no dibuja nada. */}
  <Resenas />
  <FAQ />
  <CTA />
</BaseLayout>
