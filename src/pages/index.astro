---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import Proyectos from '../components/Proyectos.astro';
import AppsProduccion from '../components/AppsProduccion.astro';
import Stats from '../components/Stats.astro';
import Resenas from '../components/Resenas.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { site, faqs } from '../data/site';

// Las preguntas frecuentes de la portada, en el mismo @graph que el resto. El
// componente <FAQ> solo dibuja; el dato estructurado se declara aquí para que
// la página tenga un único bloque de JSON-LD y el nodo pueda referenciarse por
// @id como los demás.
const schema = [
  {
    '@type': 'FAQPage',
    '@id': site.domain + '/#faq',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  schema={schema}
  preloadImages={[
    { href: '/hero/uno.webp', media: '(min-width: 641px)', type: 'image/webp' },
    { href: '/hero/celular/uno.webp', media: '(max-width: 640px)', type: 'image/webp' },
  ]}
>
  <Hero />
  <Servicios />

  {/* Los dos bloques de prueba, juntos y en este orden: primero las
      plataformas con su dirección, después las apps que salieron de ellas con
      su ficha de tienda. Van entre los servicios y las cifras a propósito —los
      servicios dicen qué hacemos, las cifras dicen qué prometemos, y esto de en
      medio es lo único que el visitante puede comprobar por su cuenta antes de
      escribirnos—. Una promesa después de una prueba pesa bastante más que al
      revés.

      Aquí arriba iba el banner de marcas, el carrusel con los logotipos. Se quitó
      al entrar <Proyectos>: enseñaba exactamente los mismos cinco nombres
      pasando de largo, sin decir qué es cada uno ni llevar a ninguna parte, y
      tres pantallas más abajo volvían a salir con su descripción y su enlace.
      Entre un nombre que desfila y una tarjeta que se puede abrir, no hay
      discusión.

      Y aquí iba también <SolucionesNegocio />: la parrilla de los 12 rubros
      —pollerías, bodegas, barberías— que enlazaba a las landings de página web.
      Se fue con ellas. */}
  <Proyectos
    title="Lo que hemos construido, con su dirección"
    subtitle="Lo que ha construido esta empresa de desarrollo: plataformas públicas que puedes abrir ahora mismo e intranets con acceso por usuario. Entra y compruébalo tú."
  />
  <AppsProduccion />

  <Stats />
  {/* Va después de los números y antes de las preguntas: los números dicen lo
      que prometemos nosotros, la reseña lo dice quien ya pagó. Mientras no haya
      ninguna cargada, el componente no dibuja nada. */}
  <Resenas />
  <FAQ />
  <CTA />
</BaseLayout>
