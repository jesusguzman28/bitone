---
// bitone.pe en mantenimiento (noviembre de 2026).
//
// Una sola página, indexable, mientras se decide qué va aquí. No usa Base.astro:
// la cabecera y el pie de ese marco enlazan a páginas que ya no existen. Lleva lo
// justo para Google (título, descripción, canónica, tarjeta para compartir y los
// datos de empresa) y un enlace a bitwise.pe, el sitio principal de la casa.
import '../styles/tokens.css';
import { getImage } from 'astro:assets';
import { empresa, enlaceWhatsApp, aclaracionNombres } from '../data/empresa';
import tarjeta from '../assets/marca/tarjeta.png';

const titulo = 'Bit One: sitio en mantenimiento. Sistemas a medida en Lima, Perú';
const descripcion =
  'Estamos renovando bitone.pe. Mientras tanto, conoce nuestros sistemas a medida en bitwise.pe o escríbenos por WhatsApp.';

const dominio = Astro.site ?? new URL(empresa.dominio);
const canonica = new URL('/', dominio).href;
const og = await getImage({ src: tarjeta, width: 1200, height: 630, format: 'png' });
const imagenOg = new URL(og.src, dominio).href;
const bitwise = 'https://bitwise.pe/';

const datos = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Bitwise',
  alternateName: [empresa.marca, 'Bitwise Perú'],
  legalName: empresa.razonSocial,
  taxID: empresa.ruc,
  url: bitwise,
  telephone: `+${empresa.whatsapp}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Lima', addressCountry: 'PE' },
  sameAs: [bitwise, empresa.dominio + '/'],
};
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {!import.meta.env.PROD && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#F4EEE4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={empresa.marca} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenOg} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(datos)} />
  </head>
  <body>
    <main class="caja">
      <p class="marca">{empresa.marca}</p>
      <h1>Estamos renovando bitone.pe</h1>
      <p class="bajada">Mientras tanto, conoce nuestros sistemas a medida en bitwise.pe.</p>
      <div class="botones">
        <a class="btn btn--rojo" href={bitwise}>Ir a bitwise.pe</a>
        <a class="btn btn--wa" href={enlaceWhatsApp()}>Escríbenos por WhatsApp</a>
      </div>
    </main>
    <footer class="pie">
      <p>Desarrollado por <a href={bitwise}>Bitwise</a>, empresa de software en Lima, Perú.</p>
      <p class="chico">{aclaracionNombres}</p>
    </footer>
  </body>
</html>

<style>
  @font-face {
    font-family: 'Archivo';
    src: url('/fonts/archivo-latin.woff2') format('woff2');
    font-weight: 100 900;
    font-display: swap;
  }
  :global(html) { background: var(--hueso); color: var(--tinta); }
  :global(body) {
    margin: 0;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    font-family: 'Archivo', system-ui, sans-serif;
  }
  .caja {
    align-self: center;
    justify-self: center;
    width: min(100% - 2.5rem, 40rem);
    padding: 3rem 0;
    text-align: center;
  }
  .marca {
    margin: 0 0 1rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--rojo-hondo);
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.25rem);
    line-height: 1.1;
    font-weight: 800;
  }
  .bajada { margin: 1.25rem 0 2rem; font-size: 1.15rem; color: var(--tinta-2); }
  .botones { display: flex; flex-wrap: wrap; gap: .75rem; justify-content: center; }
  .btn {
    display: inline-block;
    padding: .9rem 1.5rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    color: #fff;
  }
  .btn--rojo { background: linear-gradient(90deg, var(--rojo), #E8541A); }
  .btn--wa { background: #1DA851; }
  .btn:focus-visible, .pie a:focus-visible { outline: 3px solid var(--tinta); outline-offset: 3px; }
  .pie {
    padding: 1.5rem 1.25rem 2rem;
    text-align: center;
    border-top: 1px solid var(--linea);
    color: var(--tinta-2);
  }
  .pie p { margin: .25rem 0; }
  .pie a { color: var(--rojo-hondo); font-weight: 700; }
  .chico { font-size: .85rem; }
</style>
