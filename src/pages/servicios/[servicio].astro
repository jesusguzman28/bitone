---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import Stars from '../../components/Stars.astro';
import Icono from '../../components/Icono.astro';
import { servicios, type Servicio } from '../../data/servicios';
import { site, serviciosTabs, waLink } from '../../data/site';
import { blog, blogDeServicio } from '../../data/blog';

// Una página por servicio. Al sumar un servicio a servicios.ts, su página se
// genera sola con esta misma estructura.
export function getStaticPaths() {
  return servicios.map((servicio) => ({ params: { servicio: servicio.slug }, props: { servicio } }));
}

interface Props { servicio: Servicio }
const { servicio } = Astro.props;

// El precio, el plazo y la lista de lo que incluye salen de serviciosTabs, que
// es la misma fuente que alimenta el índice de /servicios. Así no puede pasar
// que el índice diga un precio y la página del servicio diga otro.
const tab = serviciosTabs.find((t) => t.id === servicio.tabId)!;

const url = `${site.domain}/servicios/${servicio.slug}/`;

// Guías del blog que terminan en este servicio. Si ninguna apunta aquí, se
// muestran las dos primeras del blog para que la sección no quede vacía.
const guiasPropias = blogDeServicio(`/servicios/${servicio.slug}/`);
const guias = (guiasPropias.length ? guiasPropias : blog).slice(0, 3);

const offers: Record<string, unknown> = {
  '@type': 'Offer',
  priceCurrency: 'PEN',
  availability: 'https://schema.org/InStock',
  url,
};
if (tab.price !== null) {
  offers.price = String(tab.price);
  offers.priceSpecification = {
    '@type': 'PriceSpecification',
    priceCurrency: 'PEN',
    minPrice: String(tab.price),
    ...(tab.ivaIncluido !== null ? { valueAddedTaxIncluded: tab.ivaIncluido } : {}),
  };
}

const schema = [
  {
    '@type': 'Service',
    '@id': `${url}#servicio`,
    name: tab.schemaName,
    serviceType: tab.serviceType,
    description: servicio.metaDescription,
    provider: { '@id': `${site.domain}/#org` },
    areaServed: { '@type': 'Country', name: 'Perú' },
    offers,
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: servicio.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={servicio.metaTitle}
  description={servicio.metaDescription}
  breadcrumbLabel={servicio.breadcrumb}
  schema={schema}
>
  {/* 1. Portada: texto a la izquierda, foto del servicio a la derecha. Sin foto
       el texto pasa a una sola columna centrada, que se ve entero en vez de
       dejar media portada vacía esperando una imagen que aún no existe. */}
  <section class="hero-dark relative isolate overflow-hidden px-6 pb-20 pt-[140px] text-white">
    <Stars />
    <div
      class:list={[
        'mx-auto grid w-full items-center gap-12',
        servicio.hero ? 'max-w-[1120px] lg:grid-cols-[1.02fr_0.98fr]' : 'max-w-[1120px]',
      ]}
    >
      <div>
        <nav aria-label="Ruta" class="mb-8 text-[13px] text-slate-400">
          <a href="/servicios/" class="text-slate-400 no-underline transition-colors hover:text-white">Servicios</a>
          <span class="mx-2 text-slate-600">/</span>
          <span class="text-slate-300">{servicio.breadcrumb}</span>
        </nav>

        {/* Sin rótulo sobre el titular: decía lo mismo que la miga de pan de
            arriba y que el propio H1 de abajo. */}
        <h1 class="mt-5 max-w-[18ch] font-display text-[clamp(2.1rem,5.4vw,3.8rem)] font-extrabold leading-[1]" style="font-stretch:125%">
          {servicio.h1}
        </h1>
        <p class:list={['mt-5 max-w-[560px] text-[17px] leading-[1.65] text-slate-300', false]}>{servicio.intro}</p>

        <div class:list={['mt-7 flex flex-wrap gap-3', !servicio.hero && 'justify-center']}>
          <span class="hero-chip">
            <Icono name="etiqueta" size={15} />
            {tab.price === null ? 'Precio' : 'Desde'}
            <strong class="text-accent">{tab.priceLabel}</strong>
            {tab.priceNote && <span class="text-slate-400">· {tab.priceNote.toLowerCase()}</span>}
          </span>
          <span class="hero-chip">
            <Icono name="reloj" size={15} />
            Entrega en <strong class="text-accent">{tab.time}</strong>
          </span>
          <span class="hero-chip">
            <Icono name="escudo" size={15} />
            <strong class="text-accent">{tab.incluye}</strong>
          </span>
        </div>

        <div class:list={['mt-8 flex flex-wrap gap-3', !servicio.hero && 'justify-center']}>
          <a href={waLink(tab.wa)} target="_blank" rel="noopener" class="btn btn--whatsapp group !py-3 !pl-[26px] !text-[15px]">
            Cotizar por WhatsApp
            <span class="btn__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
            </span>
          </a>
          <a href="#formulario" class="btn btn--on-dark !px-[26px] !py-3 !text-[15px]">Formulario de contacto</a>
        </div>
      </div>

      {servicio.hero && (
        <figure class="foto-hero m-0">
          <picture>
            <source media="(max-width: 1023px)" srcset={`/servicios/${servicio.hero}-sm.webp`} width="620" height="420" />
            <img
              src={`/servicios/${servicio.hero}.webp`}
              width="1000"
              height="680"
              alt={servicio.heroAlt}
              fetchpriority="high"
              decoding="async"
              class="block h-full w-full object-cover"
            />
          </picture>
        </figure>
      )}
    </div>
  </section>

  <!-- 2. El problema que resuelve -->
  <section class="surface px-6 py-20">
    <div class="w-full max-w-[900px] ml-[max(0px,calc((100%-1120px)/2))]">
      <div class="reveal flex items-start gap-4">
        <span class="prob-ico grid h-12 w-12 flex-none place-items-center rounded-[8px]">
          <Icono name="campanaAlerta" size={22} />
        </span>
        <h2 class="m-0 pt-1 font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
          {servicio.problema.title}
        </h2>
      </div>

      <div class="mt-8 grid gap-4">
        {servicio.problema.parrafos.map((p, i) => (
          <p class="reveal prob-parrafo m-0 rounded-[8px] bg-white p-6 text-[16.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]" style={`--reveal-delay:${i * 90}ms`}>
            {p}
          </p>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Cómo funciona: un paso por bloque, con su foto -->
  <section class="surface--alt px-6 py-20">
    <div class="mx-auto w-full max-w-[1120px]">
      <div class="reveal max-w-[760px]">
        <h2 class="font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
          {servicio.comoFunciona.title}
        </h2>
        <p class="mt-5 text-[16.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">{servicio.comoFunciona.intro}</p>
      </div>

      <!-- Los pasos alternan lado en escritorio para que la lectura no caiga
           siempre en la misma columna. En móvil quedan uno debajo de otro,
           siempre foto arriba y texto abajo. -->
      <ol class="m-0 mt-12 grid list-none gap-12 p-0">
        {servicio.comoFunciona.pasos.map((paso, i) => (
          <li class={`paso reveal grid items-center gap-8 lg:grid-cols-2 ${i % 2 === 1 ? 'paso--invertido' : ''}`}>
            {paso.foto && (
              <figure class="paso-foto m-0">
                <picture>
                  <source media="(max-width: 1023px)" srcset={`/servicios/${paso.foto}-sm.webp`} width="420" height="300" />
                  <img
                    src={`/servicios/${paso.foto}.webp`}
                    width="560"
                    height="400"
                    alt={paso.alt}
                    loading="lazy"
                    decoding="async"
                    class="block h-full w-full object-cover"
                  />
                </picture>
              </figure>
            )}

            <div class="paso-texto">
              <div class="flex items-center gap-3">
                <span class="paso-ico grid h-11 w-11 flex-none place-items-center rounded-[13px]">
                  <Icono name={paso.icono} size={20} />
                </span>
                <span class="font-display text-[13px] font-bold text-slate-400">
                  Paso {i + 1} de {servicio.comoFunciona.pasos.length}
                </span>
              </div>
              <h3 class="mt-4 font-display text-[clamp(1.15rem,2.4vw,1.5rem)] font-extrabold leading-[1.25] text-dark">
                {paso.titulo}
              </h3>
              <p class="mt-3 text-[16px] leading-[1.7] text-slate-600 [text-wrap:pretty]">{paso.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. Qué incluye -->
  <section class="surface px-6 py-20">
    <div class="mx-auto w-full max-w-[1120px]">
      <div class="reveal max-w-[760px]">
        <h2 class="font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
          Qué incluye
        </h2>
        <p class="mt-5 text-[16.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">
          {tab.price === null
            ? 'Todo esto entra en el precio que te damos cerrado y por escrito.'
            : `Todo esto entra en el precio de ${tab.priceLabel}.`}{' '}
          Lo que se cotiza aparte se dice antes, nunca a mitad del proyecto.
        </p>
      </div>

      <div class="mt-10 grid gap-4" style="grid-template-columns:repeat(auto-fill,minmax(300px,1fr))">
        {tab.features.map((f, i) => (
          <div class="reveal inc-card flex items-start gap-3.5 rounded-[8px] bg-white p-5" style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <span class="inc-ico grid h-11 w-11 flex-none place-items-center rounded-[13px]">
              <Icono name={f.i} size={20} />
            </span>
            <span class="flex-1 pt-2 text-[15px] font-medium leading-[1.5] text-slate-700">{f.t}</span>
            <span class="mt-2 grid flex-none place-items-center" style="color:#16a34a">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m5 13 4 4L19 7"/></svg>
            </span>
          </div>
        ))}
      </div>

      {/* Los tipos de trabajo que caben en este servicio. Estuvieron un rato en
          /servicios como una sección aparte con cuatro tarjetas, pero ahí eran
          cuatro cajas grandes con cuatro renglones dentro y se veían vacías.
          Aquí valen más: quien llega a esta página ya eligió el servicio y lo
          que necesita saber es si su caso entra o no.

          En pastillas y no en tarjetas a propósito: son etiquetas cortas, no
          contenido con jerarquía propia. Ocupan lo que ocupa su texto. */}
      <div class="reveal mt-8 max-w-[760px] rounded-[10px] bg-white p-6 sm:p-7" style="box-shadow:inset 0 0 0 1px var(--hairline)">
        <h3 class="m-0 font-display text-[15px] font-bold text-dark">
          Qué trabajos entran aquí
        </h3>
        <p class="mt-1.5 text-[14px] leading-[1.6] text-slate-500">
          El precio va por el trabajo que hay que hacer, no por el rubro de tu negocio.
        </p>
        <ul class="m-0 mt-4 flex list-none flex-wrap gap-2 p-0">
          {tab.trabajos.map((trabajo) => (
            <li class="trabajo-chip">{trabajo}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. Precio y plazo -->
  <section class="surface--alt px-6 py-20">
    <div class="w-full max-w-[760px] ml-[max(0px,calc((100%-1120px)/2))]">
      <h2 class="reveal font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
        {servicio.precio.title}
      </h2>

      <div class="reveal mt-7 flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-[10px] bg-white p-6" style="box-shadow:inset 0 0 0 1px var(--hairline)">
        <span class="text-[11px] font-bold text-slate-500">{tab.price === null ? 'Precio' : 'Desde'}</span>
        <span class="font-display text-[2rem] font-extrabold text-dark [font-variant-numeric:tabular-nums]">{tab.priceLabel}</span>
        <span class="text-[14px] text-slate-500">{tab.priceNote ? `${tab.priceNote}, ` : ''}entrega en {tab.time}</span>
      </div>

      <div class="mt-6 grid gap-5">
        {servicio.precio.parrafos.map((p) => (
          <p class="reveal m-0 text-[16.5px] leading-[1.75] text-slate-600 [text-wrap:pretty]">{p}</p>
        ))}
      </div>

      {/* El segundo enlace de esta frase iba a /cuanto-cuesta-una-pagina-web-en-peru/,
          que ya no existe. Lo reemplaza el enlace a los trabajos entregados,
          que es lo que de verdad quiere ver quien está evaluando contratar. */}
      <p class="reveal mt-6 text-[15px] leading-[1.7] text-slate-600">
        Si quieres comparar con las otras formas de trabajar, están todas en
        <a href="/servicios/" class="enlace">la página de servicios</a>, y lo que hemos construido en
        <a href="/proyectos/" class="enlace">proyectos</a>.
      </p>

      <div class="reveal mt-10">
        <p class="m-0 text-[11px] font-bold text-slate-500">Guías relacionadas</p>
        <ul class="m-0 mt-3 grid list-none gap-2.5 p-0">
          {guias.map((g) => (
            <li>
              <a href={`/blog/${g.slug}/`} class="group inline-flex items-start gap-2 text-[15px] font-semibold leading-[1.5] text-dark no-underline hover:text-primary">
                {g.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* Aquí iba "Rubros que más piden este servicio", con tarjeta y foto por cada
      rubro. Se fue con las landings de rubro. El sitio de una fábrica de
      software no lista pollerías: lista proyectos y tecnologías, y eso va en
      /proyectos/. */}

  <!-- 7. Preguntas frecuentes -->
  <section class="surface--alt px-6 py-20">
    <div class="w-full max-w-[760px] ml-[max(0px,calc((100%-1120px)/2))]">
      <h2 class="reveal font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
        Preguntas frecuentes
      </h2>

      <div class="mt-8 grid gap-3">
        {servicio.faqs.map((f) => (
          <details class="lp-faq reveal rounded-[8px] bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between gap-4 font-display text-[16px] font-bold text-dark">
              {f.q}
              <svg class="lp-faq__ico shrink-0 text-primary" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <p class="mt-3 text-[15px] leading-[1.7] text-slate-600 [text-wrap:pretty]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Formulario -->
  <section id="formulario" class="surface px-6 py-20">
    <div class="w-full max-w-[760px] ml-[max(0px,calc((100%-1120px)/2))]">
      <ContactForm
        id="servicio-form"
        context={servicio.enFrase}
        title={`¿Hablamos de tu ${servicio.enFrase}?`}
        subtitle="Déjanos tu nombre, celular y tu pregunta. Te respondemos en menos de 2 horas hábiles."
      />
    </div>
  </section>

  {/* Sin banda de cierre después del formulario. Había una, y la página
      terminaba con "¿Hablamos de tu página web?" seguido de "¿Listo para tu
      página web?": dos veces la misma pregunta, una encima de la otra, con dos
      botones que llevan al mismo WhatsApp.

      Cuando todo pide lo mismo, deja de pedirse nada. El formulario es el mejor
      cierre porque además deja el contacto por escrito, y el botón flotante de
      WhatsApp sigue ahí para quien prefiera escribir directo. */}
</BaseLayout>

<style>
  /* Datos del servicio en línea, sin cápsula: ícono y texto. */
  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    color: #C9CDE0;
  }
  .hero-chip :global(svg) { color: var(--color-maiz); }

  /* ---- Foto de la portada ---- */
  .foto-hero {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    aspect-ratio: 3 / 2;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 40px 80px -40px rgba(0, 0, 0, 0.9);
  }
  /* Velo del color de marca: iguala fotos de fuentes distintas y las integra
     con el fondo oscuro de la portada. */
  .foto-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, rgba(217, 16, 35, 0.22), transparent 58%);
    pointer-events: none;
  }
  .foto-hero picture { display: block; height: 100%; }

  /* ---- El problema ---- */
  .prob-ico {
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 9%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-primary) 18%, transparent);
  }
  .prob-parrafo {
    position: relative;
    overflow: hidden;
    padding-left: 28px;
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .prob-parrafo::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, var(--color-primary), var(--color-accent));
    opacity: 0.55;
  }

  /* ---- Pasos ---- */
  .paso-foto {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    aspect-ratio: 7 / 5;
    background: #eef1f6;
    box-shadow:
      inset 0 0 0 1px var(--hairline),
      0 30px 60px -35px rgba(15, 23, 42, 0.45);
  }
  .paso-foto picture { display: block; height: 100%; }

  .paso-ico {
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 9%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-primary) 18%, transparent);
  }

  /* En escritorio los pasos pares invierten el orden de las columnas. En móvil
     el orden lo marca el HTML: foto arriba, texto abajo, siempre igual. */
  @media (min-width: 1024px) {
    .paso--invertido .paso-foto { order: 2; }
    .paso--invertido .paso-texto { order: 1; }
  }

  /* Pastillas de "qué trabajos entran aquí". Sin caja ni icono: son etiquetas,
     y en cuanto se les pone marco propio compiten con las tarjetas de arriba. */
  .trabajo-chip {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 7px 14px;
    font-size: 13.5px;
    font-weight: 600;
    color: #475569;
    background: #f1f5f9;
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  /* ---- Qué incluye ---- */
  .inc-card {
    box-shadow: inset 0 0 0 1px var(--hairline);
    transition: transform 0.45s var(--ease-fluid), box-shadow 0.45s var(--ease-fluid);
  }
  .inc-card:hover {
    transform: translateY(-3px);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-primary) 35%, transparent),
      0 20px 40px -20px rgba(217, 16, 35, 0.16);
  }
  .inc-ico {
    color: #475569;
    background: #f1f5f9;
    transition: color 0.4s var(--ease-fluid), background 0.4s var(--ease-fluid);
  }
  .inc-card:hover .inc-ico {
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 9%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .inc-card { transition: none; }
  }

  /* Identidad: íconos de un solo color, sin cuadritos tintados; etiquetas
     como lista, no como cápsulas; sin degradados. */
  .prob-ico, .paso-ico, .inc-ico {
    width: auto;
    height: auto;
    background: none !important;
    box-shadow: none !important;
    color: var(--color-grana) !important;
  }
  .prob-parrafo::before { background: var(--color-grana) !important; width: 2px !important; }
  .trabajo-chip {
    border-radius: 0 !important;
    padding: 0 0 0 14px !important;
    background: none !important;
    box-shadow: none !important;
    position: relative;
  }
  .trabajo-chip::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-grana);
  }
</style>
