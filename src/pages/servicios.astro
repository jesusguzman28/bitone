---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Comparativa from '../components/Comparativa.astro';
import Icono from '../components/Icono.astro';
import CTA from '../components/CTA.astro';
import { site, serviciosTabs, condiciones, waLink } from '../data/site';
import { servicioDeTab, hrefServicio } from '../data/servicios';

// ---- Un Service con su Offer por cada servicio ----
// El @id del proveedor apunta a /#org, que es el identificador real que emite
// BaseLayout. Usar /#organization dejaría la referencia colgando contra un nodo
// que no existe en ninguna página del sitio.
const pagina = `${site.domain}/servicios/`;

const schema = serviciosTabs.map((t) => {
  const priceSpecification: Record<string, unknown> = {
    '@type': 'PriceSpecification',
    priceCurrency: 'PEN',
  };
  const offers: Record<string, unknown> = {
    '@type': 'Offer',
    priceCurrency: 'PEN',
    availability: 'https://schema.org/InStock',
    url: `${site.domain}/servicios#${t.id}`,
  };

  if (t.price === null) {
    // Sin precio publicado no se declara ninguno: un precio inventado en el
    // schema es peor que no tenerlo.
    priceSpecification.description = 'Según alcance';
  } else {
    offers.price = String(t.price);
    priceSpecification.minPrice = String(t.price);
  }
  if (t.ivaIncluido !== null) priceSpecification.valueAddedTaxIncluded = t.ivaIncluido;
  offers.priceSpecification = priceSpecification;

  return {
    '@type': 'Service',
    '@id': `${pagina}#${t.schemaId}`,
    name: t.schemaName,
    serviceType: t.serviceType,
    description: t.desc,
    provider: { '@id': `${site.domain}/#org` },
    areaServed: { '@type': 'Country', name: 'Perú' },
    offers,
  };
});
---

<BaseLayout
  title="Servicios: páginas web, tiendas online, ERPs y apps"
  description="Página web profesional con dominio y hosting incluidos, tienda online con pasarelas peruanas, ERPs a medida y apps móviles. Cotización clara en soles."
  schema={schema}
>
  {/* Solo el titular. Se quitaron tres cosas que sobraban antes de llegar a los
      servicios: el rótulo "Servicios", que repetía lo que ya marca el menú de
      arriba; la línea "Todo lo que incluye, sin letra chica"; y el detalle de
      pagos 50/50, que también se quitó de más abajo en esta misma página. */}
  <PageHero title="Servicios de desarrollo web para <span class='gradient-text--warm'>MYPEs en Perú</span>" />

  <!-- Selector de servicio -->
  <section class="surface px-6 pb-12 pt-14">
    <div class="mx-auto w-full max-w-[1120px]">
      <div class="tabs-wrap">
        <div class="tabs-track" role="tablist" aria-label="Servicios">
          {serviciosTabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${t.id}`}
              aria-controls={t.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-tab={t.id}
              class:list={['svc-tab', i === 0 && 'is-active']}
            >{t.label}</button>
          ))}
        </div>
      </div>

      {/* Los cuatro paneles se apilan en la misma celda de una rejilla, así que
          la fila mide lo que mida el más alto y las cuatro tarjetas salen del
          mismo tamaño. El panel que no toca se esconde con `visibility`, no con
          `display:none`: si desapareciera del todo dejaría de contar para la
          altura y volveríamos a tener una tarjeta distinta por pestaña.
          `inert` lo saca del orden de tabulación y del lector de pantalla, que
          es lo que `display:none` hacía gratis. */}
      <div class="svc-panels">
      {serviciosTabs.map((t, i) => (
        <div id={t.id} role="tabpanel" aria-labelledby={`tab-${t.id}`} inert={i !== 0} class:list={['svc-panel', i !== 0 && 'svc-panel--off']}>
          <div class="flip mx-auto mt-10 w-full max-w-[760px]">
            <div class="flip-inner">
              <!-- Cara frontal: el servicio -->
              <div class="flip-face flip-front panel-dark relative overflow-hidden rounded-[28px] p-8 text-center text-white sm:p-9" style="box-shadow:0 30px 60px -30px rgba(14,21,33,0.6)">
                <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full opacity-30 blur-[70px]" style="background:radial-gradient(circle,#D91023,transparent 70%)"></div>

                <span class="relative mx-auto mb-5 grid h-12 w-12 place-items-center rounded-[14px]" style="background:rgba(232,163,23,0.14);color:#E8A317">
                  <Icono name={t.icon} size={22} />
                </span>
                <span class="relative block text-[11px] font-bold uppercase tracking-[0.16em] text-accent">{t.tag}</span>
                <h2 class="relative mt-3 font-display text-[clamp(1.5rem,3vw,2rem)] font-extrabold leading-[1.15] tracking-[-0.02em]">{t.title}</h2>

                {/* El precio tiene que estar a la vista: Google exige que los
                    datos estructurados representen contenido visible, y hasta
                    ahora los precios solo salían en la portada. */}
                <p class="relative mt-4 flex flex-wrap items-baseline justify-center gap-x-2 gap-y-1">
                  <span class="text-[11px] font-medium uppercase tracking-wide text-slate-500">{t.price === null ? 'Precio' : 'Desde'}</span>
                  <span class="font-display text-2xl font-bold text-white [font-variant-numeric:tabular-nums]">{t.priceLabel}</span>
                  {t.priceNote && <span class="text-[13px] text-slate-400">{t.priceNote}</span>}
                </p>

                <p class="relative mx-auto mt-4 max-w-[520px] text-[15px] leading-[1.7] text-slate-400">{t.desc}</p>

                <div class="relative mt-7 grid gap-3 border-t border-white/10 pt-6 sm:grid-cols-2">
                  <div class="flex items-center justify-center gap-3">
                    <span class="grid h-9 w-9 flex-none place-items-center rounded-[12px]" style="background:rgba(232,163,23,0.14);color:#E8A317">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    </span>
                    <div>
                      <div class="text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500">Entrega</div>
                      <div class="font-display text-[15px] font-bold text-white">{t.time}</div>
                    </div>
                  </div>
                  <div class="flex items-center justify-center gap-3">
                    <span class="grid h-9 w-9 flex-none place-items-center rounded-[12px]" style="background:rgba(43,222,114,0.14);color:#2bde72">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 13 4 4L19 7"/></svg>
                    </span>
                    <div>
                      <div class="text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500">Incluido</div>
                      <div class="font-display text-[15px] font-bold text-white">{t.incluye}</div>
                    </div>
                  </div>
                </div>

                {/* Sin enlace a la página del servicio aquí dentro. Estuvo,
                    metido entre el bloque de entrega y los botones, y quedaba
                    como un cajón de más dentro de una tarjeta que ya tenía
                    bastante. El enlace vive ahora en las tarjetas de "Qué entra
                    en cada servicio", más abajo, con un "Ver más" por servicio. */}

                <div class="relative mt-auto flex flex-wrap items-center justify-center gap-3 pt-8">
                  <a href={waLink(t.wa)} target="_blank" rel="noopener" class="btn btn--whatsapp group !py-3 !pl-[26px] !text-[15px]">
                    Cotizar este servicio
                    <span class="btn__icon" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
                    </span>
                  </a>

                  <!-- Va al extremo inferior derecho; el punto late siempre -->
                  <button
                    type="button"
                    data-flip-to="back"
                    aria-label={`Ver qué incluye ${t.label}`}
                    class="flip-controls btn btn--on-dark group relative !px-5 !py-3 !text-[15px]"
                  >
                    <span class="ping" aria-hidden="true"></span>
                    Ver
                    <svg class="flip-ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v5h-5"/>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Cara trasera: qué incluye -->
              <div class="flip-face flip-back rounded-[28px] bg-white p-8 sm:p-9" inert style="box-shadow:inset 0 0 0 1px var(--hairline),0 30px 60px -30px rgba(0,0,0,0.18)">
                <h3 class="flex items-center justify-center gap-3 font-display text-[13px] font-bold uppercase tracking-[0.14em] text-slate-500">
                  <span class="h-[3px] w-7 rounded-full bg-primary"></span>
                  Qué incluye · {t.label}
                </h3>

                <!-- Una sola columna: en dos, el texto se parte en tres líneas
                     y los renglones pierden el ritmo de lectura. -->
                <ul class="m-0 mt-5 grid list-none gap-2.5 p-0">
                  {t.features.map((f, fi) => (
                    <li class="feat-item flex items-center gap-3.5 rounded-[16px] bg-white px-4 py-3.5" style={`--i:${fi}`}>
                      <span
                        class="feat-ico grid h-9 w-9 flex-none place-items-center rounded-[11px]"
                        style={`color:${f.c};background:color-mix(in srgb, ${f.c} 13%, transparent)`}
                      >
                        <Icono name={f.i} size={19} />
                      </span>
                      <span class="flex-1 text-[14px] font-medium leading-[1.45] text-slate-700">{f.t}</span>
                      <span class="grid h-[22px] w-[22px] flex-none place-items-center rounded-full" style="background:rgba(22,163,74,0.1);color:#16a34a">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m5 13 4 4L19 7"/></svg>
                      </span>
                    </li>
                  ))}
                </ul>

                <div class="flip-controls mt-auto flex flex-wrap items-center gap-3 pt-8">
                  <button type="button" data-flip-to="front" class="btn btn--ghost group !px-6 !py-3 !text-[15px]">
                    <svg class="flip-ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 3v5h5"/>
                    </svg>
                    Volver
                  </button>
                  <a href={waLink(t.wa)} target="_blank" rel="noopener" class="btn btn--whatsapp group !py-3 !pl-[26px] !text-[15px]">
                    Cotizar este servicio
                    <span class="btn__icon" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
                    </span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
      </div>
    </div>
  </section>

  {/* Los tipos de trabajo de cada servicio, y el camino a su página propia.

      El "Ver más" va aquí y no dentro de la tarjeta oscura de arriba. Allí era
      un cajón de más en una tarjeta que ya tenía icono, título, precio, plazo y
      dos botones. Aquí cierra la tarjeta: primero lees qué trabajos entran, y si
      el tuyo está, el enlace te lleva al detalle completo.

      Es además el único enlace interno hacia las cuatro páginas de servicio. Sin
      él se rastrean mucho menos. */}
  <section class="surface--alt px-6 py-20" aria-labelledby="trabajos-servicios">
    <div class="mx-auto w-full max-w-[1120px]">
      <div class="reveal mx-auto max-w-[640px] text-center">
        <span class="eyebrow eyebrow--light">Tipos de trabajo</span>
        <h2 id="trabajos-servicios" class="mt-5 font-display text-[clamp(1.6rem,3.6vw,2.2rem)] font-extrabold leading-[1.18] text-dark">
          Qué entra en cada servicio
        </h2>
        <p class="mt-4 text-[15px] leading-[1.65] text-slate-500 [text-wrap:pretty]">
          El precio va por el trabajo que hay que hacer, no por el rubro de tu negocio.
        </p>
      </div>

      <div class="mt-10 grid gap-5" style="grid-template-columns:repeat(auto-fit,minmax(250px,1fr))">
        {serviciosTabs.map((t, i) => {
          const servicio = servicioDeTab(t.id);
          return (
            /* Columna con el enlace pegado abajo (`mt-auto`). Las cuatro tarjetas
               miden lo mismo porque la rejilla las estira, y antes eso dejaba un
               hueco blanco al final de las más cortas. Con el "Ver más" anclado
               al pie, ese hueco pasa a ser el aire que separa la lista del
               enlace, y las cuatro terminan en la misma línea. */
            <div class="reveal flex flex-col rounded-[20px] bg-white p-6" style={`--reveal-delay:${(i % 4) * 70}ms;box-shadow:inset 0 0 0 1px var(--hairline)`}>
              <a href={`#${t.id}`} class="font-display text-[15px] font-bold text-dark no-underline">{t.label}</a>
              <ul class="m-0 mt-4 grid list-none gap-2.5 p-0">
                {t.trabajos.map((trabajo) => (
                  <li class="flex items-start gap-2.5 text-[14px] leading-[1.45] text-slate-600">
                    <span class="mt-[7px] h-1.5 w-1.5 flex-none rounded-full bg-primary" aria-hidden="true"></span>
                    {trabajo}
                  </li>
                ))}
              </ul>

              {servicio && (
                <a href={hrefServicio(servicio.slug)} class="ver-mas mt-auto flex items-center gap-1.5 pt-5 text-[14px] font-bold text-primary no-underline">
                  Ver más
                  <svg class="ver-mas__flecha" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                  <span class="sr-only">sobre {t.label}</span>
                </a>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>


  {/* Las condiciones comerciales, en una línea.

      Estuvieron como una banda de cuatro tarjetas con icono, y se quitó porque
      pesaba demasiado para lo que dice. Pero al sacarla, esta página dejó de
      decir cómo se paga, que hay boleta o factura y que el código queda a nombre
      del cliente: justo los cuatro miedos de quien contrata a una empresa chica
      y no la conoce. Callarlos no los borra, solo los deja sin responder.

      Vuelven en el peso que les toca: un renglón bajo los servicios, con los
      cuatro títulos separados por puntos. Los textos largos siguen en
      `condiciones` (site.ts) por si alguna vez se quieren desarrollar. */}
  <section class="surface--alt px-6 pb-16">
    <p class="reveal mx-auto flex max-w-[900px] flex-wrap items-center justify-center gap-x-3 gap-y-2 text-center text-[14px] font-medium text-slate-600">
      {condiciones.map((c, i) => (
        <>
          {i > 0 && <span class="text-slate-300" aria-hidden="true">·</span>}
          <span class="inline-flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
            {c.title}
          </span>
        </>
      ))}
    </p>
  </section>

  <Comparativa />
  <CTA />
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLElement>('.svc-tab');
  const panels = document.querySelectorAll<HTMLElement>('.svc-panel');

  const activate = (id: string) => {
    if (!Array.from(panels).some((p) => p.id === id)) return false;
    panels.forEach((p) => {
      const on = p.id === id;
      p.classList.toggle('svc-panel--off', !on);
      p.toggleAttribute('inert', !on);
      // al cambiar de servicio la tarjeta vuelve a mostrar su cara frontal
      const flip = p.querySelector<HTMLElement>('.flip');
      if (flip) {
        flip.classList.remove('is-flipped');
        const caras = flip.querySelectorAll<HTMLElement>('.flip-face');
        caras[0]?.removeAttribute('inert');
        caras[1]?.setAttribute('inert', '');
      }
      if (on) {
        // reinicia la animación de entrada del panel y el escalonado de la lista
        p.classList.remove('panel-in');
        void p.offsetWidth;
        p.classList.add('panel-in');
      }
    });
    tabs.forEach((t) => {
      const on = t.dataset.tab === id;
      t.classList.toggle('is-active', on);
      t.setAttribute('aria-selected', String(on));
      if (on) t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    });
    return true;
  };

  tabs.forEach((t) => {
    t.addEventListener('click', () => {
      const id = t.dataset.tab!;
      activate(id);
      history.replaceState(null, '', `#${id}`);
    });
  });

  // ---- Volteo de la tarjeta (solo hasta 1023px) ----
  // Desde 1024px las dos caras se ven a la vez, así que ninguna puede quedar
  // con `inert`: es un atributo del DOM y el CSS no lo puede revertir.
  const anchas = window.matchMedia('(min-width: 1024px)');

  document.querySelectorAll<HTMLElement>('.flip').forEach((flip) => {
    const [frente, dorso] = Array.from(flip.querySelectorAll<HTMLElement>('.flip-face'));

    const sincronizar = (mueveFoco = false) => {
      if (anchas.matches) {
        flip.classList.remove('is-flipped');
        frente.removeAttribute('inert');
        dorso.removeAttribute('inert');
        return;
      }
      const enDorso = flip.classList.contains('is-flipped');
      frente.toggleAttribute('inert', enDorso);
      dorso.toggleAttribute('inert', !enDorso);
      if (mueveFoco) {
        (enDorso ? dorso : frente).querySelector<HTMLElement>('button, a')?.focus({ preventScroll: true });
      }
    };

    const inner = flip.querySelector<HTMLElement>('.flip-inner')!;
    let limpieza: number;

    // El 3D solo vive mientras dura el giro: al terminar se apaga para que el
    // navegador vuelva a dibujar texto nítido en vez de una textura escalada.
    const apagar3D = () => {
      clearTimeout(limpieza);
      // Quitar is-animating elimina el rotateY(180deg) del contenedor. Si la
      // transición sigue viva, el navegador ANIMA ese regreso a 0 y se ve un
      // segundo giro. Hay que apagarla mientras se hace el cambio.
      inner.style.transition = 'none';
      flip.classList.remove('is-animating');
      void inner.offsetWidth;
      inner.style.transition = '';
    };
    inner.addEventListener('transitionend', (e) => {
      if (e.propertyName === 'transform') apagar3D();
    });

    flip.querySelectorAll<HTMLElement>('[data-flip-to]').forEach((btn) => {
      btn.addEventListener('click', () => {
        clearTimeout(limpieza);

        // Al encender el 3D estando ya volteada, la regla .is-animating.is-flipped
        // aplica rotateY(180deg) y la transición lo ANIMARÍA de 0 a 180 justo
        // cuando además quitamos is-flipped: son dos giros peleándose y se ve el
        // efecto raro. Apagamos la transición para fijar el punto de partida y la
        // reactivamos recién antes del giro real.
        inner.style.transition = 'none';
        flip.classList.add('is-animating');
        void inner.offsetWidth;
        inner.style.transition = '';

        flip.classList.toggle('is-flipped', btn.dataset.flipTo === 'back');
        sincronizar(true);
        // red de seguridad si transitionend no llega (reduced motion, pestaña oculta)
        limpieza = window.setTimeout(apagar3D, 900);
      });
    });

    anchas.addEventListener('change', () => sincronizar());
    sincronizar();
  });

  const fromHash = (scroll = false) => {
    const id = location.hash.slice(1);
    if (!id || !activate(id)) return;
    if (scroll) document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
  fromHash(true);
  addEventListener('hashchange', () => fromHash(true));
</script>

<style>
  /* ---- Pestañas: en móvil una sola fila deslizable, nunca partida en dos ---- */
  .tabs-wrap {
    margin-inline: -24px;
    padding-inline: 24px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent);
  }
  .tabs-wrap::-webkit-scrollbar { display: none; }

  .tabs-track {
    display: inline-flex;
    gap: 6px;
    padding: 6px;
    border-radius: 999px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  @media (min-width: 768px) {
    .tabs-wrap { display: flex; justify-content: center; }
  }

  .svc-tab {
    white-space: nowrap;
    border: 0;
    cursor: pointer;
    border-radius: 999px;
    padding: 10px 20px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: #475569;
    background: transparent;
    transition: color 0.35s var(--ease-fluid), background 0.35s var(--ease-fluid), box-shadow 0.35s var(--ease-fluid);
  }
  .svc-tab:hover { color: var(--color-primary); }
  .svc-tab.is-active {
    color: #fff;
    background: var(--gradient-brand);
    box-shadow: 0 10px 25px -5px rgba(217, 16, 35, 0.45);
  }

  /* ---- Tarjeta que voltea: solo hasta tablet ----
     En pantallas chicas las dos mitades no caben lado a lado, así que se
     apilan en una tarjeta de dos caras. Desde 1024px se muestran juntas. */
  .flip-inner {
    display: grid;
    transition: transform 0.75s cubic-bezier(0.32, 0.72, 0, 1);
  }

  /* Las dos caras comparten celda: la altura la marca la más alta y la tarjeta
     no da saltos al voltear. */
  .flip-face {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
  }

  /* Todo el mecanismo del volteo vive solo bajo 1024px. Acotarlo aquí evita
     pelearse por especificidad con el layout de escritorio. */
  @media (max-width: 1023px) {
    /* En reposo NO hay 3D: sin preserve-3d ni backface, el navegador dibuja el
       texto como texto y no como una textura reescalada (eso era lo que
       pixelaba las tarjetas en el celular). Solo se decide qué cara se ve. */
    .flip:not(.is-animating) .flip-back { visibility: hidden; }
    .flip.is-flipped:not(.is-animating) .flip-front { visibility: hidden; }
    .flip.is-flipped:not(.is-animating) .flip-back { visibility: visible; }

    /* El 3D se enciende solo mientras dura el giro y se apaga al terminar */
    .flip.is-animating { perspective: 1800px; }
    .flip.is-animating .flip-inner { transform-style: preserve-3d; }
    .flip.is-animating .flip-face {
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
