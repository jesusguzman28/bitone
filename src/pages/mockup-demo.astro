---
import BaseLayout from '../layouts/BaseLayout.astro';
import DeviceMockup from '../components/DeviceMockup.astro';
import DeviceMockupLive from '../components/DeviceMockupLive.astro';
import DeviceVideo from '../components/DeviceVideo.astro';
---

<BaseLayout title="Demo mockup animado" description="Prueba interna de mockup animado ligero.">
  <section class="section-dark py-24 sm:py-32">
    <div class="section">
      <p class="eyebrow">Prueba interna</p>
      <h1 class="mt-4 font-display text-3xl font-bold text-white sm:text-4xl">
        Mockup animado <span class="gradient-text">sin video</span>
      </h1>
      <p class="mt-3 max-w-xl text-slate-300">
        Imagen WebP (~82&nbsp;KB) con Ken Burns + brillo de pantalla en CSS puro. Cero
        video, respeta <code>prefers-reduced-motion</code>.
      </p>

      <p class="mb-6 text-sm font-semibold text-accent">★ Compara las 3 calidades (horizontal)</p>
      <div class="grid gap-8 lg:grid-cols-3">
        <div>
          <p class="mb-3 text-xs font-semibold text-emerald-400">HD — nítido (1.58&nbsp;MB)</p>
          <DeviceVideo variant="h" quality="hd" />
        </div>
        <div>
          <p class="mb-3 text-xs font-semibold text-amber-400">MEDIO — equilibrio (818&nbsp;KB)</p>
          <DeviceVideo variant="h" quality="med" />
        </div>
        <div>
          <p class="mb-3 text-xs font-semibold text-slate-400">LITE — móvil (104&nbsp;KB)</p>
          <DeviceVideo variant="h" quality="lite" />
        </div>
      </div>

      <hr class="my-16 border-white/10" />

      <p class="mb-6 text-sm font-semibold text-accent">Vista CELULAR — a ancho de teléfono real (~375&nbsp;px)</p>
      <div class="flex flex-wrap items-start justify-center gap-8">
        <div class="w-full max-w-[375px]">
          <p class="mb-3 text-center text-xs font-semibold text-slate-400">Horizontal MEDIO</p>
          <DeviceVideo variant="h" quality="med" />
        </div>
        <div class="w-full max-w-[220px]">
          <p class="mb-3 text-center text-xs font-semibold text-slate-400">Vertical MEDIO</p>
          <DeviceVideo variant="v" quality="med" />
        </div>
      </div>

      <hr class="my-16 border-white/10" />
      <p class="mb-8 text-sm font-semibold text-slate-400">Opción B — pantalla HTML viva (referencia, 0 video)</p>
      <DeviceMockupLive />

      <hr class="my-16 border-white/10" />
      <p class="mb-8 text-sm font-semibold text-slate-400">Opción A — imagen fija con Ken Burns (referencia)</p>

      <div class="mt-4 grid items-center gap-10 lg:grid-cols-[1.6fr_1fr]">
        <div>
          <p class="mb-3 text-sm font-semibold text-slate-400">Horizontal (16:9)</p>
          <DeviceMockup variant="h" />
        </div>
        <div class="mx-auto w-full max-w-[300px]">
          <p class="mb-3 text-sm font-semibold text-slate-400">Vertical (9:16)</p>
          <DeviceMockup variant="v" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
