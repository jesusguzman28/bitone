---
// Sistema a medida. Una sola idea: el sistema se arma por partes y tú eliges la primera.
// Orden: la portada · el tocapu de las partes, con "cada parte" (tinta) · cuándo basta un
// programa ya hecho · qué te llevas y dos sistemas ya hechos (rojo, hoja) · preguntas · cierre.
// Ninguna sección repite el esquema de la anterior: texto y dibujo, título a todo el
// ancho con dos listas, hoja y título, título y preguntas.
// El proceso y el dinero viven en /como-trabajamos/: aquí el precio se nombra una vez y
// dos enlaces mandan allá, bajo "Cada parte" y bajo las preguntas (el remate de Dudas).
import Base from '../layouts/Base.astro';
import PortadaInterior from '../components/PortadaInterior.astro';
import PartesTocapu from '../components/sistemas/PartesTocapu.astro';
import Rotulo from '../components/Rotulo.astro';
import Hoja from '../components/Hoja.astro';
import FilaLibro from '../components/FilaLibro.astro';
import Franqueza from '../components/Franqueza.astro';
import DosListas from '../components/DosListas.astro';
import Dudas from '../components/Dudas.astro';
import CierreWhatsApp from '../components/CierreWhatsApp.astro';
import Icono from '../components/Icono.astro';
import { mensajes, notaDeLaHoja } from '../data/empresa';
import { paginas, existe } from '../data/navegacion';
import { enTexto } from '../data/proyectos';
import { sistemas as d } from '../data/sistemas';

const pagina = paginas.sistemas;
const aFondo = existe(paginas.comoTrabajamos.ruta);
// La prueba de esta página: los dos sistemas a medida ya hechos. Son de uso interno,
// así que van en texto, sin captura y sin enlace (data/proyectos.ts).
const hechos = enTexto.filter((p) => p.acceso === 'interno');
---

<Base
  titulo="Sistema a medida para tu negocio"
  descripcion="Pedidos, almacén, ventas o cobranzas en un solo sistema, hecho para cómo trabaja tu negocio. Se empieza por una parte y queda a tu nombre."
  signo={pagina.signo}
  mensajeWhatsApp={mensajes.sistema}
>
  <PortadaInterior signo={pagina.signo} tonoDeAbajo="tinta" tono="rojo" rotulo={pagina.nombre} titulo={d.portada.titulo} entrada={d.portada.entrada} mensaje={mensajes.sistema} textoBoton={d.portada.boton} />

  <!-- 1 · El tocapu de las partes: se elige por cuál se empieza -->
  <section class="seccion plano plano--tinta partes" id="partes" aria-labelledby="t-partes">
    <PartesTocapu id="t-partes" rotulo={d.partes.rotulo} titulo={d.partes.titulo} entrada={d.partes.entrada} leyenda={d.partes.leyenda} partes={d.partes.lista} todo={d.partes.todo} />

    <!-- Cómo va cada parte. Aquí se nombra el precio, una sola vez -->
    <div class="reticula cada">
      <h3 class="subtitulo cada__t">{d.cadaParte.titulo}</h3>
      <ol class="cada__puntos">
        {d.cadaParte.puntos.map((p, i) => <li data-rev><span class="rotulo" aria-hidden="true">{i + 1}</span><p>{p}</p></li>)}
      </ol>
      {aFondo && (
        <a class="enlace cada__ir" href={paginas.comoTrabajamos.ruta}>{d.enlacePrecio}<Icono nombre="derecha" /></a>
      )}
    </div>
  </section>

  <!-- 2 · Cuándo no conviene -->
  <section class="seccion" aria-labelledby="t-franca">
    <Franqueza id="t-franca" titulo={d.franca.titulo} texto={d.franca.texto}>
      <DosListas a={d.franca.listas.a} b={d.franca.listas.b} />
    </Franqueza>
  </section>

  <!-- 3 · Qué te llevas: la hoja a la izquierda y, a la derecha, el titular arriba y la
       prueba abajo, asentada en el pie de la hoja -->
  <section class="plano plano--rojo llevas" aria-labelledby="t-llevas">
    <div class="reticula llevas__r">
      <div class="llevas__txt">
        <Rotulo>{d.teLlevas.rotulo}</Rotulo>
        <h2 class="titulo titulo--mayor llevas__t" id="t-llevas">{d.teLlevas.titulo.map((r, i) => <><span class="renglon">{r}</span>{i === 0 && ' '}</>)}</h2>
        <p class="entrada">{d.teLlevas.entrada}</p>
      </div>
      <Hoja id="t-hoja" titulo={d.teLlevas.hoja.titulo} rotulo={d.teLlevas.hoja.rotulo} clausulas={d.teLlevas.clausulas} nota={`${notaDeLaHoja} ${d.teLlevas.nota}`} sinFirmas class="llevas__hoja" data-rev />

      <!-- La prueba: lo que ya se hizo, en texto. Lo que se puede abrir está en /proyectos/ -->
      <div class="llevas__hechos">
        <Rotulo como="h3">{d.hechos.rotulo}</Rotulo>
        <ul class="libro libro--nota llevas__libro">
          {hechos.map((p) => <FilaLibro titulo={p.nombre} rotulo={p.tipo} nivel={4} acento>{p.resumen}</FilaLibro>)}
        </ul>
        <p class="menor llevas__nota">{d.hechos.nota}</p>
        {existe(paginas.proyectos.ruta) && (
          <a class="enlace" href={paginas.proyectos.ruta}>{d.hechos.enlace}<Icono nombre="derecha" /></a>
        )}
      </div>
    </div>
  </section>

  <!-- 4 · Preguntas, con su remate: la pregunta que falta, cuánto cuesta y cuánto
       demora, se responde en /como-trabajamos/. Sin filete: viene de un plano rojo. -->
  <Dudas titulo="Antes de pedir un sistema." preguntas={d.dudas} grupo="sistemas" sinFilete>
    {aFondo && <a class="enlace" href={paginas.comoTrabajamos.ruta}>{d.enlacePrecio}<Icono nombre="derecha" /></a>}
  </Dudas>

  <CierreWhatsApp interes={d.portada.interes} ejemplo={d.portada.ejemplo} general={mensajes.sistema} />
</Base>

<style>
  /* ---------- 1 · cada parte: el título a la izquierda y tres renglones desde el módulo 9,
     el mismo eje de las opciones que tiene encima ---------- */
  .cada { align-items: start; margin-top: calc(var(--u) * 1.05); padding-top: calc(var(--u) * .34); border-top: 1px solid var(--filete-fuerte); }
  .cada__t { grid-column: 1 / 8; }
  .cada__puntos { grid-column: 9 / -1; }
  .cada__puntos li { display: grid; grid-template-columns: 1.9em minmax(0, 1fr); align-items: baseline; padding-block: 13px; border-bottom: 1px solid var(--filete); }
  .cada__puntos li:first-child { padding-top: 2px; }
  .cada__puntos .rotulo { color: var(--texto-2); }
  .cada__puntos p { font-weight: 600; font-size: var(--t-entrada); line-height: 1.3; letter-spacing: -.012em; }
  /* El enlace va bajo los renglones: el primero es el que habla del precio. */
  .cada__ir { grid-column: 9 / -1; margin-top: 8px; }

  /* ---------- 3 · qué te llevas ---------- */
  .llevas { padding-block: calc(var(--aire) * 1.05) calc(var(--aire) * 1.15); overflow: clip; }
  /* Dos filas a la derecha: el titular y, en lo que sobra hasta el pie de la hoja, la prueba. */
  .llevas__r { align-items: start; grid-template-rows: auto 1fr; }
  .llevas__txt { grid-column: 9 / -1; grid-row: 1; }
  .llevas__t { margin-top: clamp(14px, calc(var(--u) * .28), 26px); }
  .llevas__txt .entrada { margin-top: clamp(16px, calc(var(--u) * .3), 28px); max-width: 23em; }
  .llevas :global(.llevas__hoja) { grid-column: 1 / 8; grid-row: 1 / span 2; }
  .llevas__hechos { grid-column: 9 / -1; grid-row: 2; align-self: end; margin-top: var(--aire-corto); }
  .llevas__libro { margin-top: 12px; }
  .llevas__nota { margin-top: 12px; }
  .llevas__hechos .enlace { margin-top: 2px; }
  /* El titular más grande de la página: en escritorio sube a cartel menor (.titulo--mayor),
     pero con el ancho de letra de un título: así "a tu nombre." ocupa nueve décimas de su
     mitad y no se parte. */
  @media (min-width: 960px) {
    .llevas__t { font-stretch: var(--ancho-titulo); }
    .llevas__t .renglon { white-space: nowrap; }
  }

  @media (max-width: 959px) {
    .cada__t, .cada__ir, .cada__puntos { grid-column: 1 / -1; }
    .cada__puntos { margin-top: calc(var(--u) * .3); border-top: 1px solid var(--filete); }
    .cada__puntos li:first-child { padding-top: 13px; }

    .llevas__r { grid-template-rows: none; }
    .llevas__txt, .llevas :global(.llevas__hoja), .llevas__hechos { grid-column: 1 / -1; grid-row: auto; }
    .llevas__txt { margin-bottom: calc(var(--u) * .6); }
    /* Bajo la hoja: el aire cuenta desde su segunda hoja, la que asoma detrás. */
    .llevas__hechos { align-self: start; margin-top: calc(var(--aire-corto) + 14px); }
  }
  @media (max-width: 699px) {
    .cada { margin-top: 30px; padding-top: 16px; }
    .cada__puntos { margin-top: 8px; }
    .cada__puntos li { grid-template-columns: 1.7em minmax(0, 1fr); padding-block: 11px; }
    .cada__puntos li:first-child { padding-top: 11px; }
    .cada__puntos p { font-size: var(--t-texto); line-height: 1.35; }
    .cada__ir { margin-top: 4px; }

    .llevas { padding-block: var(--aire) calc(var(--aire) * 1.3); }
    .llevas__txt { margin-bottom: 20px; }
    .llevas__txt .entrada { margin-top: 12px; }
    .llevas__hechos { margin-top: 36px; }
    .llevas__libro { margin-top: 8px; }
    .llevas__nota { margin-top: 10px; }
  }
</style>
