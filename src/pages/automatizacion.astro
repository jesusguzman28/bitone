---
// Automatización: lo que hoy se hace a mano, se hace solo. Incluye conectar sistemas
// que ya existen. Una sola idea por sección y ninguna repite el esquema de la anterior:
//   1 · portada, con un enlace que baja a la cuenta
//   2 · cuatro tareas, en un libro de tres columnas: hoy, se hace solo, pasa a una
//       persona. Remata con un camino a lo construido (/proyectos/)
//   3 · la cuenta (tinta): el momento propio. Tus horas a la semana, en horas al año
//   4 · cómo se hace, por pasos. El remate dice que el paso 1 se paga y enlaza al precio
//   5 · la IA: dos campos, lo que hace sola (rojo) y lo que decide una persona
//   6 · preguntas (con lo que cobran otros) y cierre
// Las tres piezas propias viven en components/automatizacion/; los textos, en
// data/automatizacion.ts.
import Base from '../layouts/Base.astro';
import PortadaInterior from '../components/PortadaInterior.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import PasosTocapu from '../components/PasosTocapu.astro';
import Dudas from '../components/Dudas.astro';
import CierreWhatsApp from '../components/CierreWhatsApp.astro';
import Icono from '../components/Icono.astro';
import Casos from '../components/automatizacion/Casos.astro';
import Cuenta from '../components/automatizacion/Cuenta.astro';
import QuienDecide from '../components/automatizacion/QuienDecide.astro';
import { mensajes } from '../data/empresa';
import { paginas, existe, destino } from '../data/navegacion';
import { automatizacion as d } from '../data/automatizacion';

const pagina = paginas.automatizacion;
---

<Base
  titulo="Automatización de procesos para tu empresa"
  descripcion="El reporte del lunes, el WhatsApp de la empresa, las facturas que alguien digita: un proceso a la vez, conectado a lo que ya usas."
  signo={pagina.signo}
  mensajeWhatsApp={mensajes.automatizacion}
>
  <PortadaInterior signo={pagina.signo} tono="arena" rotulo={pagina.nombre} titulo={d.portada.titulo} entrada={d.portada.entrada} mensaje={mensajes.automatizacion} textoBoton={d.portada.boton}>
    <a class="enlace" href="#cuenta">{d.portada.enlace}<Icono nombre="abajo" /></a>
  </PortadaInterior>

  <!-- 1 · Cuatro tareas: hoy, se hace solo y pasa a una persona. En pila: la entrada es
       la clave de lectura y no deja una nota en el módulo 12 sobre la columna del 13.
       El remate abre lo construido: la prueba se abre, no se cuenta. -->
  <section class="seccion" id="casos" aria-labelledby="t-casos">
    <TituloSeccion id="t-casos" disposicion="pila" titulo={d.casos.titulo} entrada={d.casos.entrada} />
    <Casos casos={d.casos.lista} columnas={d.casos.columnas} />
    <p class="reticula remate"><a class="enlace" href={destino(paginas.proyectos)}>{d.casos.enlace}<Icono nombre="derecha" /></a></p>
  </section>

  <!-- 2 · La cuenta: tus horas a la semana, en horas al año -->
  <Cuenta id="cuenta" />

  <!-- 3 · Cómo se hace. Sin entrada: las dos secciones de antes ya abren con titular y
       párrafo. El remate dice que el paso 1 se paga y manda a /como-trabajamos/ -->
  <section class="seccion" id="como" aria-labelledby="t-como">
    <TituloSeccion id="t-como" disposicion="pila" rotulo={d.como.rotulo} titulo={d.como.titulo} />
    <PasosTocapu pasos={d.fases} signo={pagina.signo} />
    <div class="reticula remate">
      <p class="menor suave">{d.notaPaso1}</p>
      {existe(paginas.comoTrabajamos.ruta) && (
        <a class="enlace" href={paginas.comoTrabajamos.ruta}>{d.enlacePrecio}<Icono nombre="derecha" /></a>
      )}
    </div>
  </section>

  <!-- 4 · La IA: qué hace sola y qué decide una persona -->
  <QuienDecide id="ia" />

  <Dudas titulo="Antes de automatizar." preguntas={d.dudas} grupo="automatizacion" />

  <CierreWhatsApp interes={d.portada.interes} ejemplo={d.portada.ejemplo} general={mensajes.automatizacion} />
</Base>
