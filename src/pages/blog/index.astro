---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
import { blog, blogCats, catLabel } from '../../data/site';

const posts = [...blog].sort((a, b) => b.date.localeCompare(a.date));
const featured = posts.find((p) => p.featured) ?? posts[0];
const rest = posts.filter((p) => p.slug !== featured.slug);
const usedCats = blogCats.filter((c) => posts.some((p) => p.category === c.slug));
const fmt = (d: string) =>
  new Date(d + 'T12:00:00').toLocaleDateString('es-PE', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout
  title="Blog: guías digitales para pymes peruanas"
  description="Guías prácticas para negocios peruanos: cuánto cuesta una web, cómo cobrar con billeteras digitales, SEO local, chatbots con IA y más."
>
  <PageHero
    eyebrow="Blog"
    title="Guías digitales para <span class='gradient-text--warm'>tu negocio</span>"
    subtitle="Sin tecnicismos: precios reales, cómo cobrar online, aparecer en Google y usar IA en tu pyme."
    compact
  />

  <section class="surface px-6 pb-24 pt-16">
    <div class="mx-auto w-full max-w-[1120px]">
      <!-- Artículo destacado -->
      <h2 class="section-label">Artículo destacado</h2>
      <a href={`/blog/${featured.slug}`} class="feature-card reveal mt-5 grid overflow-hidden rounded-[28px] bg-white no-underline">
        <div class="relative overflow-hidden bg-slate-100">
          <img src={featured.image} alt={featured.title} class="feature-img h-full w-full object-cover" style="min-height:280px" />
          <span class="cat-badge absolute left-4 top-4">{catLabel(featured.category)}</span>
        </div>
        <div class="flex flex-col justify-center p-8 sm:p-10">
          <span class="inline-flex w-fit items-center gap-1.5 rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-[0.1em] text-white" style="background:var(--gradient-brand)">
            ★ Destacado
          </span>
          <h3 class="mt-4 font-display text-[clamp(1.4rem,3vw,2rem)] font-extrabold leading-[1.2] text-dark [text-wrap:pretty]">{featured.title}</h3>
          <p class="mt-3 text-[15px] leading-[1.65] text-slate-500">{featured.excerpt}</p>

          <div class="mt-6 flex flex-wrap items-center gap-3 text-[13px] text-slate-500">
            <span class="grid h-9 w-9 place-items-center rounded-full font-display text-sm font-bold text-white" style="background:var(--gradient-brand)">B</span>
            <span class="font-semibold text-dark">{featured.author}</span>
            <span class="text-slate-300">·</span>
            <span>{fmt(featured.date)}</span>
            <span class="text-slate-300">·</span>
            <span>{featured.readTime} de lectura</span>
          </div>

          <span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-primary">
            Leer artículo completo
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
          </span>
        </div>
      </a>

      <!-- Filtro -->
      <div class="mt-14 flex flex-wrap items-center justify-between gap-4">
        <h2 class="section-label !mt-0">Últimos artículos</h2>
        <div class="flex flex-wrap gap-2">
          <button type="button" data-cat="todos" class="blog-filter pill-tab is-active">Todos</button>
          {usedCats.map((c) => (
            <button type="button" data-cat={c.slug} class="blog-filter pill-tab">{c.label}</button>
          ))}
        </div>
      </div>

      <div class="mt-6 grid gap-6" style="grid-template-columns:repeat(auto-fill,minmax(320px,1fr))">
        {rest.map((p, i) => (
          <article class="blog-item reveal" data-cat={p.category} style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <a href={`/blog/${p.slug}`} class="post-card flex h-full flex-col overflow-hidden rounded-[20px] bg-white no-underline">
              <div class="relative overflow-hidden bg-slate-100" style="aspect-ratio:16/9">
                <img src={p.image} alt={p.title} loading="lazy" class="post-img h-full w-full object-cover" />
                <span class="cat-badge absolute left-3 top-3">{catLabel(p.category)}</span>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h3 class="font-display text-[18px] font-bold leading-[1.3] text-dark [text-wrap:pretty]">{p.title}</h3>
                <p class="mt-2.5 text-[14px] leading-[1.6] text-slate-500">{p.excerpt}</p>
                <div class="mt-auto flex items-center gap-2 pt-5 text-[12.5px] text-slate-400">
                  <span>{fmt(p.date)}</span><span class="text-slate-300">·</span><span>{p.readTime}</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTA
    title="¿Quieres aplicarlo en tu negocio?"
    subtitle="Te asesoramos gratis por WhatsApp, sin compromiso. Cotización clara en soles en menos de 24 horas."
  />
</BaseLayout>

<script>
  const btns = document.querySelectorAll<HTMLElement>('.blog-filter');
  const items = document.querySelectorAll<HTMLElement>('.blog-item');
  btns.forEach((b) =>
    b.addEventListener('click', () => {
      const cat = b.dataset.cat;
      btns.forEach((x) => x.classList.remove('is-active'));
      b.classList.add('is-active');
      items.forEach((it) => {
        const show = cat === 'todos' || it.dataset.cat === cat;
        it.style.display = show ? '' : 'none';
        if (show) {
          it.classList.remove('anim-in');
          void it.offsetWidth;
          it.classList.add('anim-in');
        }
      });
    })
  );
</script>

<style>
  /* Rótulo de sección con guion rojo, como en producción */
  .section-label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #64748b;
  }
  .section-label::before {
    content: "";
    width: 26px;
    height: 3px;
    border-radius: 999px;
    background: var(--color-primary);
  }

  .cat-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: 999px;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-dark);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .feature-card,
  .post-card {
    box-shadow: inset 0 0 0 1px var(--hairline), 0 10px 25px -5px rgba(0, 0, 0, 0.08);
    transition: transform 0.5s var(--ease-fluid), box-shadow 0.5s var(--ease-fluid);
  }
  .feature-card:hover,
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: inset 0 0 0 1px var(--hairline-strong), 0 25px 50px -12px rgba(0, 0, 0, 0.15);
  }
  .feature-img,
  .post-img { transition: transform 1s var(--ease-fluid); }
  .feature-card:hover .feature-img,
  .post-card:hover .post-img { transform: scale(1.04); }

  @media (min-width: 900px) {
    .feature-card { grid-template-columns: 1fr 1fr; }
  }
</style>
