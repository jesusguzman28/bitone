---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blog, site, waLink, catLabel } from '../../data/site';
import { rubros, anchorRubro } from '../../data/rubros';
import { hrefRubro } from '../../data/landings';

export function getStaticPaths() {
  return blog.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const fmt = (d: string) =>
  new Date(d + 'T12:00:00').toLocaleDateString('es-PE', { day: 'numeric', month: 'long', year: 'numeric' });
const related = blog.filter((p) => p.slug !== post.slug).slice(0, 2);
const rubrosDelPost = (post.rubros ?? [])
  .map((slug) => rubros.find((r) => r.slug === slug))
  .filter((r): r is (typeof rubros)[number] => Boolean(r));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  dateModified: post.date,
  author: { '@type': 'Organization', name: site.legalName },
  publisher: { '@type': 'Organization', name: site.legalName, url: site.domain },
  mainEntityOfPage: `${site.domain}/blog/${post.slug}`,
  image: `${site.domain}${post.image}`,
  keywords: post.keywords.join(', '),
};
---

<BaseLayout title={post.title} description={post.excerpt} breadcrumbLabel={post.title} image={post.image}>
  <article class="surface px-6 pb-24 pt-[130px]">
    <div class="mx-auto w-full max-w-[720px]">
      <a href="/blog" class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-[18px] py-2 text-[13px] font-semibold text-slate-600 no-underline transition-colors duration-300 hover:bg-slate-200">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M19 12H5m6 6-6-6 6-6"/></svg>
        Volver al blog
      </a>

      <div class="mt-7 flex flex-wrap items-center gap-2.5 text-xs font-semibold text-slate-400">
        <span class="rounded-full px-3 py-1 text-primary" style="background:rgba(217,16,35,0.08)">{catLabel(post.category)}</span>
        <span>{fmt(post.date)}</span><span>·</span><span>{post.readTime} de lectura</span>
      </div>

      <h1 class="mt-4 font-display text-[clamp(1.6rem,4vw,2.3rem)] font-bold leading-[1.12] text-dark [text-wrap:pretty]">{post.title}</h1>

      <div class="mt-7 overflow-hidden rounded-[20px] bg-slate-100">
        <img src={post.image} alt={post.title} class="block w-full" />
      </div>

      <p class="mt-8 text-[17px] font-medium leading-[1.75] text-dark [text-wrap:pretty]">{post.excerpt}</p>

      <div>
        {post.body.map((par) => (
          <p class="mt-[22px] text-base leading-[1.8] text-slate-700 [text-wrap:pretty]">{par}</p>
        ))}
      </div>

      <div
        class="mt-11 rounded-[28px] p-[30px] text-center text-white"
        style="background:radial-gradient(120% 160% at 50% 0%,#1c2331 0%,#0e1521 75%)"
      >
        <h2 class="m-0 font-display text-xl font-bold">¿Quieres aplicarlo en tu negocio?</h2>
        <p class="mx-auto mt-2 max-w-[380px] text-sm leading-[1.6] text-slate-300">Te asesoramos gratis por WhatsApp, sin compromiso.</p>
        <a
          href={waLink('Hola Bitwise 👋 leí su blog y quiero asesoría para mi negocio')}
          target="_blank"
          rel="noopener"
          class="btn btn--whatsapp mt-[18px] !px-6 !py-2.5"
        >Escribir por WhatsApp</a>
      </div>

      <!-- Enlace del artículo a los rubros que menciona. Va antes de "sigue
           leyendo" para que el lector salte al rubro que le toca mientras el
           tema todavía está fresco, y para que estas páginas dejen de depender
           solo de /proyectos para recibir autoridad. -->
      {rubrosDelPost.length > 0 && (
        <section class="mt-14">
          <h2 class="font-display text-xl font-bold text-dark">Cómo se aplica en tu rubro</h2>
          <ul class="mt-5 grid list-none gap-3 p-0 sm:grid-cols-2">
            {rubrosDelPost.map((r) => (
              <li>
                <a href={hrefRubro(r.slug)} class="post-rubro flex items-center gap-3 rounded-[14px] bg-white p-4 no-underline">
                  <span class="text-[22px] leading-none" aria-hidden="true">{r.emoji}</span>
                  <span class="flex-1 font-display text-[14.5px] font-bold leading-[1.3] text-dark">{anchorRubro[r.slug]}</span>
                  <svg class="shrink-0 text-primary" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Relacionados -->
      <section class="mt-14">
        <h2 class="font-display text-xl font-bold text-dark">Sigue leyendo</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {related.map((p) => (
            <a href={`/blog/${p.slug}`} class="card card--gradient card--lift block overflow-hidden rounded-[20px] no-underline">
              <div class="overflow-hidden bg-slate-100" style="aspect-ratio:16/8">
                <img src={p.image} alt={p.title} loading="lazy" class="h-full w-full object-cover" />
              </div>
              <div class="p-5">
                <span class="text-[11px] font-bold uppercase tracking-[0.12em] text-primary">{catLabel(p.category)}</span>
                <h3 class="mt-2 font-display text-base font-bold leading-[1.3] text-dark">{p.title}</h3>
                <p class="mt-2 text-[13px] leading-[1.6] text-slate-500">{p.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .post-rubro {
    box-shadow: inset 0 0 0 1px var(--hairline);
    transition: box-shadow 0.4s var(--ease-fluid), transform 0.4s var(--ease-fluid);
  }
  .post-rubro:hover {
    transform: translateY(-2px);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-primary) 45%, transparent),
      0 14px 30px -12px rgba(217, 16, 35, 0.16);
  }
  @media (prefers-reduced-motion: reduce) {
    .post-rubro { transition: none; }
  }
</style>
