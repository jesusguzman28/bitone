---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blog, site, waLink, catLabel } from '../../data/site';

export function getStaticPaths() {
  return blog.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const url = `${site.domain}/blog/${post.slug}/`;
const fmt = (d: string) =>
  new Date(d + 'T12:00:00').toLocaleDateString('es-PE', { day: 'numeric', month: 'long', year: 'numeric' });

// Los dos siguientes en la lista, dando la vuelta al llegar al final, en vez de
// los dos primeros que no sean este.
//
// Con `.slice(0, 2)` las seis entradas enlazaban siempre a las dos mismas: tres
// de los seis artículos recibían un único enlace interno en todo el sitio —el
// del índice del blog— y no llegaba autoridad a ninguno. Rotando, cada artículo
// enlaza a dos distintos y cada uno recibe exactamente dos.
const i = blog.findIndex((p) => p.slug === post.slug);
const related = [blog[(i + 1) % blog.length], blog[(i + 2) % blog.length]];

// El BlogPosting va dentro del @graph del layout, no en una etiqueta de script
// aparte. Al ir suelto tenía que repetir `author` y `publisher` como nodos
// nuevos, así que Google veía tres organizaciones llamadas "BIT-ONE Perú" sin
// nada que las uniera: la del layout —la que lleva el RUC, las redes y el
// teléfono— y una copia hueca por cada artículo. Con la referencia por @id,
// cada artículo apunta a la organización de verdad.
const blogPosting = {
  '@type': 'BlogPosting',
  '@id': url + '#articulo',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  dateModified: post.date,
  author: { '@id': site.domain + '/#org' },
  publisher: { '@id': site.domain + '/#org' },
  // Con la barra final, igual que el canonical. Sin ella, el JSON-LD señalaba
  // una dirección que responde 307 y que no es la que el propio documento
  // declara como buena: dos versiones de la misma página en el mismo HTML.
  mainEntityOfPage: url,
  // new URL y no concatenación: las portadas del blog son URLs absolutas de
  // Unsplash, y `${site.domain}${post.image}` producía https://bitwise.pehttps://…
  // en las siete entradas. Era una imagen inválida en el BlogPosting.
  image: new URL(post.image, site.domain).href,
  keywords: post.keywords.join(', '),
  inLanguage: 'es-PE',
  isPartOf: { '@id': site.domain + '/#website' },
};
---

{/* Apartadas del índice mientras el contenido sea del negocio anterior. El
    porqué está explicado entero en blog/index.astro; en resumen: seis artículos
    sobre páginas web para bodegas, en un sitio de 17 páginas, le dicen a Google
    que este dominio va de eso. Van con `noindex, follow`, así que siguen
    pasando autoridad a /servicios/ y /proyectos/. */}
<BaseLayout
  noindex
  title={post.seoTitle}
  description={post.excerpt}
  breadcrumbLabel={post.title}
  image={post.image}
  schema={[blogPosting]}
  article={{ publishedTime: post.date, section: catLabel(post.category), tags: post.keywords }}
>
  <article class="surface px-6 pb-24 pt-[130px]">
    <div class="mx-auto w-full max-w-[720px]">
      <a href="/blog/" class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-[18px] py-2 text-[13px] font-semibold text-slate-600 no-underline transition-colors duration-300 hover:bg-slate-200">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M19 12H5m6 6-6-6 6-6"/></svg>
        Volver al blog
      </a>

      <div class="mt-7 flex flex-wrap items-center gap-2.5 text-xs font-semibold text-slate-400">
        <span class="rounded-full px-3 py-1 text-primary" style="background:rgba(217,16,35,0.08)">{catLabel(post.category)}</span>
        <span>{fmt(post.date)}</span><span>·</span><span>{post.readTime} de lectura</span>
      </div>

      <h1 class="mt-4 font-display text-[clamp(1.6rem,4vw,2.3rem)] font-bold leading-[1.12] text-dark [text-wrap:pretty]">{post.title}</h1>

      {/* La foto grande del artículo. Lleva medidas declaradas para que el
          navegador reserve el hueco antes de bajarla —sin ellas el texto salta
          hacia abajo cuando aparece— y `eager` porque es lo primero que se ve:
          diferirla retrasa justo el elemento que mide la velocidad de la
          página. La versión -sm evita mandarle 1200px de ancho a un celular. */}
      <div class="mt-7 overflow-hidden rounded-[20px] bg-slate-100">
        <picture>
          <source media="(max-width: 640px)" srcset={post.image.replace('.webp', '-sm.webp')} width="640" height="336" />
          <img src={post.image} alt={post.title} width="1200" height="630" loading="eager" fetchpriority="high" class="block h-auto w-full" />
        </picture>
      </div>

      <p class="mt-8 text-[17px] font-medium leading-[1.75] text-dark [text-wrap:pretty]">{post.excerpt}</p>

      <div>
        {post.body.map((par) => (
          <p class="mt-[22px] text-base leading-[1.8] text-slate-700 [text-wrap:pretty]">{par}</p>
        ))}
      </div>

      <div
        class="mt-11 rounded-[28px] p-[30px] text-center text-white"
        style="background:radial-gradient(120% 160% at 50% 0%,#1c2331 0%,#0e1521 75%)"
      >
        <h2 class="m-0 font-display text-xl font-bold">¿Quieres aplicarlo en tu negocio?</h2>
        <p class="mx-auto mt-2 max-w-[380px] text-sm leading-[1.6] text-slate-300">Te asesoramos gratis por WhatsApp, sin compromiso.</p>
        <a
          href={waLink('Hola BIT-ONE, leí un artículo del blog y quiero conversar un proyecto')}
          target="_blank"
          rel="noopener"
          class="btn btn--whatsapp mt-[18px] !px-6 !py-2.5"
        >Escribir por WhatsApp</a>
      </div>

      {/* Aquí iba "Cómo se aplica en tu rubro", que enlazaba a las landings de
          página web por rubro. Se fue con ellas. El campo `rubros` sigue en
          cada entrada de blog.ts y no estorba: cuando haya páginas de sector
          —industria, retail, educación— vuelve a servir de enlazado interno. */}

      <!-- Relacionados -->
      <section class="mt-14">
        <h2 class="font-display text-xl font-bold text-dark">Sigue leyendo</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {related.map((p) => (
            <a href={`/blog/${p.slug}/`} class="card card--gradient card--lift block overflow-hidden rounded-[20px] no-underline">
              <div class="overflow-hidden bg-slate-100" style="aspect-ratio:16/8">
                <img src={p.image.replace('.webp', '-sm.webp')} alt={p.title} width="640" height="336" loading="lazy" decoding="async" class="h-full w-full object-cover" />
              </div>
              <div class="p-5">
                <span class="text-[11px] font-bold uppercase tracking-[0.12em] text-primary">{catLabel(p.category)}</span>
                <h3 class="mt-2 font-display text-base font-bold leading-[1.3] text-dark">{p.title}</h3>
                <p class="mt-2 text-[13px] leading-[1.6] text-slate-500">{p.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </article>
</BaseLayout>

