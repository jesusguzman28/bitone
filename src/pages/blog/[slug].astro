---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, waLink } from '../../data/site';
import { blog, type Post } from '../../data/blog';

export function getStaticPaths() {
  return blog.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const url = `${site.domain}/blog/${post.slug}/`;
const fmt = (d: string) =>
  new Date(d + 'T12:00:00').toLocaleDateString('es-PE', { day: 'numeric', month: 'long', year: 'numeric' });

// Los dos siguientes en la lista, dando la vuelta al final: así cada artículo
// recibe exactamente dos enlaces desde los demás, y ninguno queda huérfano.
const i = blog.findIndex((p) => p.slug === post.slug);
const related = [blog[(i + 1) % blog.length], blog[(i + 2) % blog.length]];

// Anclas para el índice del artículo. Google las usa a veces como enlaces
// directos a una sección en el resultado de búsqueda.
const ancla = (t: string) =>
  t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// El artículo va dentro del @graph del layout y apunta a la organización por
// @id: así Google ve un solo "BIT-ONE Perú" —el que lleva el RUC— y no una copia
// hueca por artículo.
const schema: Record<string, unknown>[] = [
  {
    '@type': 'BlogPosting',
    '@id': url + '#articulo',
    headline: post.title,
    description: post.excerpt,
    datePublished: post.date,
    dateModified: post.date,
    author: { '@id': site.domain + '/#org' },
    publisher: { '@id': site.domain + '/#org' },
    mainEntityOfPage: url,
    image: new URL(post.image, site.domain).href,
    keywords: post.keywords.join(', '),
    articleSection: post.category,
    inLanguage: 'es-PE',
    isPartOf: { '@id': site.domain + '/#website' },
  },
];
if (post.faq?.length) {
  schema.push({
    '@type': 'FAQPage',
    '@id': url + '#faq',
    mainEntity: post.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---

<BaseLayout
  title={post.seoTitle}
  description={post.excerpt}
  breadcrumbLabel={post.title}
  image={post.image.replace('.webp', '.jpg')}
  schema={schema}
  article={{ publishedTime: post.date, section: post.category, tags: post.keywords }}
>
  <article class="surface px-6 pb-24 pt-[130px]">
    <div class="mx-auto w-full max-w-[720px]">
      <a href="/blog/" class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-[18px] py-2 text-[13px] font-semibold text-slate-600 no-underline transition-colors duration-300 hover:bg-slate-200">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6"/></svg>
        Volver al blog
      </a>

      <div class="mt-7 flex flex-wrap items-center gap-2.5 text-xs font-semibold text-slate-400">
        <span class="rounded-full px-3 py-1 text-primary" style="background:rgba(217,16,35,0.08)">{post.category}</span>
        <span>{fmt(post.date)}</span><span>·</span><span>{post.readTime} de lectura</span>
      </div>

      <h1 class="mt-4 font-display text-[clamp(1.6rem,4vw,2.3rem)] font-bold leading-[1.12] text-dark [text-wrap:pretty]">{post.title}</h1>

      <div class="mt-7 overflow-hidden rounded-[20px] bg-slate-100">
        <picture>
          <source media="(max-width: 640px)" srcset={post.image.replace('.webp', '-sm.webp')} width="640" height="336" />
          <img src={post.image} alt={post.title} width="1200" height="630" loading="eager" fetchpriority="high" class="block h-auto w-full" />
        </picture>
      </div>

      <p class="mt-8 text-[17px] font-medium leading-[1.75] text-dark [text-wrap:pretty]">{post.intro}</p>

      <nav aria-label="Contenido del artículo" class="indice mt-8 rounded-[18px] p-5">
        <p class="m-0 text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">En este artículo</p>
        <ol class="m-0 mt-3 grid list-none gap-1.5 p-0 text-[14.5px]">
          {post.secciones.map((s) => (
            <li><a href={`#${ancla(s.h2)}`} class="text-slate-600 no-underline hover:text-primary">{s.h2}</a></li>
          ))}
          {post.faq?.length ? <li><a href="#preguntas" class="text-slate-600 no-underline hover:text-primary">Preguntas frecuentes</a></li> : null}
        </ol>
      </nav>

      <div class="cuerpo">
        {post.secciones.map((s) => (
          <section>
            <h2 id={ancla(s.h2)}>{s.h2}</h2>
            {s.parrafos.map((p) => <p>{p}</p>)}
            {s.lista && (
              <ul>
                {s.lista.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </section>
        ))}

        {post.faq?.length ? (
          <section>
            <h2 id="preguntas">Preguntas frecuentes</h2>
            {post.faq.map((f) => (
              <div class="pregunta">
                <h3>{f.q}</h3>
                <p>{f.a}</p>
              </div>
            ))}
          </section>
        ) : null}
      </div>

      <div
        class="mt-11 rounded-[28px] p-[30px] text-center text-white"
        style="background:radial-gradient(120% 160% at 50% 0%,#1c2331 0%,#0e1521 75%)"
      >
        <h2 class="m-0 font-display text-xl font-bold">¿Lo quieres aplicar en tu empresa?</h2>
        <p class="mx-auto mt-2 max-w-[420px] text-sm leading-[1.6] text-slate-300">
          Revisamos tu caso en una reunión técnica sin costo y te dejamos el alcance y el precio por escrito.
        </p>
        <div class="mt-[18px] flex flex-wrap justify-center gap-3">
          <a
            href={waLink(`Hola BIT-ONE, leí "${post.title}" y quiero conversar un proyecto`)}
            target="_blank"
            rel="noopener"
            class="btn btn--whatsapp !px-6 !py-2.5"
          >Escribir por WhatsApp</a>
          <a href={post.servicio.href} class="btn btn--on-dark !px-6 !py-2.5">{post.servicio.label}</a>
        </div>
      </div>

      <section class="mt-14">
        <h2 class="font-display text-xl font-bold text-dark">Sigue leyendo</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {related.map((p) => (
            <a href={`/blog/${p.slug}/`} class="card card--gradient card--lift block overflow-hidden rounded-[20px] no-underline">
              <div class="overflow-hidden bg-slate-100" style="aspect-ratio:640/336">
                <img src={p.image.replace('.webp', '-sm.webp')} alt="" width="640" height="336" loading="lazy" decoding="async" class="h-full w-full object-cover" />
              </div>
              <div class="p-5">
                <span class="text-[11px] font-bold uppercase tracking-[0.12em] text-primary">{p.category}</span>
                <h3 class="mt-2 font-display text-base font-bold leading-[1.3] text-dark">{p.title}</h3>
                <p class="mt-2 text-[13px] leading-[1.6] text-slate-500">{p.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .indice {
    background: #f8fafc;
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .cuerpo h2 {
    margin: 44px 0 0;
    scroll-margin-top: 110px;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.5rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-dark);
    text-wrap: pretty;
  }
  .cuerpo h3 {
    margin: 26px 0 0;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--color-dark);
  }
  .cuerpo p {
    margin: 16px 0 0;
    font-size: 16px;
    line-height: 1.8;
    color: #334155;
    text-wrap: pretty;
  }
  .cuerpo h3 + p { margin-top: 8px; }
  .cuerpo ul {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .cuerpo li {
    position: relative;
    padding-left: 22px;
    font-size: 15.5px;
    line-height: 1.7;
    color: #334155;
  }
  .cuerpo li::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 0.72em;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-primary);
  }
</style>
