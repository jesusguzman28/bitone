---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { nosotros, site } from '../data/site';
---

<BaseLayout
  title="Nosotros: peruanos impulsando negocios peruanos"
  description="Bitwise nació en Lima para que las MYPEs peruanas accedan a tecnología de primer nivel a precio justo, con trato directo y sin letra chica."
>
  <PageHero eyebrow={nosotros.eyebrow} title={nosotros.title} subtitle={nosotros.intro} flag />

  <!-- Historia + Misión / Visión -->
  <section class="surface px-6 py-[88px]">
    <div class="mx-auto grid w-full max-w-[1120px] items-start gap-11" style="grid-template-columns:repeat(auto-fit,minmax(300px,1fr))">
      <div class="reveal">
        <span class="eyebrow eyebrow--light">Nuestra historia</span>
        <h2 class="mt-4 font-display text-[clamp(1.5rem,3.4vw,2.1rem)] font-bold leading-[1.1] text-dark">{nosotros.historiaTitle}</h2>
        {nosotros.historia.map((p, i) => (
          <p class:list={['text-[15px] leading-[1.75] text-slate-600 [text-wrap:pretty]', i === 0 ? 'mt-[18px]' : 'mt-4']}>{p}</p>
        ))}
      </div>

      <div class="grid gap-[18px]">
        <div class="reveal panel-dark rounded-[28px] p-7 text-white" style="--reveal-delay:100ms;box-shadow:0 24px 50px -28px rgba(14,21,33,0.6)">
          <span class="grid h-10 w-10 place-items-center rounded-xl" style="background:rgba(217,16,35,0.18);color:#ff5b6b">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
          </span>
          <h3 class="mt-3.5 font-display text-lg font-bold">Misión</h3>
          <p class="mt-2 text-sm leading-[1.7] text-slate-400">{nosotros.mision}</p>
        </div>

        <div class="reveal card rounded-[28px] p-7" style="--reveal-delay:200ms">
          <span class="grid h-10 w-10 place-items-center rounded-xl" style="background:rgba(232,163,23,0.14);color:#c98a12">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          </span>
          <h3 class="mt-3.5 font-display text-lg font-bold text-dark">Visión</h3>
          <p class="mt-2 text-sm leading-[1.7] text-slate-500">{nosotros.vision}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Valores -->
  <section class="surface--alt px-6 pb-24 pt-[72px]">
    <div class="mx-auto w-full max-w-[1120px]">
      <div class="reveal text-center">
        <span class="eyebrow eyebrow--light">Valores</span>
        <h2 class="mx-auto mt-4 max-w-[520px] font-display text-[clamp(1.6rem,3.8vw,2.3rem)] font-bold leading-[1.1] text-dark">
          Cómo trabajamos, en 6 promesas
        </h2>
      </div>

      <div class="mt-11 grid gap-4" style="grid-template-columns:repeat(auto-fit,minmax(270px,1fr))">
        {nosotros.valores.map((v, i) => (
          <div class="reveal card card--lift rounded-[20px] p-6" style={`--reveal-delay:${i * 90}ms`}>
            <div class="flex items-center gap-3">
              <span class="font-display text-[13px] font-bold text-primary">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="m-0 font-display text-[16.5px] font-bold text-dark">{v.title}</h3>
            </div>
            <p class="mt-2.5 text-[13.5px] leading-[1.65] text-slate-500">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Escríbenos -->
  <section class="surface--alt px-6 pb-24 pt-20">
    <div
      class="reveal mx-auto max-w-[720px] rounded-[28px] p-[clamp(28px,5vw,44px)] text-white"
      style="background:radial-gradient(120% 150% at 50% 0%,#1c2331 0%,#0e1521 75%);box-shadow:0 36px 70px -36px rgba(14,21,33,0.75)"
    >
      <h2 class="m-0 text-center font-display text-[clamp(1.4rem,3.4vw,1.9rem)] font-bold tracking-[-0.02em]">Conversemos de tu proyecto</h2>
      <p class="mx-auto mt-2.5 max-w-[420px] text-center text-sm leading-[1.6] text-slate-400">
        Déjanos tu nombre y qué necesitas — se abre WhatsApp con el mensaje listo.
      </p>

      <form id="nos-form" class="mt-[26px] grid gap-3.5">
        <input id="nos-nombre" class="field" type="text" placeholder="Tu nombre" aria-label="Tu nombre" />
        <textarea id="nos-msg" class="field resize-y" rows="3" placeholder="Cuéntanos qué necesita tu negocio…" aria-label="Mensaje"></textarea>
        <div class="mt-2 text-center">
          <button type="submit" class="btn btn--whatsapp group !py-3 !pl-[26px] !text-[15px]">
            Enviar por WhatsApp
            <span class="btn__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
            </span>
          </button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ waBase: `https://wa.me/${site.whatsapp}` }}>
  const form = document.getElementById('nos-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const nombre = (document.getElementById('nos-nombre')).value.trim();
    const msg = (document.getElementById('nos-msg')).value.trim();
    const text = `Hola Bitwise 👋${nombre ? ' soy ' + nombre + ',' : ''} quiero conversar sobre mi proyecto.${msg ? ' ' + msg : ''}`;
    window.open(`${waBase}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
  });
</script>
