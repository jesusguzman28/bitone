---
// Nosotros. Lo que el brief respalda de las personas es nombre, rol y LinkedIn: no
// hay biografías, estudios, años ni tamaño de equipo, y no se inventan. La razón
// social y el RUC no van aquí: los dice el pie, una vez.
// Guion: la frase de la casa y quienes la firman (las personas, lo único redondo de
// la página) · cómo es trabajar con ellos, en cuatro frases (tinta) · para qué no son
// (la franqueza, a subtítulo) · la ficha formal, en tres renglones · el cierre que
// arma el mensaje.
// Tres escalas de titular: la portada, el trato a título (el momento propio de la
// página) y, a subtítulo, la franqueza y la ficha.
// Los textos viven en data/nosotros.ts; las tres piezas propias, en components/nosotros/.
import Base from '../layouts/Base.astro';
import PortadaFirmada from '../components/nosotros/PortadaFirmada.astro';
import Trato from '../components/nosotros/Trato.astro';
import Ficha from '../components/nosotros/Ficha.astro';
import Franqueza from '../components/Franqueza.astro';
import DosListas from '../components/DosListas.astro';
import CierreWhatsApp from '../components/CierreWhatsApp.astro';
import { nosotros as d } from '../data/nosotros';
import { paginas } from '../data/navegacion';

const pagina = paginas.nosotros;
---

<Base titulo={d.pestana} descripcion={d.descripcion} signo={pagina.signo}>
  <!-- 1 · La frase y quienes la firman. Debajo viene un plano tinta: tonoDeAbajo -->
  <PortadaFirmada
    signo={pagina.signo}
    tonoDeAbajo="tinta"
    rotulo={pagina.nombre}
    titulo={d.portada.titulo}
    tituloPersonas={d.portada.personas}
    textoBoton={d.portada.boton}
    dato={d.portada.dato}
  />

  <!-- 2 · Cómo es trabajar con ellos -->
  <Trato />

  <!-- 3 · Para qué no son: la franqueza de la casa, en voz más baja que el trato (`menor`:
       a subtítulo, para que el trato sea el único bloque a tamaño de título) -->
  <section class="seccion" id="para-quien" aria-labelledby="t-franca">
    <Franqueza id="t-franca" menor titulo={d.franca.titulo} texto={d.franca.texto}>
      <DosListas a={d.franca.listas.a} b={d.franca.listas.b} />
    </Franqueza>
  </section>

  <!-- 4 · La ficha formal -->
  <Ficha />

  <!-- 5 · Cierre -->
  <CierreWhatsApp />
</Base>
